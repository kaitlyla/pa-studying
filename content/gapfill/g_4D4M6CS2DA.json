       }
      ],
      "text": "Role in septic shock:"
     },
     {
      "type": "text",
      "text": " continuous IV insulin (start 1–4 units/h) titrated to glucose 110–180 mg/dL; check glucose often (eg, every 1–4 h)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
