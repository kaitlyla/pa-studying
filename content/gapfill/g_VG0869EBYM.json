    "content": [
     {
      "type": "text",
      "text": "Buzzword: "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "whirl / whirlpool sign"
     },
     {
      "type": "text",
      "text": " on CT abd = volvulus / mesenteric twist"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
