       {
        "type": "bold"
       }
      ],
      "text": "Fighting and bullying:"
     },
     {
      "type": "text",
      "text": " can indicate a conduct disorder and may co-occur w substance use, depression, or anxiety."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
