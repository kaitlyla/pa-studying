       {
        "type": "bold"
       }
      ],
      "text": "PTSD:"
     },
     {
      "type": "text",
      "text": " frequently overlooked; can present w sxs of depression and anxiety."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
