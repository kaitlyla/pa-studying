     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Routine antibiotics aren't recommended; they're used in episodes of bacterial cholangitis."
     }
    ]
   }
  ]
 },
