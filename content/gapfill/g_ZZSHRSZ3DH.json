    "content": [
     {
      "type": "text",
      "text": "Ursodeoxycholic acid reduces itching and improves biochemical markers (particularly alkaline phosphatase), but evidence for improved survival is mixed at best."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
