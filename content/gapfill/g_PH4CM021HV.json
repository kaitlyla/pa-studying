      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Next:"
     },
     {
      "type": "text",
      "text": " CSF analysis (meningitis, encephalitis, subarachnoid hemorrhage), serum ammonia, heavy metals."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
