       {
        "type": "bold"
       }
      ],
      "text": "Electrolytes, BUN, creatinine, glucose,"
     },
     {
      "type": "text",
      "text": " and levels of any drug suspected of toxicity."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
