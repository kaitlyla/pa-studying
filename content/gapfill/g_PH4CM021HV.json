    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "If still unclear:"
     },
     {
      "type": "text",
      "text": " liver tests, calcium and albumin, TSH, vitamin B12, ESR and/or CRP, ANA, and RPR or VDRL."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
