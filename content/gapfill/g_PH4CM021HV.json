       }
      ],
      "text": "Hypoxia:"
     },
     {
      "type": "text",
      "text": " pulse oximetry or ABG."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
