     {
      "type": "text",
      "text": " ESAs ↓anemia severity in 15 to 20%, esp in pts not transfusion-dependent."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
