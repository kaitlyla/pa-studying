    },
    "content": [
     {
      "type": "text",
      "text": "Correct or exclude other Eti of anemia first; after starting and after each dose Δ, check Hb wkly until stable."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
