    "content": [
     {
      "type": "text",
      "text": "Adults with TTP are often given glucocorticoids and rituximab with plasma exchange; rituximab may be effective for relapse."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Caplacizumab (anti-VWF nanobody) appears to speed platelet recovery but may increase bleeding; its role is debated."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Inherited ADAMTS13 deficiency: recombinant ADAMTS13, or FFP if unavailable; not plasma exchange, glucocorticoids or rituximab."
     }
    ]
   }
  ]
 },
