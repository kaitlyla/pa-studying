    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Amphetamines, ECG:"
     },
     {
      "type": "text",
      "text": " sinus tachy or another tachydysrhythmia; w rhabdomyolysis, peaked T waves or VT from hyperkalemia."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Urine amphetamine immunoassay:"
     },
     {
      "type": "text",
      "text": " false positives are freq (eg, ibuprofen, naproxen, doxylamine); methylphenidate does ⍉cross-react."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
