       {
        "type": "bold"
       }
      ],
      "text": "EToH:"
     },
     {
      "type": "text",
      "text": " fingerstick glucose to r/o hypoglycemia, and sometimes a BAC."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
