       {
        "type": "bold"
       }
      ],
      "text": "Confirm it is non-contrast"
     },
     {
      "type": "text",
      "text": " (so blood/calcium is not confused with contrast)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
