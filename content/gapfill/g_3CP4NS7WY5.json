    "content": [
     {
      "type": "text",
      "text": "Signs of mass effect: "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "sulcal effacement, ventricular and cisternal compress, and midline shift"
     },
     {
      "type": "text",
      "text": "; their absence does ⍉exclude ↑ICP, and mass effect may be present w norm ICP"
     }
    ]
   },
