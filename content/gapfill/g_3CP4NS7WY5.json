        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "crescentic hyperdensity crossing sutures"
     },
     {
      "type": "text",
      "text": " on head CT → subdural hematoma"
     }
    ]
   },
   {
    "type": "paragraph",
