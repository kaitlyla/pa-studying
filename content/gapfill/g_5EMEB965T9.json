        }
       }
      ],
      "text": "Hypoechoic fluid collection w internal debris, posterior acoustic enhancement"
     },
     {
      "type": "text",
      "text": " → soft-tissue abscess"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
