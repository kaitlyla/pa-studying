        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "Hypoechoic fluid collection with internal debris, posterior acoustic enhancement"
     },
     {
      "type": "text",
      "text": " → soft-tissue abscess"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 6,
