       }
      ],
      "text": "Type and cross-match"
     },
     {
      "type": "text",
      "text": " if bleed = ongoing; repeat hgb and HCT up to every 6 hrs in severe bleed."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
