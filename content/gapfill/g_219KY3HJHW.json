    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Nasogastric aspiration and lavage"
     },
     {
      "type": "text",
      "text": " for sus upper GI bleed; up to 15% of upper bleeds have ⍉blood in the aspirate."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
