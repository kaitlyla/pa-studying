       {
        "type": "bold"
       }
      ],
      "text": "Upper endoscopy"
     },
     {
      "type": "text",
      "text": " for upper GI bleed: rapidly if sig, deferrable 24 hrs if bleed stops or = minimal."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
