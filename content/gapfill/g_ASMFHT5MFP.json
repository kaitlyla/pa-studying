      "text": "Cerebellar disorder:"
     },
     {
      "type": "text",
      "text": " take a thorough family history and look for acquired systemic disorders."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
