    },
    "content": [
     {
      "type": "text",
      "text": "Children, newly dx w ⍉ or minor bleed: observation rather than steroids."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
