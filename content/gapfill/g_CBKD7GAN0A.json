      "text": "Format:"
     },
     {
      "type": "text",
      "text": " the adolescent is usually seen alone, sometimes with a parent, guardian, partner, spouse or friend; HEEADSSS or SSHADESS can organize the questions."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
