      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Ask the parent:"
     },
     {
      "type": "text",
      "text": " questions about physical well-being or growth; concerns about emotional well-being, feelings, behavior or learning; what they've discussed about healthy lifestyle and avoiding risk behaviors."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
