        "type": "bold"
       }
      ],
      "text": "Role in pheo:"
     },
     {
      "type": "text",
      "text": " b4 surgery, w the alpha-blocker: propranolol 20 to 40 mg PO 3 times a day; don't use a BB until alpha-blockade is adequate; intraop tachyarrhythmias: propranolol or esmolol."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Interactions:"
     },
     {
      "type": "text",
      "text": " digoxin, clonidine, diltiazem and verapamil add brady (slowed AV conduction); stopping clonidine: w.draw the BB several days first (rebound HTN). Higher Epi doses may be needed."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "OD:"
     },
     {
      "type": "text",
      "text": " severe brady, hypotension, AV block, bronchospasm and cardiogenic shock. Tx brady w atropine, adrenergic drugs or pacing; hypotension w IV vasopressors; shock w glucagon (bolus, then infusion if needed)."
     }
    ]
   }
  ]
 },
