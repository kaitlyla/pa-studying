     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "If ceftriaxone isn't available: gentamicin 240 mg IM + azithromycin 2 g PO (single doses), or cefixime 800 mg PO single dose"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Suspected IgE-mediated penicillin allergy: gentamicin 240 mg IM + azithromycin 2 g PO, single doses; ciprofloxacin 500 mg PO single dose only if asymptomatic and gyrA testing shows a susceptible (wild-type) strain"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Pregnancy: ceftriaxone 500 mg IM single dose (+ chlamydia tx if not excluded); gentamicin is cautioned in pregnancy"
     }
    ]
   }
  ]
