    "content": [
     {
      "type": "text",
      "text": "If chlamydia hasn't been excluded, also give doxycycline 100 mg PO BID x7 days"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
