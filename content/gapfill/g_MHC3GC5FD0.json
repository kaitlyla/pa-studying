     {
      "type": "text",
      "text": "Inhaled b4 exercise or allergen exposure to prevent Sx; they don't work once Sx have started."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
