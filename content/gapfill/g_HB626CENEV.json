       {
        "type": "bold"
       }
      ],
      "text": "Dobutamine:"
     },
     {
      "type": "text",
      "text": " usually 2.5–15 mcg/kg/min IV (rarely up to 40)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
