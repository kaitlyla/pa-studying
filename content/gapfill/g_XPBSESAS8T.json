    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Development and mental health:"
     },
     {
      "type": "text",
      "text": " independence, rules and consequences, temper problems and conflict resolution; puberty and pubertal development."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
