    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Physical growth and development:"
     },
     {
      "type": "text",
      "text": " oral health (regular visits with dentist, daily brushing and flossing, adequate fluoride, avoidance of sugar-sweetened beverages and snacks), nutrition (healthy weight, adequate calcium and vitamin D intake, limiting added sugars intake), physical activity (60 minutes of physical activity a day, screen time)."
     }
    ]
   },
