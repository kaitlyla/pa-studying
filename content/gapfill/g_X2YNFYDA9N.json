       }
      ],
      "text": "Nimodipine (SAH):"
     },
     {
      "type": "text",
      "text": " swallow the capsules whole w a little liquid, preferably ± one hr b4 or two hrs PC; start ASAP w.in 96 hrs of SAH onset. Severely disturbed liver funct (eg, cirrhosis): 30 mg Q4h w close BP and HR monitoring."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
