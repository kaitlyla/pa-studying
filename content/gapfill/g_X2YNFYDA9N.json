       }
      ],
      "text": "Nimodipine (SAH):"
     },
     {
      "type": "text",
      "text": " swallow the capsules whole with a little liquid, preferably at least one hour before or two hours after meals; start as soon as possible within 96 hours of SAH onset. Severely disturbed liver function (eg, cirrhosis): 30 mg every 4 hours with close BP and heart rate monitoring."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Nimodipine boxed warning:"
     },
     {
      "type": "text",
      "text": " never give it IV or by any other parenteral route; injecting capsule contents has caused death, cardiac arrest, cardiovascular collapse, hypotension and bradycardia."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Strong CYP3A4 inhibitors (eg, clarithromycin, some HIV protease inhibitors, ketoconazole, itraconazole, voriconazole, nefazodone) are contraindicated (significant hypotension); avoid grapefruit juice, whose BP-lowering effect may last at least 4 days."
     }
    ]
   }
  ]
