      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Nimodipine boxed warning:"
     },
     {
      "type": "text",
      "text": " never give it IV or by any other parenteral route; injecting capsule contents has caused death, ♡ arrest, cardiovasc collapse, hypotension and brady."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Strong CYP3A4 inhibitors (eg, clarithromycin, some HIV protease inhibitors, ketoconazole, itraconazole, voriconazole, nefazodone) are contraindicated (sig hypotension); ⍉grapefruit juice, whose BP-lowering effect may last ± 4 days."
     }
    ]
   }
