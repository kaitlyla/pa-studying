    "content": [
     {
      "type": "text",
      "text": "Check K w.in 1 wk of starting or changing dose, then regularly; if hyperkalemia, lower dose or stop & tx it"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
