      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Limit:"
     },
     {
      "type": "text",
      "text": " bone and bowel gas can block the view of deeper structures"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
