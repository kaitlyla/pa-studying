    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Kidneys and urinary tract:"
     },
     {
      "type": "text",
      "text": " tells cysts (usually benign) from solid masses (often malignant), and finds obstruction such as stones in the kidneys, ureters or bladder"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
