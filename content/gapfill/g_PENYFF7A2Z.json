      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Gallbladder and bile ducts:"
     },
     {
      "type": "text",
      "text": " gallstones and biliary obstruction"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
