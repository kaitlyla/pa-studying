    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Stress testing"
     },
     {
      "type": "text",
      "text": " when intermittent ischemia = sus; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "tilt table testing"
     },
     {
      "type": "text",
      "text": " when the Hx suggests reflex (vasodepressor) syncope."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
