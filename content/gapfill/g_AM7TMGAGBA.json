       }
      ],
      "text": "EEG"
     },
     {
      "type": "text",
      "text": " only if a sz dx = sus; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "head CT or MRI"
     },
     {
      "type": "text",
      "text": " only w signs of a focal CNS dx."
     }
