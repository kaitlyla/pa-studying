    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Prochlorperazine overdose:"
     },
     {
      "type": "text",
      "text": " don't induce emesis (a dystonic reaction of the head or neck could cause aspiration); for hypotension, epinephrine is not recommended as a pressor, since phenothiazines may reverse its pressor action and lower BP further."
     }
    ]
   }
