       }
      ],
      "text": "On CXR:"
     },
     {
      "type": "text",
      "text": " "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "globular / water-bottle ♡ w clear lungs"
     },
     {
      "type": "text",
      "text": " → lrg pericardial effusion"
     }
    ]
   },
   {
    "type": "paragraph",
