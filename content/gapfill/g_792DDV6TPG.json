    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Great saphenous vein:"
     },
     {
      "type": "text",
      "text": " a superficial vein of the thigh with no arterial counterpart."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
