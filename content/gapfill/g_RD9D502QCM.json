     }
    },
    "content": [
     {
      "type": "text",
      "text": "Most effective early, but can work up to 36 hours after the bite; response is usually dramatic"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
