     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Parent refuses:"
     },
     {
      "type": "text",
      "text": " only a court finding of neglect or abuse can override a parent's decision."
