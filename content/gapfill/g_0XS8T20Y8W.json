     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Caution:"
     },
     {
      "type": "text",
      "text": " seizures w high doses (esp renal insuff); nephritis; C. diff colitis; Coombs (+) hemolytic anemia, leukopenia, thrombocytopenia."
     }
    ]
   }
