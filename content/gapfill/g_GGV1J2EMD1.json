     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Four COCs are FDA approved for acne in females older than 15 years who also want contraception: ethinyl estradiol with norgestimate, norethindrone acetate/ferrous fumarate, drospirenone, or drospirenone/levomefolate"
     }
    ]
   }
  ]
