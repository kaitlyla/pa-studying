      "type": "text",
      "text": "Consider for females unresponsive to or intolerant of other therapy, acne timed with menses, or signs of hyperandrogenism"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
