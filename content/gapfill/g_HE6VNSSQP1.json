    "content": [
     {
      "type": "text",
      "text": "Combination antifungal-corticosteroid products such as clotrimazole-betamethasone generally should be avoided"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Terbinafine, naftifine, imidazoles (eg, clotrimazole, oxiconazole) or ciclopirox 2 times a day, continued at least 7 to 10 days after the lesions disappear"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Without testing or referral: a 2-week trial of a topical antifungal with no corticosteroid, with follow-up"
     }
    ]
   }
  ]
