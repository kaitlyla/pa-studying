    "content": [
     {
      "type": "text",
      "text": "Acyclovir-resistant HSV: rare, almost only in immunocompromised pts; also resistant to penciclovir, famciclovir and valacyclovir"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
