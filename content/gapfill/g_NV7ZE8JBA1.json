    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Treatment and next step"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
