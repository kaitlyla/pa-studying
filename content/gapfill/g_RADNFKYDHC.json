       }
      ],
      "text": "Role in metabolic acidosis (proximal RTA):"
     },
     {
      "type": "text",
      "text": " difficult cases: low-dose HCTZ 25 mg PO twice/day may stimulate proximal tubule reabsorption."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
