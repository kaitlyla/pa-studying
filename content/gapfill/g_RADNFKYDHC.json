      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "CI:"
     },
     {
      "type": "text",
      "text": " anuria; sulfonamide hypersensitivity. Can cause acute myopia and angle-closure glaucoma (eye pain or ↓vision w.in hrs–wks): stop it promptly."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Interactions:"
     },
     {
      "type": "text",
      "text": " corticosteroids/ACTH deepen hypokalemia; ↓K or Mg sensitizes the ♡ to digitalis toxicity; cholestyramine/colestipol bind HCTZ and cut its absorb."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
