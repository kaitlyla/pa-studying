    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Counsel:"
     },
     {
      "type": "text",
      "text": " protect skin from the sun and get regular skin-cancer screening (non-melanoma skin CA risk)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
