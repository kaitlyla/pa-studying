    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Cx count:"
     },
     {
      "type": "text",
      "text": " more than 10^5 colony-forming units/mL suggests infect; in Sxtomatic pts, counts as ↓as 10^2 or 10^3 can indicate UTI."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
