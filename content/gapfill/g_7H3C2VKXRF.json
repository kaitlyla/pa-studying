        "type": "bold"
       }
      ],
      "text": "⍉single accepted approach:"
     },
     {
      "type": "text",
      "text": " many clinicians tx young, otherwise healthy women w classic dysuria, freq and urgency and ⍉red flags w.o any testing."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
