    "content": [
     {
      "type": "text",
      "text": "Not recommended with factor IX complex concentrates or anti-inhibitor coagulant concentrates: thrombosis risk may be increased. Tissue plasminogen activators may decrease the efficacy of both drugs; stop tranexamic acid if tPA is needed."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
