    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Diagnoses on hand:"
     },
     {
      "type": "text",
      "text": " past and present diagnoses should be accessible to the treating and consulting clinicians."
     }
