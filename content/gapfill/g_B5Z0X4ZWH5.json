       }
      ],
      "text": "Blunting of costophrenic angle, meniscus sign"
     },
     {
      "type": "text",
      "text": " → pleural effusion (>200 mL on PA)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 6,
