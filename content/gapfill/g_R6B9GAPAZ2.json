      ],
      "text": "Rhythm:"
     },
     {
      "type": "text",
      "text": " in severe hypercalcemia "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "arrhythmias may occur"
     },
     {
      "type": "text",
      "text": ", particularly in pts taking digoxin"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
