     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Motor:"
     },
     {
      "type": "text",
      "text": " takes a few steps on his own; uses fingers to feed herself some food."
     }
    ]
   }
