       }
      ],
      "text": "Rate:"
     },
     {
      "type": "text",
      "text": " bradycardia may or may not be present"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
