    },
    "content": [
     {
      "type": "text",
      "text": "ASx, or light-headedness, presyncope and syncope depending on how many beats are blocked"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
