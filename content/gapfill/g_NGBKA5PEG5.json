      ],
      "text": "Mech:"
     },
     {
      "type": "text",
      "text": " failure of conduction in the His-Purkinje system (below the AV node)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
