      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "Sudden instability: syncope (Stokes-Adams attacks) or sudden ♡ death"
     }
    ]
   },
   {
