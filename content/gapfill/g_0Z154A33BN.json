      ],
      "text": "Timing:"
     },
     {
      "type": "text",
      "text": " draw the level just before the next dose, 12 hours after the previous one."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
