       {
        "type": "bold"
       }
      ],
      "text": "Extrinsic:"
     },
     {
      "type": "text",
      "text": " drugs (digoxin, BBs, CCBs), autonomic dysfun, hypothyroidism, lyte abnormalities (ex, hyperkalemia)"
     }
    ]
   },
