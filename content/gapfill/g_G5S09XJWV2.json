    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Mech:"
     },
     {
      "type": "text",
      "text": " pacemaker (P) cells fail to fire → sinus pauses and arrest; transitional (T) cells fail to conduct the impulse out → SA exit block"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
