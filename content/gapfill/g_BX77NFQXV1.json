        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "Spiculated solid pulm nodule >8 mm, upper lobe"
     },
     {
      "type": "text",
      "text": " → lung CA (adenocarcinoma if periph)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 6,
     "spaceAfter": 0,
