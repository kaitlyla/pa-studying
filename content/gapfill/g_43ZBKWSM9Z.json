    },
    "content": [
     {
      "type": "text",
      "text": "Ex US: "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "partial compressibility of the common femoral v."
     },
     {
      "type": "text",
      "text": " and a "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "filling defect on color Doppler"
     },
     {
      "type": "text",
      "text": ", consistent w thrombus"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
