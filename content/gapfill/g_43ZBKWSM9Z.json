       }
      ],
      "text": "⍉compressible v. w acute soft thrombus"
     },
     {
      "type": "text",
      "text": " → DVT"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
