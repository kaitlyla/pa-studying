     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Adult trafficking:"
     },
     {
      "type": "text",
      "text": " no federal law requires clinicians to report suspected trafficking of patients 18 and older."
     }
