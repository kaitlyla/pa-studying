      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Sulfasalazine:"
     },
     {
      "type": "text",
      "text": " CBC with differential and LFTs before starting, every second week for the first three months, monthly for the next three months, then every three months."
     }
    ]
