    "content": [
     {
      "type": "text",
      "text": "Metastatic RCC, first-line systemic tx: combinations (ICI ± targeted therapy, chemo, or a second ICI), eg, pembrolizumab + axitinib, nivolumab + cabozantinib, pembrolizumab + lenvatinib"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
