     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Surgically treated clear cell RCC at high risk of recurrence: adjuvant pembrolizumab increased disease-free and overall survival"
     }
    ]
   }
