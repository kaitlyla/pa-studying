    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "OD:"
     },
     {
      "type": "text",
      "text": " supportive—replace fluid and lyte losses; check lytes, CO2 and BP often."
     }
    ]
   }
