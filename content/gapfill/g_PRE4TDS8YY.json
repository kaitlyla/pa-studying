      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Antidote:"
     },
     {
      "type": "text",
      "text": " digoxin-specific Fab fragments (for digitalis glycosides: digoxin, digitoxin, oleander, foxglove)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "If calcium is needed for high potassium, give it with caution to patients taking digoxin (risk of precipitating hypokalemia-related arrhythmias)"
     }
    ]
   }
