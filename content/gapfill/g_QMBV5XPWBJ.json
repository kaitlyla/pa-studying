    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Annual (well-woman visit) — History:"
     },
     {
      "type": "text",
      "text": " symptoms; medications; allergies; medical, surgical, family, social and gynecologic history, including reproductive, sexual and mental health (screening tools as indicated)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
