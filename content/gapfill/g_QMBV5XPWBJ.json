    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Well-woman visit — Breast and pelvic exams:"
     },
     {
      "type": "text",
      "text": " ACOG recommends them when indicated by medical history or symptoms."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
