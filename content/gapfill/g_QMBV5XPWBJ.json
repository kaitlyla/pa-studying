    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Well-woman visit — Reproductive life plan:"
     },
     {
      "type": "text",
      "text": " a key part of the visit for a reproductive-aged woman, so testing and treatment fit her current and future plans."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
