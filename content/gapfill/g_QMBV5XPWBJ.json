      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "D/C (postpartum) — Comprehensive postpartum visit:"
     },
     {
      "type": "text",
      "text": " mood and emotional well-being; infant care and feeding; sexuality, contraception and birth spacing; sleep and fatigue; physical recovery from birth; chronic disease management; health maintenance."
     }
    ]
   }
  ]
