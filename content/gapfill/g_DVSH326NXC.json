      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Overdose:"
     },
     {
      "type": "text",
      "text": " leucovorin (or levoleucovorin) as soon as possible, guided by serum creatinine and MTX levels. Glucarpidase for toxic MTX levels (> 1 µmol/L) with delayed clearance from renal impairment."
     }
    ]
   }
