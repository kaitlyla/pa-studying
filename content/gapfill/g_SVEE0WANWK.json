    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Assess the mental state"
     },
     {
      "type": "text",
      "text": " for depression, anxiety, agitation, panic attacks, severe insomnia, other mental disorders and alcohol or drug use disorders."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
