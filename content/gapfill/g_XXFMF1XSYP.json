       {
        "type": "bold"
       }
      ],
      "text": "Coudé tip"
     },
     {
      "type": "text",
      "text": " to get around a large prostate or obstruction."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
