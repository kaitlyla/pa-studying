       {
        "type": "bold"
       }
      ],
      "text": "Sizes:"
     },
     {
      "type": "text",
      "text": " adult female ~14 Fr, adult male 16–18 Fr, urologic bleeding 20–30 Fr."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
