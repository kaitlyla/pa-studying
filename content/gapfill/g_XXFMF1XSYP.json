    "content": [
     {
      "type": "text",
      "text": "Convenience or incontinence care is never an indication."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
