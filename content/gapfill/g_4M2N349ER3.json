     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Anemia:"
     },
     {
      "type": "text",
      "text": " CBC for heavy, prolonged or recurring bleed; Fe studies if anemia isn't clearly Fe deficiency; type and cross-match for acute heavy bleed."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
