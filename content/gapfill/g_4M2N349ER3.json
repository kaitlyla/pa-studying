    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Bleed dx"
     },
     {
      "type": "text",
      "text": " (heavy menses w a (+) Hx screen): PLT, PT, aPTT and fibrinogen; von Willebrand testing if sus."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
