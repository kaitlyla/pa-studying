     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Preg test first"
     },
     {
      "type": "text",
      "text": " in every pt of reprod age, whatever the Hx; serum quantitative beta-hCG if the urine test = (−) and preg = poss."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
