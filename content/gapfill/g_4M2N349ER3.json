        "type": "bold"
       }
      ],
      "text": "Postmenopausal bleed:"
     },
     {
      "type": "text",
      "text": " sample when the endometrium = > 4 mm on US, or w any bleed @ ↑risk (eg, tamoxifen, Lynch syndrome)."
     }
    ]
   },
