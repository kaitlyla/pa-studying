     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Endo Eti:"
     },
     {
      "type": "text",
      "text": " TSH; total testosterone, 17-hydroxyprogesterone and DHEA-S for PCOS; PRL; FSH if menopausal status = unclear."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
