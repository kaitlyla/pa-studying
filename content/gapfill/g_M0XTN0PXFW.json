     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "School:"
     },
     {
      "type": "text",
      "text": " school attendance, school problems (behavior or learning), school performance and progress, transitions, co-occurrence of middle school and pubertal transitions."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
