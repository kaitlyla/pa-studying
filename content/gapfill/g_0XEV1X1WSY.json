       {
        "type": "bold"
       }
      ],
      "text": "Tonometry"
     },
     {
      "type": "text",
      "text": " if acute narrow-angle glaucoma = sus."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
