     }
    },
    "content": [
     {
      "type": "text",
      "text": "Radiographs show mainly bone, plus joint effusion from bleed or an occult frx"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 0,
