       }
      ],
      "text": "Lesions:"
     },
     {
      "type": "text",
      "text": " lytic or blastic; prostate CA metastases are most often blastic, lung CA most often lytic, breast CA either"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
