    "content": [
     {
      "type": "text",
      "text": "A greenstick frx shows as a discontinuity (step-off) in the cortex"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
