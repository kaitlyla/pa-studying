      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Routine labs"
     },
     {
      "type": "text",
      "text": " unless the cause is obvious: CBC, electrolytes with calcium and magnesium, glucose, kidney and liver tests, TSH, ESR, hepatitis C serology."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
