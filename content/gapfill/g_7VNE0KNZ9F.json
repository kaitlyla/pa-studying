      "text": "Wedge-shaped hypodensity respecting vasc territory"
     },
     {
      "type": "text",
      "text": " → established/subacut ischemic CVA"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
