     }
    },
    "content": [
     {
      "type": "text",
      "text": "Ex CT: a "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "lrg lucent infarct in the area supplied by the Rt middle cerebral a."
     }
    ]
   },
