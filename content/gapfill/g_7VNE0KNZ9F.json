     }
    },
    "content": [
     {
      "type": "text",
      "text": "W.in 6 to 12 hrs of ischemia, medium-sized to lrg infarcts start to become visible as "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "hypodensities"
     },
     {
      "type": "text",
      "text": "; sm (eg, lacunar) infarcts may be visible only w MRI"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
