       }
      ],
      "text": "Blood:"
     },
     {
      "type": "text",
      "text": " look for hyperdensity 60-80 HU (epidural / subdural / SAH / IPH / IVH)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
