    "content": [
     {
      "type": "text",
      "text": "Rifampin 10 mg/kg (max 600 mg) PO daily; bactericidal, kills dormant organisms, so used for the whole course."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Potent CYP3A4 inducer:"
     },
     {
      "type": "text",
      "text": " speeds metabolism of anticoagulants, oral contraceptives, glucocorticoids, digitoxin, oral antihyperglycemics, methadone and many others; antiretroviral interactions are complex. Contraindicated with several HIV protease inhibitors and other antivirals, praziquantel and lurasidone."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Discolors (yellow-orange-red-brown) teeth, urine, sweat, sputum and tears; can permanently stain soft contact lenses."
     }
    ]
   }
  ]
 },
