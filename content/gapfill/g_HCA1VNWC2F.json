       }
      ],
      "text": "Urine preg test"
     },
     {
      "type": "text",
      "text": " in every woman of childbearing age; a (−) bedside test effectively excludes ruptured ectopic preg."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
