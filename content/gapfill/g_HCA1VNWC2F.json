       {
        "type": "bold"
       }
      ],
      "text": "Serum lipase"
     },
     {
      "type": "text",
      "text": " = the exception: it strongly suggests acute pancreatitis."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
