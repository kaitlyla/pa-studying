    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Reciprocal Δ:"
     },
     {
      "type": "text",
      "text": " mainly III and aVF; its size follows the ST elevation in I and aVL, so it may be minimal or ⍉when the ↑lat leads aren't involved"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Named by maximal ST elevation:"
     },
     {
      "type": "text",
      "text": " septal V1–2; anterior V2–5; anteroseptal V1–4; anterolateral V3–6 + I, aVL; extensive anterior V1–6 + I, aVL"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
