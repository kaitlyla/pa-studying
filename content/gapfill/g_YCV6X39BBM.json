    "content": [
     {
      "type": "text",
      "text": "ST elevation w later Q waves in the precordial leads (V1–6), ± the ↑lat leads, often preceded by hyperacute T waves."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
