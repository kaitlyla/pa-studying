       {
        "type": "bold"
       }
      ],
      "text": "Wraparound LAD:"
     },
     {
      "type": "text",
      "text": " ST elevation in the precordial and inferior leads @ once"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
