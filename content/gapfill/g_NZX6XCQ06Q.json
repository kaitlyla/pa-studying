      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Disease:"
     },
     {
      "type": "text",
      "text": " inferior MI, sinus node disease, hypothyroidism, hypothermia, anorexia nervosa, hyperkalemia or hypermagnesemia, brainstem herniation (Cushing reflex), myocarditis"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Drugs and toxins:"
     },
     {
      "type": "text",
      "text": " beta blockers, verapamil and diltiazem, digoxin, clonidine and dexmedetomidine, amiodarone, opioids, GABA-ergic agents (barbiturates, benzodiazepines, baclofen, GHB), organophosphate poisoning"
     }
    ]
   },
