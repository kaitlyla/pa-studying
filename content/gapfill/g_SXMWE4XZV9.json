    "content": [
     {
      "type": "text",
      "text": "Hypovolemic shock: fluid resuscitation w 30 mL/kg balanced crystalloid over 3 h; continued unless clin parameters return to norm"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
