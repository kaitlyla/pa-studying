    "content": [
     {
      "type": "text",
      "text": "Used for hereditary or acquired angioedema, and for ACE inhibitor angioedema that is severe, progressing or refractory (it usually resolves about 24 to 48 hours after stopping the drug)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Options: C1 inhibitor concentrate, fresh frozen plasma, and possibly ecallantide (inhibits plasma kallikrein) or icatibant (blocks bradykinin)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Ecallantide must not be self-administered and carries a boxed warning for anaphylaxis"
     }
    ]
   }
  ]
 },
