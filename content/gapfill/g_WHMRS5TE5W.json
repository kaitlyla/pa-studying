      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Older pts w CA risk:"
     },
     {
      "type": "text",
      "text": " laryngoscopy, bronchoscopy and esophagoscopy w biopsies; HPV testing of squamous cell carcinoma; CT of head, neck and chest."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
