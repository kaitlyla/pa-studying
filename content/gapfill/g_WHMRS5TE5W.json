    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "FNA"
     },
     {
      "type": "text",
      "text": " of the neck mass if ⍉primary = found (preferred over incisional bx)."
     }
