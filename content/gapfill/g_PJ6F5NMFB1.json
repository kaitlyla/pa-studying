    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "Noncaseating granulomas"
     },
     {
      "type": "text",
      "text": " are pathognomonic when present but are ⍉detected in the majority of pts"
     }
