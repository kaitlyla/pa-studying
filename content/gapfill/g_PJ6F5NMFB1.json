     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Surgery (30 to 55% ultimately need a major operation) is best reserved for recurrent obstruction or intractable fistulas or abscesses; resection may ease symptoms but does not cure, and the disease is likely to recur"
     }
    ]
