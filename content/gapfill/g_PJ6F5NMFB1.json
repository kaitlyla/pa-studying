        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "strictures or fistulas w separation of bowel loops"
     },
     {
      "type": "text",
      "text": "; an upper GI series w small-bowel follow-through = an alt when these are unavailable"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
