     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Motor:"
     },
     {
      "type": "text",
      "text": " kicks a ball; runs; walks (not climbs) up a few stairs with or without help; eats with a spoon."
     }
    ]
   }
