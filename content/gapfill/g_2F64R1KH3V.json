      ],
      "text": "What these are:"
     },
     {
      "type": "text",
      "text": " milestones most children (≥75%) are expected to reach by this visit age."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
