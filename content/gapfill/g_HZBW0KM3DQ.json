    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Rituximab (Rituxan) IV premedication:"
     },
     {
      "type": "text",
      "text": " Premedicate pts w an antihist and acetaminophen prior to dosing."
     }
    ]
   }
  ]
