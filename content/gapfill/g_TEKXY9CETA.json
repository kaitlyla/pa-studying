    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Check the placenta"
     },
     {
      "type": "text",
      "text": " for completeness after delivery; if it = incomplete, explore the uterus and remove retained fragments."
