        "type": "bold"
       }
      ],
      "text": "Look for the source:"
     },
     {
      "type": "text",
      "text": " explore the uterus for lacerations and retained placenta, and examine the cervix and vagina."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
