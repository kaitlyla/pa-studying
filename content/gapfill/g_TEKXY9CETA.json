      ],
      "text": "Postpartum hemorrhage"
     },
     {
      "type": "text",
      "text": " = blood loss > 1000 mL, or blood loss w signs of hypovolemia, w.in 24 hrs of birth; the dx = clin."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
