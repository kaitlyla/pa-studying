    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Pregnancy:"
     },
     {
      "type": "text",
      "text": " excreted in breast milk in substantial amounts; hemolytic reactions can occur in neonates."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
