    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Know:"
     },
     {
      "type": "text",
      "text": " leprosy: dapsone is inexpensive and generally safe; rarely dapsone syndrome (exfoliative dermatitis, high fever, mono-like WBC differential)."
     }
