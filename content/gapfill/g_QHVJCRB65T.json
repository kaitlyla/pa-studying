    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Pregnancy:"
     },
     {
      "type": "text",
      "text": " uncontrolled experience hasn't shown ↑ fetal abnormalities; use only if clearly needed."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
