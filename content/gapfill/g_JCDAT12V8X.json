     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Disposition / D/C — Records that go with a transfer:"
     },
     {
      "type": "text",
      "text": " available history, records related to the emergency condition, observations of signs or symptoms, preliminary diagnosis, results of diagnostic studies or telephone reports of them, treatment provided, test results, and the written consent or certification."
     }
    ]
   }
