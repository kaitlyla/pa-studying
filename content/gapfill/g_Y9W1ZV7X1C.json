    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Misoprostol boxed warning:"
     },
     {
      "type": "text",
      "text": " uterine rupture has been reported when misoprostol was given to pregnant women to induce labor or abortion; the risk rises with advancing gestational age and with prior uterine surgery, including cesarean delivery."
     }
    ]
   }
