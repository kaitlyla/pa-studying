       }
      ],
      "text": "CI:"
     },
     {
      "type": "text",
      "text": " prior serious allergic rxn to a PCN."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
