        "type": "bold"
       }
      ],
      "text": "Usual therapeutic dose:"
     },
     {
      "type": "text",
      "text": " up to 1 mg daily (adults and children); resistant cases may need more. Maintenance after the blood picture normalizes: 0.4 mg daily in adults (0.8 mg in pregnancy/lactation), never < 0.1 mg/day."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
