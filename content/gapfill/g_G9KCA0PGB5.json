       {
        "type": "bold"
       }
      ],
      "text": "Counseling:"
     },
     {
      "type": "text",
      "text": " even where a parent must consent to contraception, you can still counsel the teen about her options."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
