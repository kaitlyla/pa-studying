    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Other minor-consent care:"
     },
     {
      "type": "text",
      "text": " some states' consent laws also cover substance misuse treatment, pregnancy prevention and care, and sometimes abortion, mental health, and emergency care."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
