     }
    },
    "content": [
     {
      "type": "text",
      "text": "Life-threatening bleed + DOAC w.in 24 h: PCC can be considered."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
