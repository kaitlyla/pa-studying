     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Crovalimab (PiaSky): C5 inhibitor for PNH, age 13 and older and ≥ 40 kg."
     }
    ]
