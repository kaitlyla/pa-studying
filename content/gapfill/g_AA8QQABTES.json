    "content": [
     {
      "type": "text",
      "text": "C5 inhibitors (eculizumab, ravulizumab) reduce hemolysis; complement inhibition reduces transfusion needs and thrombosis risk; ravulizumab = used more (less freq infusions)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "All raise Neisseria meningitidis risk: meningococcal vax >= 14 days b4 starting, or prophylactic abx."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
