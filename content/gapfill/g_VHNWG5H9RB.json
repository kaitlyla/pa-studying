    "content": [
     {
      "type": "text",
      "text": "Topical retinoids (tretinoin, tazarotene, adapalene, trifarotene) are contraindicated in preg"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Tetracycline-class abx are contraindicated in preg, breastfeed and children age 9 or younger (permanent enamel hypoplasia or tooth discoloration)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "PO cephalexin or cefadroxil: second-line after failed tetracyclines; useful in preg pts w inflam acne"
     }
    ]
   }
  ]
