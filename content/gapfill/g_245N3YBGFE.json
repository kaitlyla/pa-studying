       {
        "type": "bold"
       }
      ],
      "text": "Current guideline:"
     },
     {
      "type": "text",
      "text": " 2025 AHA/ACC multisociety Guideline for the Prevention, Detection, Evaluation and Management of High Blood Pressure in Adults."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Hypertension"
     },
     {
      "type": "text",
      "text": " is systolic ≥ 130 mm Hg or diastolic ≥ 80 mm Hg, or taking BP medication."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Risk:"
     },
     {
      "type": "text",
      "text": " use the PREVENT calculator; a 10-year CVD risk ≥ 7.5% counts as increased risk."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Start medication"
     },
     {
      "type": "text",
      "text": " at average BP ≥ 130/80 with existing CVD, or with diabetes, CKD or PREVENT risk ≥ 7.5%; otherwise when BP stays ≥ 130/80 after 3 to 6 months of lifestyle changes."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "First drugs:"
     },
     {
      "type": "text",
      "text": " one first-line drug for stage 1 (130 to 139/80 to 89 mm Hg); two first-line drugs from the start for stage 2 (≥ 140/90 mm Hg)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Goal:"
     },
     {
      "type": "text",
      "text": " < 130/80 mm Hg for most patients."
     }
    ]
   }
  ]
 },
