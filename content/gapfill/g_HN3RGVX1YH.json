    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Birth-defect risk:"
     },
     {
      "type": "text",
      "text": " give to women of reproductive age only with contraception and monthly pregnancy tests."
     }
