        "type": "bold"
       }
      ],
      "text": "Qsymia:"
     },
     {
      "type": "text",
      "text": " 3.75/23 mg PO each morning × 14 d, then 7.5/46 mg. If < 3% weight loss after 12 wk, titrate to 15/92 mg; if < 5% loss after 12 wk on 15/92 mg, stop."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
