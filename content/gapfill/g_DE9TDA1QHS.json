    "content": [
     {
      "type": "text",
      "text": "⍉standardized tx. Glucocorticoids w mycophenolate mofetil, or tamoxifen, have been described in the literature."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
