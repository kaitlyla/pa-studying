    "content": [
     {
      "type": "text",
      "text": "Hypovolemic (normal adrenal function): 0.9% saline usually corrects both the hyponatremia and the hypovolemia"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Severe, rapid-onset or highly symptomatic: partial rapid correction w hypertonic (3%) saline"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Raise Na no more than 8 mEq/L over the first 24 h; too-rapid correction can cause osmotic demyelination syndrome"
     }
    ]
   }
  ]
 },
