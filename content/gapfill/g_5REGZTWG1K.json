       }
      ],
      "text": "Lower lung border (5-7-9):"
     },
     {
      "type": "text",
      "text": " the diaphragm sits @ ICS 5 in the midclav line, ICS 7 in the midaxillary line and ICS 9 in the midscapular line; below that level = liver."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
