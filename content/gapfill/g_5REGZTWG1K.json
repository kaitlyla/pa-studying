    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "RUL:"
     },
     {
      "type": "text",
      "text": " the apex rises 2–4 cm above the clavicle; the horizontal fissure runs @ about the 4th rib."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
