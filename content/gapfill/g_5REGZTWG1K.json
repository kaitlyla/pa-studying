     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Right main bronchus:"
     },
     {
      "type": "text",
      "text": " straighter and less angled, so aspiration (pneumonia or foreign body) is most common on the right."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Rib nerves:"
     },
     {
      "type": "text",
      "text": " nerves run along the inferior edge of each rib, so chest tubes and devices go over the superior edge of the rib."
     }
    ]
   }
