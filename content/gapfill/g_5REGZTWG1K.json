    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Oblique fissures:"
     },
     {
      "type": "text",
      "text": " the LUL's oblique fissure = more vertical; the RLL's oblique fissure goes up to the axilla."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
