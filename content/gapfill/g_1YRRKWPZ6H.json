       }
      ],
      "text": "AECOPD:"
     },
     {
      "type": "text",
      "text": " effective; give concurrently or alternating with beta-agonists. Long-acting anticholinergics are not studied for exacerbations (kept for prevention/maintenance)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "AECOPD dose:"
     },
     {
      "type": "text",
      "text": " 0.25–0.5 mg by nebulizer or 2 MDI puffs every 4 to 6 h."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
