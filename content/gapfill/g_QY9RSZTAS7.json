    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Absences, truancy, poor school performance:"
     },
     {
      "type": "text",
      "text": " identify the problem ASAP; assessment may include sensory screening, psychosocial screening, and referral for LD and mental disorder assessment."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
