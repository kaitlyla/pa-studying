      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Raises mercaptopurine and azathioprine exposure (myelosuppression): reduce their dose. Bendamustine, thiazides, ampicillin and amoxicillin may raise the risk of serious skin rxns."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
