     {
      "type": "text",
      "text": "Stop allopurinol @ the first skin rash or other sign of hypersensitivity."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
