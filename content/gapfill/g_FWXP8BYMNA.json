    "content": [
     {
      "type": "text",
      "text": "Without advanced HIV: induction w IV liposomal amphotericin B + oral flucytosine for 2 to 4 weeks (amphotericin B deoxycholate if no lipid form); then oral fluconazole: consolidation 8 weeks, maintenance 6 to 12 months"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Advanced HIV: induction w IV liposomal amphotericin B once a day + oral flucytosine for the first 2 weeks; alt: single high-dose IV liposomal amphotericin B (day 1) + oral flucytosine and oral fluconazole for 2 weeks"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Advanced HIV: oral fluconazole consolidation for 8 weeks; maintenance until CD4 > 100 cells/mcL on ART; itraconazole at the same dose is acceptable (check serum levels)"
     }
    ]
   }
  ]
 },
