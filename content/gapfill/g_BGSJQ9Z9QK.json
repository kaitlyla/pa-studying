      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "PrEP: TAF/FTC (oral) for sexual risk, ⍉receptive vaginal sex."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "PrEP injectables: cabotegravir q2mo; lenacapavir q6mo (lenacapavir PrEP FDA-approved Jun 2025)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "nPEP preferred: bictegravir/FTC/TAF, or dolutegravir + (TAF or TDF) + (FTC or lamivudine); 28-day course, start ideally w.in 24-36 h, ≤72 h after exposure."
     }
    ]
   }
  ]
