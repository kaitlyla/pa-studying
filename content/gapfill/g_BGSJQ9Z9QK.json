    "content": [
     {
      "type": "text",
      "text": "PrEP: TDF/FTC (oral) for all at-risk groups, incl injection drug use."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
