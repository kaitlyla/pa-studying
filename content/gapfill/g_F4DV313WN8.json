        "type": "bold"
       }
      ],
      "text": "Precaution:"
     },
     {
      "type": "text",
      "text": " taper a BB (don't stop it abruptly) b4 starting nifedipine."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
