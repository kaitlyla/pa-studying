    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Acute diarrhea (< 4 days)"
     },
     {
      "type": "text",
      "text": " USU needs ⍉testing."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Acute diarrhea w dehydration, bloody stool, fever, severe pain, hypotension or toxic features:"
     },
     {
      "type": "text",
      "text": " CBC, lytes, BUN and creatinine; stool for microscopy and cx, plus C. difficile toxin if abx were taken recently."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Chronic diarrhea (> 4 wks):"
     },
     {
      "type": "text",
      "text": " directed by H&P; if that gives ⍉direction, first tests: stool for occult blood, fat (Sudan stain or fecal elastase), lytes (osmotic gap) and Giardia Ag or PCR; CBC w differential; celiac serology (IgA tTG); TSH and free T4; fecal calprotectin or lactoferrin to screen for IBD."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Ova and parasites"
     },
     {
      "type": "text",
      "text": " after recent travel to or immigration from high-risk areas; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "C. difficile"
     },
     {
      "type": "text",
      "text": " testing after recent abx."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Sigmoidoscopy or colonoscopy w biopsies"
     },
     {
      "type": "text",
      "text": " then looks for inflam Eti."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Stool osmotic gap"
     },
     {
      "type": "text",
      "text": " = 290 − 2 × (stool sodium + stool potassium): < 50 mEq/L means secretory diarrhea; a lrger gap suggests osmotic diarrhea."
     }
    ]
   }
  ]
 },
