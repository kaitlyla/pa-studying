     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "INH slows phenytoin met (lower phenytoin dose); sig rxn w disulfiram."
     }
    ]
   }
  ]
