     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Serial LFTs only if liver-disease RF. If fatigue, anorexia, N/V or jaundice: stop and check LFTs. Pyridoxine 25–50 mg daily prevents neuropathy in at-risk pts (preg/breastfeed, malnourished, DM, HIV, EToH use, older)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
