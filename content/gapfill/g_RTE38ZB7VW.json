       }
      ],
      "text": "Role in PAH:"
     },
     {
      "type": "text",
      "text": " sildenafil, tadalafil and vardenafil = oral PDE5 inhibitors (nitric oxide pathway); combination tx is generally preferred in groups 1 and 4."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
