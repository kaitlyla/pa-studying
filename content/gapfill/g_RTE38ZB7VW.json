    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Sildenafil interactions:"
     },
     {
      "type": "text",
      "text": " strong CYP3A inhibitors ⍉recommended; CYP3A inducers (eg, bosentan) ↓exposure; don't combine w Viagra or other PDE-5 inhibitors."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
