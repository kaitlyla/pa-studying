     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Sildenafil warnings:"
     },
     {
      "type": "text",
      "text": " monitor BP w other BP-lowering drugs; seek care for sudden vision or hearing loss; erection > 4 h needs immediate care (priapism)."
     }
    ]
   },
