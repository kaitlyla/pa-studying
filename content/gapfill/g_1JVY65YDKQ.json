    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Poor or lost Hb response:"
     },
     {
      "type": "text",
      "text": " look for Fe deficiency, infect, inflam or bleed, then PRCA. Severe anemia w a ↓retic count: withhold it and test for neutralizing antibodies. PRCA: stop permanently and don't switch to another ESA."
     }
    ]
