      ],
      "text": "Meningitis"
     },
     {
      "type": "text",
      "text": " = the MC reason for an emergent LP."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
