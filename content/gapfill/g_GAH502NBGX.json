    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Absolute contraindications:"
     },
     {
      "type": "text",
      "text": " infected skin @ the site, or a space-occupying lesion on CT."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
