      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Norepinephrine: 2 to 12 mcg/min (or 0.1 mcg/kg/min); alpha (vasoconstriction) + beta (inotropic, chronotropic)."
     }
    ]
   }
  ]
 },
