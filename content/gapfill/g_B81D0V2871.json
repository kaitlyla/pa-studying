       }
      ],
      "text": "Septal hematoma"
     },
     {
      "type": "text",
      "text": " looks like purplish bulge on septum"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
