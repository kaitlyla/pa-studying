      ],
      "text": "Role in cardiogenic shock:"
     },
     {
      "type": "text",
      "text": " moderate hypotension (MAP 70–90 mm Hg): dobutamine infusion ↑CO and ↓LV filling pressure; tachy and arrhythmias occasionally occur (esp higher doses), needing a lower dose."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Dobutamine:"
     },
     {
      "type": "text",
      "text": " USU 2.5–15 mcg/kg/min IV (rarely up to 40)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Contraindicated in idiopathic hypertrophic subaortic stenosis. Contains sodium metabisulfite (sulfite allergic-type rxns)."
     }
    ]
   }
