       {
        "type": "bold"
       }
      ],
      "text": "BI-RADS (her chart):"
     },
     {
      "type": "text",
      "text": " 0 = incomplete; 1 = negative; 2 = benign; 3 = probably benign (6 mo f/u, <2% malignancy); "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "4 = suspicious - biopsy"
     },
     {
      "type": "text",
      "text": " (4A low / 4B intermediate / 4C high); "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "5 = highly suggestive of malignancy (>95%) - biopsy"
     },
     {
      "type": "text",
      "text": "; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "6 = known biopsy-proven cancer"
     }
    ]
   },
   {
