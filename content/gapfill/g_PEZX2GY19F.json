       }
      ],
      "text": "Transverse colon > 6 cm w thumbprinting"
     },
     {
      "type": "text",
      "text": " → toxic megacolon (UC, C. difficile)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
