     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Buzzword:"
     },
     {
      "type": "text",
      "text": " "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "thumbprinting (mucosal edema)"
     },
     {
      "type": "text",
      "text": " on AXR / CT colon → ischemic / inflam colitis, toxic megacolon"
     }
    ]
   },
   {
    "type": "paragraph",
