     }
    },
    "content": [
     {
      "type": "text",
      "text": "Flat and upright films may show "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "megacolon or intraluminal gas over a long, cont, paralyzed segment of colon"
     },
     {
      "type": "text",
      "text": " (lost musc tone)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
