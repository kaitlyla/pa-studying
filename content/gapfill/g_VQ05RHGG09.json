        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "Bird's beak @ LES w prox dilate"
     },
     {
      "type": "text",
      "text": " → achalasia"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
