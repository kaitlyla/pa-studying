     {
      "type": "text",
      "text": "MC hyperthyroidism tx in the US; often recommended as the tx of choice for Graves and toxic nodular goiter, incl in children."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
