       }
      ],
      "text": "Suspected spinal cord injury:"
     },
     {
      "type": "text",
      "text": " MRI."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
