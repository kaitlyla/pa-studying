     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "CXR"
     },
     {
      "type": "text",
      "text": " shows airway disrupt, lung inj, hemothorax, pneumothorax and a widened mediastinum; chest CT = more sensitive."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
