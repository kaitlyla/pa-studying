       }
      ],
      "text": "Sus pelvic frx:"
     },
     {
      "type": "text",
      "text": " CT of the pelvis."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
