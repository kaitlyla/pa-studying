     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "C-spine imaging (preferably CT)"
     },
     {
      "type": "text",
      "text": " for everyone except awake, alert, sober pts w ⍉focal deficits, midline tenderness or distracting inj."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "E-FAST"
     },
     {
      "type": "text",
      "text": " for intraperitoneal blood, esp in unstable pts; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "CT"
     },
     {
      "type": "text",
      "text": " if stable."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
