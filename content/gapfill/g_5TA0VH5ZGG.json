    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Possible aortic injury"
     },
     {
      "type": "text",
      "text": " (deceleration, pulse deficits, asymmetric BP): may need CT angiography or other aortic imaging."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
