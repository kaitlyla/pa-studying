       {
        "type": "bold"
       }
      ],
      "text": "Significant blunt chest injury:"
     },
     {
      "type": "text",
      "text": " cardiac monitor and ECG."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
