      "text": "Current guideline:"
     },
     {
      "type": "text",
      "text": " CDC's 2024 U.S. Medical Eligibility Criteria for Contraceptive Use (U.S. MEC)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Combined OCs after delivery at > 28 weeks:"
     },
     {
      "type": "text",
      "text": " not started until > 21 days postpartum; delay to 42 days if VTE risk is increased (eg, recent cesarean or medical comorbidities)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Progestin-only OCs"
     },
     {
      "type": "text",
      "text": " may be used immediately postpartum."
     }
    ]
   }
  ]
 },
