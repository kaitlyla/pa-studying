      "content": [
       {
        "type": "text",
        "text": "Your notes (Hormonal Contraceptives row) say combined hormonal contraceptives are contraindicated for the first 6 weeks postpartum."
       }
      ]
     },
     {
      "type": "paragraph",
      "attrs": {
       "indLeft": 0,
       "indRight": 0,
       "indFirst": 0,
       "spaceBefore": 0,
       "spaceAfter": 0,
       "line": null,
       "align": "left",
       "shade": null,
       "borders": null,
       "marker": null
      },
      "content": [
       {
        "type": "text",
        "text": "Current advice allows them after 21 days postpartum, waiting until 42 days only when VTE risk is increased."
       }
      ]
     }
    ]
   }
