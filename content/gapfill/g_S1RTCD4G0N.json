      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Type and cross-match"
     },
     {
      "type": "text",
      "text": " if bleed = ongoing; repeat hgb and HCT up to every 6 hrs in severe bleed."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Nasogastric aspiration and lavage"
     },
     {
      "type": "text",
      "text": " for every sus upper GI bleed; up to 15% of upper GI bleeds have ⍉blood in the aspirate."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Upper endoscopy"
     },
     {
      "type": "text",
      "text": " for upper GI bleed: rapidly when bleed = sig, deferrable for 24 hrs if it stops or = minimal."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
