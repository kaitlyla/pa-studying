      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Hematochezia:"
     },
     {
      "type": "text",
      "text": " colonoscopy (sigmoidoscopy and anoscopy may be enough for typical hemorrhoidal bleeding)."
     }
    ]
   },
   {
