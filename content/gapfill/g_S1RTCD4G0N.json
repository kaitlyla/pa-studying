      ],
      "text": "CBC"
     },
     {
      "type": "text",
      "text": " for large-volume or occult blood loss; sig bleed also needs "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "coag studies"
     },
     {
      "type": "text",
      "text": " (PLT, PT, PTT) and "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "liver tests"
     },
     {
      "type": "text",
      "text": "."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
