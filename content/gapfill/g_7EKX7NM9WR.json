     {
      "type": "text",
      "text": "Plan B One-Step: levonorgestrel 1.5 mg"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
