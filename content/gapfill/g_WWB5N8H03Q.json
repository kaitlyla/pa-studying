     "borders": null,
     "marker": null
    },
    "content": [
     {
      "type": "text",
      "text": "Widespread ST elevation in a usually benign pattern, common in young, healthy patients under 50."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 6,
