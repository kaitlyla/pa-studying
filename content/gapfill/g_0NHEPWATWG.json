     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Progress (post-op) — Progress:"
     },
     {
      "type": "text",
      "text": " document the patient's progress, response to and changes in treatment, and any revision of the diagnosis."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
