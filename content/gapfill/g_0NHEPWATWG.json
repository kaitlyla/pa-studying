     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Consult — Billing a consult (Medicare):"
     },
     {
      "type": "text",
      "text": " Medicare doesn't pay the CPT consultation codes (inpatient 99252-99255, office/outpatient 99242-99245); report the correct E/M visit code for the consult instead."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
