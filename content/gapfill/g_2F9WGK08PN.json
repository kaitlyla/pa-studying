       }
      ],
      "text": "Idarucizumab:"
     },
     {
      "type": "text",
      "text": " 5 g IV, given as two 2.5 g/50 mL vials."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "PCC (Kcentra) for warfarin reversal:"
     },
     {
      "type": "text",
      "text": " dose by baseline INR and body weight; give vitamin K concurrently to keep factor levels up once PCC wears off."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Kcentra boxed warning:"
     },
     {
      "type": "text",
      "text": " fatal and non-fatal arterial and venous thromboembolic complications; may not be suitable after a thromboembolic event in the prior 3 months."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Vitamin K (anticoagulant-induced hypoprothrombinemia): 2.5–10 mg or more SC, IM or IV, up to 25–50 mg as a single dose; when IV can't be avoided, inject very slowly, ≤ 1 mg/min."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Vitamin K boxed warning:"
     },
     {
      "type": "text",
      "text": " fatal hypersensitivity reactions incl. anaphylaxis with IV and IM injection, even after dilution and on the first dose; avoid IV/IM unless SC isn't feasible and the serious risk is justified."
     }
    ]
   }
  ]
