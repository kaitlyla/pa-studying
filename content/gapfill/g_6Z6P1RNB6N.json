      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "N/V may occur, esp w inferior MI"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 6,
     "spaceAfter": 0,
