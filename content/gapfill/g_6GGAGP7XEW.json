     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "CNS stimulant boxed warning (Ritalin):"
     },
     {
      "type": "text",
      "text": " high potential for abuse and misuse → SUD incl addiction; misuse can cause OD and death."
     }
    ]
   }
  ]
 },
