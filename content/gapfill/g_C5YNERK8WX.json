    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Mid-level practitioner:"
     },
     {
      "type": "text",
      "text": " to the DEA, a PA authorized by their state to dispense controlled substances is a mid-level practitioner."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Definition:"
     },
     {
      "type": "text",
      "text": " a mid-level practitioner is a practitioner other than a physician, dentist, veterinarian or podiatrist who is licensed, registered or otherwise permitted by the United States or the jurisdiction where they practice to dispense a controlled substance in professional practice."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Prescribing counts:"
     },
     {
      "type": "text",
      "text": " under federal law, \"dispense\" includes prescribing and administering a controlled substance."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "DEA registration:"
     },
     {
      "type": "text",
      "text": " everyone who dispenses a controlled substance must obtain a DEA registration unless exempted by law."
     }
    ]
   }
  ]
 },
