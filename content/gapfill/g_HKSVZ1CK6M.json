    },
    "content": [
     {
      "type": "text",
      "text": "Complete AV dissociation: the P waves and the QRS complexes each run at their own rate, independent of each other."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 6,
