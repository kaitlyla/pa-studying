     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Left posterior fascicular block, lateral MI, RVH, acute lung disease (e.g., PE), chronic lung disease (e.g., COPD), ventricular ectopy, hyperkalemia, sodium-channel blocker toxicity, WPW"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
