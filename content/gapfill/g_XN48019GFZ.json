      ],
      "text": "Role in takotsubo:"
     },
     {
      "type": "text",
      "text": " ACEis or ARBs may help LV recovery; linked to better 1-yr survival and less recurrence (not yet validated)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
