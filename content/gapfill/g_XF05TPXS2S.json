    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Progress — Progress:"
     },
     {
      "type": "text",
      "text": " document the patient's progress, response to and changes in treatment, and any revision of the diagnosis."
     }
    ]
   }
