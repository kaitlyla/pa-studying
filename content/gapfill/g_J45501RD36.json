       }
      ],
      "text": "Every visit:"
     },
     {
      "type": "text",
      "text": " age-appropriate exam, w infant totally unclothed & older children undressed & suitably draped"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
