     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Eyes:"
     },
     {
      "type": "text",
      "text": " inspect eyes & eyelids - examine pupils for opacification & red reflexes - assess visual acuity using fixate and follow response"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
