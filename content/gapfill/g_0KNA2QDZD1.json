    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Purulent fluid"
     },
     {
      "type": "text",
      "text": " strongly suggests empyema."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
