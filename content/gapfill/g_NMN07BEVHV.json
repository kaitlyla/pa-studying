       {
        "type": "bold"
       }
      ],
      "text": "Length:"
     },
     {
      "type": "text",
      "text": " USU 20 minutes (sometimes 40 minutes)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
