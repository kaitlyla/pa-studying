    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Biophysical profile (BPP):"
     },
     {
      "type": "text",
      "text": " USU done after a nonreassuring NST. It adds US of amniotic fluid vol, fetal mvt, tone, and breathing to the NST."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
