     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Used for"
     },
     {
      "type": "text",
      "text": " complicated or high-risk pregnancies, eg, maternal diabetes, HTN, prior stillbirth, fetal growth restriction, or fetal anomaly."
     }
