    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Reactive (reassuring):"
     },
     {
      "type": "text",
      "text": " 2 accelerations of 15 beats/min over 20 minutes. ⍉accelerations = nonreactive (nonreassuring)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
