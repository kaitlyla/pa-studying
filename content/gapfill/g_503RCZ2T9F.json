     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Extensive drusen, pigment changes and/or geographic atrophy: lowers the risk of advanced AMD by 25%. Unilateral wet AMD: take them to protect the other eye"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Current or former smokers: lutein/zeaxanthin instead of beta-carotene (lung cancer risk). Zinc raises the risk of genitourinary disorders"
     }
    ]
   }
  ]
