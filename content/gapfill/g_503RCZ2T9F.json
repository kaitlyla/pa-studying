    "content": [
     {
      "type": "text",
      "text": "Daily: zinc oxide 80 mg, copper 2 mg, vitamin C 500 mg, vitamin E 400 IU, lutein 10 mg/zeaxanthin 2 mg (or beta-carotene 15 mg or vitamin A 28,000 units in pts who have never smoked)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
