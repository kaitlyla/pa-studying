     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Tetrabenazine (Xenazine) overdose:"
     },
     {
      "type": "text",
      "text": " OD (100 mg–1 g): acute dystonia, oculogyric crisis, nausea/vomiting, sweating, sedation, hypotension, confusion, diarrhea, hallucinations, rubor, tremor."
     }
    ]
   }
