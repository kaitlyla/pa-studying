        "type": "bold"
       }
      ],
      "text": "BBW:"
     },
     {
      "type": "text",
      "text": " ⍉for obesity or wt loss; ineffective for wt loss in euthyroid pts @ usual doses. Oral TH = ⍉for myxedema coma."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
