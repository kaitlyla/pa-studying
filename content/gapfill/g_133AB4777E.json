    "content": [
     {
      "type": "text",
      "text": "Alternatives to TMP-SMX: trimethoprim with dapsone, clindamycin plus primaquine, pentamidine, or atovaquone (mild pneumonia only)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Pentamidine's main limit is toxicity: acute kidney injury, hypotension, hypoglycemia."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Prophylaxis when TMP-SMX isn't tolerated: dapsone or aerosolized pentamidine."
     }
    ]
   }
  ]
