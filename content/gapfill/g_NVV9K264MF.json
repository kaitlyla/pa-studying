         "hex": "FF0000"
        }
       }
      ],
      "text": "cephalization:"
     },
     {
      "type": "text",
      "text": " upper lobe pulmonary vessels become more prominent; both are often seen in heart failure"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
