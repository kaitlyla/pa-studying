    "content": [
     {
      "type": "text",
      "text": "Cardiogenic pulm edema: acute alveolar flooding caused by pulm venous HTN 2/2 severe Lt ventricular failure"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Triggers: acute coronary ischemia, decompensated HF, arrhythmia, an acute valvular dx or acute vol overload"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
