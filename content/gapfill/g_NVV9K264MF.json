        }
       }
      ],
      "text": "Cardiomegaly:"
     },
     {
      "type": "text",
      "text": " cardiac silhouette > 50% of the thoracic cage on a PA film; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
