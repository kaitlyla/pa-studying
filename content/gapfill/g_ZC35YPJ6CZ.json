     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Duodenum:"
     },
     {
      "type": "text",
      "text": " the shortest part (25.4 cm); it starts at the pyloric sphincter, passes behind the peritoneum (retroperitoneal) and curves in a C around the head of the pancreas."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
