       }
      ],
      "text": "Stomach regions:"
     },
     {
      "type": "text",
      "text": " cardia, fundus, body and pylorus."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
