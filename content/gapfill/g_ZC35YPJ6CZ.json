     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Ileum:"
     },
     {
      "type": "text",
      "text": " the longest part; it joins the cecum at the ileocecal valve."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
