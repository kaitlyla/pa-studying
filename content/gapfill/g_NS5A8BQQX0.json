      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "How much:"
     },
     {
      "type": "text",
      "text": " ST elevation = typically modest (0.5–1 mm), measured against the T-P segment baseline"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
