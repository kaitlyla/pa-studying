     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Reciprocal chgs:"
     },
     {
      "type": "text",
      "text": " typically ⍉reciprocal ST depression (except aVR/V1)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
