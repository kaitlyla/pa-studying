     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Q waves:"
     },
     {
      "type": "text",
      "text": " ⍉pathologic Q waves"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
