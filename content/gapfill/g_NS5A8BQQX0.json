     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "ST segment:"
     },
     {
      "type": "text",
      "text": " "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "diffuse concave-up elevation"
     },
     {
      "type": "text",
      "text": ", not confined to a vascular territory"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
