    },
    "content": [
     {
      "type": "text",
      "text": "Diffuse, concave-up ST elevation that is not confined to one vascular territory."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
