      ],
      "text": "diffuse concave-up elevation"
     },
     {
      "type": "text",
      "text": ", ⍉confined to a vasc territory"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
