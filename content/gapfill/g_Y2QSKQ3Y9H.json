     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Valsartan:"
     },
     {
      "type": "text",
      "text": " advise patients not to use salt substitutes without asking their provider (hyperkalemia)."
     }
    ]
   }
