    "content": [
     {
      "type": "text",
      "text": "Not a transplant candidate or no donor: equine antithymocyte globulin (ATG) + cyclosporine (response about 60-70%); allergic reactions and serum sickness may occur."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
