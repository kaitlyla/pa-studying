     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Adding eltrombopag gives faster, better hematologic response but similar 2-year survival; some avoid it (earlier clonal evolution)."
     }
    ]
   }
  ]
 },
