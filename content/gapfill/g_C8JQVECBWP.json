     }
    },
    "content": [
     {
      "type": "text",
      "text": "Contraindicated in complete biliary obstruction (bile not secreted into the intestine)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
