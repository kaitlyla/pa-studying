       }
      ],
      "text": "Motor:"
     },
     {
      "type": "text",
      "text": " catches a large ball most of the time; serves himself food or pours water, with adult supervision; unbuttons some buttons; holds crayon or pencil between fingers and thumb (not in a fist)."
     }
