    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Cognitive:"
     },
     {
      "type": "text",
      "text": " names a few colors of items; tells what comes next in a well-known story; draws a person with ≥3 body parts."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
