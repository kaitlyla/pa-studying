       }
      ],
      "text": "What these are:"
     },
     {
      "type": "text",
      "text": " milestones most children (≥75%) are expected to reach by this visit age."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Social/emotional:"
     },
     {
      "type": "text",
      "text": " calms down within 10 min after you leave her, like at child care drop off; notices other children and joins them to play."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Language/communication:"
     },
     {
      "type": "text",
      "text": " talks with you in conversation using at least 2 back-and-forth exchanges; asks who, what, where, or why questions, like “Where is mommy/daddy?”; says what action is happening in a picture when asked, like running, eating, or playing; says first name when asked; talks well enough for others to understand, most of the time."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Cognitive:"
     },
     {
      "type": "text",
      "text": " draws a circle when you show him how; avoids touching hot objects, like a stove, when you warn her."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Motor:"
     },
     {
      "type": "text",
      "text": " strings items together, like large beads or macaroni; puts on some clothes by himself, like loose pants or a jacket; uses a fork."
     }
    ]
   }
