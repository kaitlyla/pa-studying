     }
    },
    "content": [
     {
      "type": "text",
      "text": "Dx = USU clin, but an AP radiograph of the neck and chest showing classic "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "subepiglottic narrowing (steeple sign)"
     },
     {
      "type": "text",
      "text": " supports it"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
