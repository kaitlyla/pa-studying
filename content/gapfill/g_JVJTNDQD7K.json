       {
        "type": "bold"
       }
      ],
      "text": "Hair apposition (HAT)"
     },
     {
      "type": "text",
      "text": " for scalp wounds: twist hair from each side together and glue. Good for kids, no needle."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
