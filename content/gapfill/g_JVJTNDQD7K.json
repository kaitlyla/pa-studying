       {
        "type": "bold"
       }
      ],
      "text": "Simple interrupted"
     },
     {
      "type": "text",
      "text": " sutures suit most wounds."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
