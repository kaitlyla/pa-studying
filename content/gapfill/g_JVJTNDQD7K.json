      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Primary intention:"
     },
     {
      "type": "text",
      "text": " approximate all layers with sutures, staples, adhesive or steri-strips."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
