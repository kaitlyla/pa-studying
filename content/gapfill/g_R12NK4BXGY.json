       {
        "type": "bold"
       }
      ],
      "text": "PE:"
     },
     {
      "type": "text",
      "text": " anticoagulation is the mainstay; IV UFH or SC LMWH are initial options. UFH has a short half-life and is reversible with protamine, so some clinicians prefer it when thrombolysis is given or contemplated or bleeding risk is high."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "UFH:"
     },
     {
      "type": "text",
      "text": " IV bolus, then a protocol infusion to an aPTT 1.5–2.5× control."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "LMWH in renal insufficiency:"
     },
     {
      "type": "text",
      "text": " reduce the dose and check anti-Xa levels (target 0.5–1.2 IU/mL, 3–4 h after the 4th dose); generally contraindicated in severe renal insufficiency."
     }
    ]
   }
  ]
 },
