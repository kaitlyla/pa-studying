      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Who:"
     },
     {
      "type": "text",
      "text": " typically young and healthy w structurally norm hearts; median age @ presentation 30 years"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
