        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "< 330 ms in men or < 340 ms in women"
     },
     {
      "type": "text",
      "text": " is diagnostic of short QT syndrome"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
