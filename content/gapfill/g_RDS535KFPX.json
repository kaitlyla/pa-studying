    "content": [
     {
      "type": "text",
      "text": "A short QT that does not change normally with heart rate, peaked T waves (especially precordial) and short or absent ST segments."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
