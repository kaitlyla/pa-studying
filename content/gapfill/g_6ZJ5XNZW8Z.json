    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Mild chronic HTN:"
     },
     {
      "type": "text",
      "text": " targeting BP < 140/90 mm Hg was linked to less preeclampsia and preterm birth, w.o more small-for-gestational-age births."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Low-dose ASA (81 mg/day)"
     },
     {
      "type": "text",
      "text": " for high-risk factors for preeclampsia: prev preeclampsia, multi gestation, renal or autoimmune disorders, diabetes, or chronic HTN."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Also"
     },
     {
      "type": "text",
      "text": " for > 1 moderate-risk factor, eg, first preg, maternal age ≥ 35, or prepregnancy BMI > 30."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Timing:"
     },
     {
      "type": "text",
      "text": " start ASA @ 12 to 28 wks (ideally b4 16 wks) and cont until delivery."
     }
    ]
   }
  ]
 },
