     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Unstable (shock, ongoing Sx, hypotension, sustained arrhythmias):"
     },
     {
      "type": "text",
      "text": " "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "straight to the cath lab"
     },
     {
      "type": "text",
      "text": " for angio"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
