       }
      ],
      "text": "Her chart:"
     },
     {
      "type": "text",
      "text": " surg repair"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
