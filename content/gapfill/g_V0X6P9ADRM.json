    "content": [
     {
      "type": "text",
      "text": "Phenylephrine 0.25% spray q3h or oxymetazoline q8–12h; maximum 5 days, or 3 days on / 3 days off until the sinusitis resolves"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
