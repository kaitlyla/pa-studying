      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Phenylephrine nasal spray (OTC label): adults and ≥12 y/o, 2–3 sprays/nostril ⍉more often than q4h"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
