     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Use for longer than 3 days can cause rebound congestion (rhinitis medicamentosa). Systemic decongestants are less effective and should be avoided"
     }
    ]
   }
  ]
 },
