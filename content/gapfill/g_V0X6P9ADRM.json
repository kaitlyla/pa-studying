     {
      "type": "text",
      "text": "Oxymetazoline q8–12h; max 5 days, or 3 days on / 3 days off until the sinusitis resolves"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
