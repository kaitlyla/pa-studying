       {
        "type": "bold"
       }
      ],
      "text": "Suspected hemorrhage"
     },
     {
      "type": "text",
      "text": " (ruptured AAA, GI bleed, ectopic): pregnancy test in reproductive-age women and abdominal and pelvic CT, or bedside ultrasound if unstable."
     }
    ]
