    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Echocardiogram and chest x-ray;"
     },
     {
      "type": "text",
      "text": " bedside ultrasound to judge cardiac filling, function and volume status."
     }
    ]
   },
   {
    "type": "paragraph",
