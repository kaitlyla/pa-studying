      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Mother's depression:"
     },
     {
      "type": "text",
      "text": " screen per the AAP report on recognizing and managing perinatal depression in pediatric practice."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
