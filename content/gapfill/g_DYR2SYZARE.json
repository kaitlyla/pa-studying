     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Depression and suicide risk:"
     },
     {
      "type": "text",
      "text": " screen adolescents, making every effort to preserve their confidentiality."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
