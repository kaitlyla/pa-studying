    "content": [
     {
      "type": "text",
      "text": "Hypersensitivity to clindamycin or lincomycin. Caution with a history of GI disease, especially colitis."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
