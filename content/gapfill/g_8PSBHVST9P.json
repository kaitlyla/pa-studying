     "marker": null
    },
    "content": [
     {
      "type": "text",
      "text": "Sinus tachycardia (> 100 bpm, mean 24-hour rate > 90) with no physiologic or secondary cause."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 6,
