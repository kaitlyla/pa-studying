    },
    "content": [
     {
      "type": "text",
      "text": "A dx of exclusion: the 2/2 Eti of sinus tachy must be ruled out first"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
