       {
        "type": "bold"
       }
      ],
      "text": "Mech:"
     },
     {
      "type": "text",
      "text": " unknown; proposed components are ↑sinus node automaticity, ↓vagal sensitivity and ↑beta-adrenergic sensitivity"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
