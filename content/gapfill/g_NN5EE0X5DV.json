         "hex": "FF0000"
        }
       }
      ],
      "text": "BHL ± reticular markings"
     },
     {
      "type": "text",
      "text": " → sarcoidosis (Stage I/II)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 6,
     "spaceAfter": 0,
