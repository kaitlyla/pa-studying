     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Testicular artery:"
     },
     {
      "type": "text",
      "text": " a branch of the abdominal aorta that runs to the testes as part of the spermatic cord."
     }
    ]
