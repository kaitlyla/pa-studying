      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Common sites: median cubital, cephalic, basilic, external jugular; use the non-dominant arm."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
