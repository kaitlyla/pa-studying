    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Intraosseous:"
     },
     {
      "type": "text",
      "text": " rapid access when all else fails (arrest, trauma, shock)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
