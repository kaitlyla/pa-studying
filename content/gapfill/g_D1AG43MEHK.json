     }
    },
    "content": [
     {
      "type": "text",
      "text": "All medications, even blood products (with ≥18 g), can be given IO."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
