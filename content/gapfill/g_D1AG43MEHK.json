     }
    },
    "content": [
     {
      "type": "text",
      "text": "Complications: vascular injury, infection, pneumothorax, bleeding, air embolism."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
