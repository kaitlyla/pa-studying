    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Toenail onychomycosis:"
     },
     {
      "type": "text",
      "text": " itraconazole 200 mg once daily for 12 consecutive weeks. Fingernails only: 2 pulses of 200 mg twice daily for 1 week, separated by 3 weeks off. Take capsules with a full meal."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Boxed warning:"
     },
     {
      "type": "text",
      "text": " not for onychomycosis with ventricular dysfunction such as CHF or a history of CHF; stop if heart failure signs or symptoms occur."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Boxed warning:"
     },
     {
      "type": "text",
      "text": " many CYP3A4 substrates are contraindicated with itraconazole, eg methadone, disopyramide, dofetilide, dronedarone, quinidine and ergot alkaloids."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Rare serious hepatotoxicity, some within the first week: consider liver function monitoring in all patients; stop at once and test liver function if signs of liver dysfunction develop."
     }
    ]
   }
  ]
