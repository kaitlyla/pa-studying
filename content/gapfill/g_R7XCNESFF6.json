       {
        "type": "bold"
       }
      ],
      "text": "Toenail onychomycosis:"
     },
     {
      "type": "text",
      "text": " itraconazole 200 mg QD for 12 consecutive wks. Fingernails only: 2 pulses of 200 mg BID for 1 wk, separated by 3 wks off. Take capsules w a full meal."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Boxed warning:"
     },
     {
      "type": "text",
      "text": " ⍉for onychomycosis w ventricular dysfun such as CHF or a Hx of CHF; stop if HF signs or Sx occur."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
