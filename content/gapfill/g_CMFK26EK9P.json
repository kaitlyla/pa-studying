    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Acute ischemic stroke:"
     },
     {
      "type": "text",
      "text": " aspirin 81 to 325 mg within 48 hours of onset."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "After a TIA or minor stroke, clopidogrel plus aspirin appears more effective than aspirin alone at reducing stroke risk in the first 90 days, without more hemorrhage."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Interactions:"
     },
     {
      "type": "text",
      "text": " avoid other NSAIDs (more bleeding, ↓ renal function); anticoagulants (heparin, warfarin) ↑ bleeding risk."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Counseling:"
     },
     {
      "type": "text",
      "text": " three or more alcoholic drinks a day raises the bleeding risk."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Toxicity (salicylism):"
     },
     {
      "type": "text",
      "text": " early nausea, vomiting, tinnitus and hyperventilation; respiratory alkalosis plus metabolic acidosis, which eventually becomes the primary finding. Treat with activated charcoal and alkaline diuresis with extra KCl; consider hemodialysis if poisoning is severe."
     }
    ]
   }
  ]
 },
