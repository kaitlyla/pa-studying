    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Mech:"
     },
     {
      "type": "text",
      "text": " the Lt ventricle hypertrophies in response to P overload, ex, AS or HTN"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
