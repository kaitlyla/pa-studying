      ],
      "text": "Eti:"
     },
     {
      "type": "text",
      "text": " "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "HTN (MC)"
     },
     {
      "type": "text",
      "text": ", AS, AR, MR, CoA, HCM"
     }
    ]
   },
