       }
      ],
      "text": "Systol funct (LVEF):"
     },
     {
      "type": "text",
      "text": " HFrEF ≤40% / HFmrEF 41-49% / HFpEF ≥50%"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
