      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Nonallergic rhinitis: topical decongestants (eg, oxymetazoline) should be avoided; rebound congestion can follow 3 days of continuous use"
     }
    ]
   }
  ]
 },
