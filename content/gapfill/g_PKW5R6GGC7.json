    "content": [
     {
      "type": "text",
      "text": "Allergic rhinitis: not first-line; short-term relief of congestion only, not beyond 3–5 days. Oral decongestants (eg, pseudoephedrine) may cause tachycardia and hypertension"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
