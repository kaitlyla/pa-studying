    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Prolonged PT or aPTT:"
     },
     {
      "type": "text",
      "text": " repeat after a 1:1 mix with normal plasma; failure to correct suggests an inhibitor rather than a factor deficiency."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
