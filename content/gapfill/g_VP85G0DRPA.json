       {
        "type": "bold"
       }
      ],
      "text": "Add renal and liver function tests"
     },
     {
      "type": "text",
      "text": " when a bleeding disorder is suspected."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
