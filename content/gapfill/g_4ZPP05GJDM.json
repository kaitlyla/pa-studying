     "marker": null
    },
    "content": [
     {
      "type": "text",
      "text": "Deep symmetric T-wave inversion or biphasic T waves in V2–V3, typically in a pain-free pt."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 6,
