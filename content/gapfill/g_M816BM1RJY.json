     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Her chart:"
     },
     {
      "type": "text",
      "text": " "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "ERCP"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "If biliary obstruct = sus, "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "ERCP and sphincterotomy"
     },
     {
      "type": "text",
      "text": " are necessary to remove the stones"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Acute cholangitis: aggressive supportive care, abx and urgent stone removal and drainage (endoscopic or surg)"
     }
    ]
   }
  ]
