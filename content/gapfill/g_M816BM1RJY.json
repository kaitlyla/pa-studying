       }
      ],
      "text": "Dilated CBD w stone in dist duct"
     },
     {
      "type": "text",
      "text": " → choledocholithiasis"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
