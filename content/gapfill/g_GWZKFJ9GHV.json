    "content": [
     {
      "type": "text",
      "text": "Complement-mediated HUS: eculizumab, ravulizumab or pegcetacoplan can often reverse kidney failure."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
