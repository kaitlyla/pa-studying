    "content": [
     {
      "type": "text",
      "text": "Sustained, tolerated verapamil-sensitive idiopathic LV VT (interfascicular reentry): IV verapamil to terminate."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
