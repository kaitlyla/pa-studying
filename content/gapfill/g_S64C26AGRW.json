     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Consider a dissecting aortic aneurysm,"
     },
     {
      "type": "text",
      "text": " especially in older patients."
     }
