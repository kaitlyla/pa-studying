     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "PML risk factors:"
     },
     {
      "type": "text",
      "text": " anti-JCV antibodies, longer duration of therapy and prior immunosuppressants."
     }
