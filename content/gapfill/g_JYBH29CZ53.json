        }
       }
      ],
      "text": "Crescent-shaped subchondral T1 hypointensity in femoral head"
     },
     {
      "type": "text",
      "text": " → avascular necrosis (steroids, EToH, sickle cell)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
