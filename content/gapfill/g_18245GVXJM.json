    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Disabling or lasting > 6 weeks:"
     },
     {
      "type": "text",
      "text": " MRI or CT."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
