    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Imaging findings don't always match symptoms:"
     },
     {
      "type": "text",
      "text": " many people with disc herniations have no symptoms."
