     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Less accurate:"
     },
     {
      "type": "text",
      "text": " ferning on a dried slide or blue Nitrazine paper (alkaline fluid); blood, semen, antiseptics, urine or bacterial vaginosis can give false positives. Oligohydramnios on ultrasound supports the diagnosis."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
