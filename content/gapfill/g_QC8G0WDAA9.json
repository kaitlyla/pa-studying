     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Still unclear:"
     },
     {
      "type": "text",
      "text": " ultrasound-guided amniocentesis with indigo carmine dye; blue on a tampon or pad confirms it."
     }
    ]
   }
