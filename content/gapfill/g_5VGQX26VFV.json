      "type": "text",
      "text": "Short-term transdermal testosterone can be effective in postmenopausal women w sexual interest/arousal disorder"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
