        }
       }
      ],
      "text": "Eccentric MR jet, dilated LA/LV"
     },
     {
      "type": "text",
      "text": " → mitral regurgitation"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
