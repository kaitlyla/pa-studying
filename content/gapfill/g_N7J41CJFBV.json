       }
      ],
      "text": "Chamber sizes:"
     },
     {
      "type": "text",
      "text": " LV (LVEDD, LVESD), RV (> 1:1 w LV = dilated), LA, RA"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
