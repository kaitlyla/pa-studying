    "content": [
     {
      "type": "text",
      "text": "If the drug must cont: switch to a liquid formulation if available."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
