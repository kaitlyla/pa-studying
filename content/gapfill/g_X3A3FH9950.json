     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Monitoring:"
     },
     {
      "type": "text",
      "text": " 3% saline (513 mEq Na/L) needs lytes every 3 to 4 h; it may be used w loop diuretic; prediction formulas are only rough guides & ⍉↓need for freq lyte checks"
     }
    ]
   }
  ]
