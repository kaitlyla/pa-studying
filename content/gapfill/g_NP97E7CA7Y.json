      ],
      "text": "Fetus:"
     },
     {
      "type": "text",
      "text": " nonstress test or biophysical profile, plus est fetal wt."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
