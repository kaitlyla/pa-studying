    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Proteinuria"
     },
     {
      "type": "text",
      "text": " = > 300 mg/24 hrs or a protein/creatinine ratio ≥ 0.3; a (−) dipstick doesn't r/o preeclampsia."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
