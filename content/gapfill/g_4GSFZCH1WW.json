    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Infant:"
     },
     {
      "type": "text",
      "text": " CDC 2021: aqueous crystalline penicillin G IV or procaine penicillin G IM for 10 days; if ≥ 1 day = missed, repeat the whole course."
     }
    ]
   }
