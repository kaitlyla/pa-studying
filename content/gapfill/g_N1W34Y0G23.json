    "content": [
     {
      "type": "text",
      "text": "Fe chelation removes transfusional Fe; USU started when ferritin = > 1000 ng/mL or after ≈1-2 yr of scheduled transfusions"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
