      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Luspatercept (injectable TGF-β pathway inhibitor) = an option for transfusion-dep pts; in one trial it cut transfusion needs by 33% in 21% of pts (vs 4.5% of controls)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
