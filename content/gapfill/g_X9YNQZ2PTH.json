     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Hip bone:"
     },
     {
      "type": "text",
      "text": " the ilium, ischium and pubis, which fuse in the late teenage years."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
