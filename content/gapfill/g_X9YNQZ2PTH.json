      ],
      "text": "Bony pelvis:"
     },
     {
      "type": "text",
      "text": " the two hip bones, the sacrum and the coccyx."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
