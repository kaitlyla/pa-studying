     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Female pelvis:"
     },
     {
      "type": "text",
      "text": " adapted for childbirth: broader, with a larger subpubic angle, a rounder pelvic brim and a wider, shallower lesser pelvic cavity."
     }
