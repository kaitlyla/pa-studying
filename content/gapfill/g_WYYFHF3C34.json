     {
      "type": "text",
      "text": "Treat metabolic acidosis to serum bicarbonate > 18 mmol/L, to slow muscle wasting, bone loss and CKD progression."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Sodium bicarbonate 1-2 g orally twice a day, increased gradually until bicarbonate > 18 mmol/L or sodium overload prevents more."
     }
    ]
   }
  ]
 },
