      },
      "content": [
       {
        "type": "text",
        "text": "Your notes (Postpartum Hemorrhage row) define it as > 500 mL after vaginal delivery or > 1000 mL after C-section, or loss needing transfusion or a 10% drop in hematocrit."
       }
      ]
     },
     {
      "type": "paragraph",
      "attrs": {
       "indLeft": 0,
       "indRight": 0,
       "indFirst": 0,
       "spaceBefore": 0,
       "spaceAfter": 0,
       "line": null,
       "align": "left",
       "shade": null,
       "borders": null,
       "marker": null
      },
      "content": [
       {
        "type": "text",
        "text": "The current definition uses one threshold for any delivery: > 1000 mL, or blood loss with signs of hypovolemia, within 24 hours."
       }
      ]
     }
    ]
   }
  },
