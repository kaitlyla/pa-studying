     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Pregnancy: AAFP says don't use it; CDC notes limited human data, with animal data suggesting low risk"
     }
    ]
   }
  ]
 },
