    "content": [
     {
      "type": "text",
      "text": "Immune response modifier: induces local cytokines and a brisk inflammatory reaction"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "5% cream at bedtime 3 times/week for up to 16 weeks, or 3.75% cream nightly for up to 8 weeks; wash off after 6 to 10 hours. Can cause local inflammation and hypopigmentation; might weaken condoms and diaphragms"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
