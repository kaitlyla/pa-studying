    },
    "content": [
     {
      "type": "text",
      "text": "“Sawtooth” flutter waves at an atrial rate of about 300, commonly conducting 2:1 (ventricular rate about 150); regular unless the block varies."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
