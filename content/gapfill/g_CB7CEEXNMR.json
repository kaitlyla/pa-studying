      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Telling it from AF:"
     },
     {
      "type": "text",
      "text": " w var block, the R-R intervals are multiples of the P-P interval"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
