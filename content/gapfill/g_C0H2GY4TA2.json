    "content": [
     {
      "type": "text",
      "text": "Ex MRI of metastatic liver CA: "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "areas of ↓attenuation inside the liver"
     },
     {
      "type": "text",
      "text": ", an appearance typical of metastases"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
