      ],
      "text": "Lens-shaped (biconvex) hyperdensity, does NOT cross suture lines"
     },
     {
      "type": "text",
      "text": "; usually temporal → epidural hematoma"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
