        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "hyperdensity 60-80 HU"
     },
     {
      "type": "text",
      "text": " (epidural / subdural / SAH / IPH / IVH)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
