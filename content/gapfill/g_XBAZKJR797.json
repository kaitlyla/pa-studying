    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Blood:"
     },
     {
      "type": "text",
      "text": " look for "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
