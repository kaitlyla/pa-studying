       }
      ],
      "text": "Soft tissue / scalp:"
     },
     {
      "type": "text",
      "text": " hematoma, foreign body"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
