       }
      ],
      "text": "Confirm with multiple readings;"
     },
     {
      "type": "text",
      "text": " home BP measurement helps confirm the diagnosis."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
