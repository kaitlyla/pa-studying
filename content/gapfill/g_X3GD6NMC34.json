     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "ECG:"
     },
     {
      "type": "text",
      "text": " a broad, notched P wave = an early sign of hypertensive Hdz; ↑QRS voltage means LVH, often followed by echocardiography."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Labile, ↑BP w HA, palpitations, sweating, tremor or pallor:"
     },
     {
      "type": "text",
      "text": " plasma free metanephrines for pheochromocytoma and TSH for hyperthyroidism."
     }
    ]
