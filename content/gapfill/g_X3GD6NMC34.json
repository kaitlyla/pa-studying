       {
        "type": "bold"
       }
      ],
      "text": "Home or ambulatory monitoring"
     },
     {
      "type": "text",
      "text": " when white coat or masked HTN = sus."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
