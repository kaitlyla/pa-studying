    "content": [
     {
      "type": "text",
      "text": "Permethrin 1% cream rinse or pyrethrins with piperonyl butoxide, washed off after 10 minutes. Alternative: malathion 0.5% lotion washed off after 8 to 12 hours, when resistance is suspected"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
