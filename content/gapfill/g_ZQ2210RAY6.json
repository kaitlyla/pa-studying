     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Lindane is not recommended for pediculosis (toxicity; contraindicated in pregnancy, breastfeeding, children under 10 years and extensive dermatitis)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Eyelash infestation: petrolatum ointment 3 to 4 times a day for 8 to 10 days, or fluorescein 10 to 20% drops to the lids"
     }
    ]
   }
  ]
 },
