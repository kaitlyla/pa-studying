       }
      ],
      "text": "Usual FUO panel:"
     },
     {
      "type": "text",
      "text": " CBC w differential; ESR · CRP · procal · LDH & ferritin; liver tests; UA w microscopy; serial blood cx (ideally b4 abx); HIV Ab · RNA & PCR; TST or IGRA"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
