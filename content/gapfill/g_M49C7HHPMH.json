       }
      ],
      "text": "ANA & rheumatoid factor"
     },
     {
      "type": "text",
      "text": " to screen for rheumatologic dx"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
