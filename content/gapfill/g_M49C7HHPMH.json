      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "CT of the chest · abd & pelvis"
     },
     {
      "type": "text",
      "text": " for adenopathy & occult abscesses, even w.o localizing signs"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
