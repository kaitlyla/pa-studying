       {
        "type": "bold"
       }
      ],
      "text": "PET"
     },
     {
      "type": "text",
      "text": " can help find the focus of fever."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
