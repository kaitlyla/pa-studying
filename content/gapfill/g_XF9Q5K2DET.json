       {
        "type": "bold"
       }
      ],
      "text": "Viscous lidocaine (adults):"
     },
     {
      "type": "text",
      "text": " 15 mL undiluted; swish and spit out for the mouth, gargle (may be swallowed) for the pharynx; not more often than every three hours, and no more than eight doses in 24 hours."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Boxed warning:"
     },
     {
      "type": "text",
      "text": " seizures, cardiopulmonary arrest and death in children under 3 years when not given in strict adherence to dosing; generally not for teething pain."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
