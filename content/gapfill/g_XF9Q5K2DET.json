      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "No food for 60 minutes after use in the mouth or throat: topical anesthesia may impair swallowing and raise aspiration risk."
     }
    ]
   }
