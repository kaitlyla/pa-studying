     {
      "type": "text",
      "text": "Phexxi (lactic acid, citric acid, K bitartrate gel): on-demand contraception"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
