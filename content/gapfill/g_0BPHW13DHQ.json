        }
       }
      ],
      "text": "Apical fibronodular opacities, upper-lobe cavitation"
     },
     {
      "type": "text",
      "text": " → reactivation TB"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 6,
