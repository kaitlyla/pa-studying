      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "CI:"
     },
     {
      "type": "text",
      "text": " disulfiram within the last two weeks (psychotic reactions). Disulfiram-like reaction with alcohol: no alcohol (or propylene glycol) during and for at least three days after therapy."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
