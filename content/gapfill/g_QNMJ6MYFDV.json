        "type": "bold"
       }
      ],
      "text": "Mech:"
     },
     {
      "type": "text",
      "text": " depolarization starts in the LV and reaches the RV late, across the septum — giving the late R' in the precordial leads and the wide, slurred S wave in the lat leads"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
