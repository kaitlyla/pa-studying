        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "ring-enhancing lesions"
     },
     {
      "type": "text",
      "text": " on CT/MRI brain → abscess, toxoplasmosis (HIV), GBM, mets"
     }
    ]
   },
   {
