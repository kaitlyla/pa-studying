    },
    "content": [
     {
      "type": "text",
      "text": "Sus abscess: contrast-enhanced MRI w diffusion-weighted images or, if MRI = unavailable, contrast-enhanced CT"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 6,
