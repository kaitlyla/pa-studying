       }
      ],
      "text": "Brain:"
     },
     {
      "type": "text",
      "text": " gray-white preservation; look for "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
