    "content": [
     {
      "type": "text",
      "text": "Brain abscess: a fully developed abscess appears as an "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "edematous mass with ring enhancement"
     },
     {
      "type": "text",
      "text": ", which may be difficult to distinguish from a brain tumor or occasionally infarction; CT-guided aspiration, culture, surgical excision or a combination may be necessary"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
