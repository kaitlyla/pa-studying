       }
      ],
      "text": "Free air under diaphragm; Rigler / double-wall sign; football sign in infants"
     },
     {
      "type": "text",
      "text": " → pneumoperitoneum (perforation)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
