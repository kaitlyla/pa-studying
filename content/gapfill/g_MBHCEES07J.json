      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "On chest X-ray: "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "free air under the right hemidiaphragm"
     },
     {
      "type": "text",
      "text": " → pneumoperitoneum (perforation)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
