    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Rate and rhythm:"
     },
     {
      "type": "text",
      "text": " "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "brady"
     },
     {
      "type": "text",
      "text": " = common — sinus brady (may be marked), AF w slow ventricular response, slow junctional rhythms, varying degrees of AV block (1st–3rd)"
     }
    ]
   },
