     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Cardiac testing:"
     },
     {
      "type": "text",
      "text": " ECG, Holter monitoring, echocardiography and exercise stress testing."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
