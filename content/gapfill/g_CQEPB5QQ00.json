    "content": [
     {
      "type": "text",
      "text": "Clopidogrel alone if aspirin can't be tolerated. After PCI for stable disease, DAPT (aspirin + clopidogrel, prasugrel or ticagrelor) usually for 12 months."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Clopidogrel:"
     },
     {
      "type": "text",
      "text": " 75 mg PO daily; for PCI, 300–600 mg PO once, then 75 mg daily for 1–12 months."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Ticagrelor:"
     },
     {
      "type": "text",
      "text": " for PCI, 180 mg PO once before the procedure, then 90 mg BID for 1–12 months."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Morphine and fentanyl may attenuate the activity of some P2Y12 inhibitors and may contribute to worse outcomes."
     }
    ]
   }
  ]
 },
