    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "CT enterography:"
     },
     {
      "type": "text",
      "text": " its unique advantage is identifying inflammatory bowel disease"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
