      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "CT urography:"
     },
     {
      "type": "text",
      "text": " IV contrast is excreted into the collecting system, ureters and bladder, outlining the whole urinary tract"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
