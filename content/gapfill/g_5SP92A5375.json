      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Special studies"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
