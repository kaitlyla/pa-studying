         "hex": "FF0000"
        }
       }
      ],
      "text": "Disc herniation effacing nerve root or thecal sac"
     },
     {
      "type": "text",
      "text": " with saddle anesthesia / retention → cauda equina syndrome"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 6,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": null
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Aspects (abnormal in red)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Spine:"
     },
     {
      "type": "text",
      "text": " cord compression, "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "cauda equina, disc herniation"
     },
     {
      "type": "text",
      "text": ", spondylodiscitis"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "If symptoms suggest cauda equina syndrome, MRI should be done immediately if available; if MRI is unavailable, CT myelography should be done"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Cauda equina syndrome is not a spinal cord syndrome, but it mimics conus medullaris syndrome, causing similar symptoms"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Unlike subacute or chronic spinal cord injury, "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "muscle tone and deep tendon reflexes are decreased in the legs"
     },
     {
      "type": "text",
      "text": "; a severe acute cord injury can initially decrease or abolish them too (spinal shock), making the two hard to distinguish soon after injury"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 6,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": null
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Causes"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Mechanism:"
     },
     {
      "type": "text",
      "text": " 2 or more of the 18 nerve roots caudal to the conus medullaris are compressed or damaged, disrupting motor and sensory pathways to the lower extremities and bladder"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Most commonly a herniated disc in the lumbar spine; others include congenital anomalies (eg, spina bifida), spinal cord infection, spinal epidural abscess, spinal cord tumor, spinal cord trauma, spinal stenosis (rarely), arteriovenous malformation and complications after spinal surgery; many of these cause swelling that contributes to nerve compression"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 6,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": null
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Symptoms"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Bilateral leg weakness in muscles supplied by L3 through S1, sensory loss in the affected roots' distribution (often the "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "saddle area"
     },
     {
      "type": "text",
      "text": "), and bladder, bowel and pudendal dysfunction (eg, "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "urinary retention"
     },
     {
      "type": "text",
      "text": ", urinary frequency, urinary or fecal incontinence, erectile dysfunction, "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "loss of rectal tone"
     },
     {
      "type": "text",
      "text": ", abnormal bulbocavernosus and anal wink reflexes)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Without treatment, cauda equina syndrome can cause complete paralysis of the lower extremities"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 6,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": null
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Treatment and next step"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Her chart:"
     },
     {
      "type": "text",
      "text": " emergent decompression"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "If it causes sphincter dysfunction (eg, urine retention or incontinence) and/or lower extremity weakness, immediate surgery (eg, discectomy, laminectomy) is required"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Analgesics as needed; if nonopioid analgesics do not relieve symptoms, corticosteroids can be given systemically or as an epidural injection, though analgesia tends to be modest and temporary; corticosteroids can also reduce swelling"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Patients with symptoms of cauda equina syndrome (eg, lower extremity weakness as well as urinary retention, frequency or incontinence) require immediate surgical decompression"
     }
    ]
   }
  ]
 },
