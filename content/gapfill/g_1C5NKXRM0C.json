     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Ultrasound"
     },
     {
      "type": "text",
      "text": " for suspected biliary disease, ectopic pregnancy (transvaginal) or appendicitis in children."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
