       {
        "type": "bold"
       }
      ],
      "text": "Noncontrast helical CT"
     },
     {
      "type": "text",
      "text": " for suspected renal stones."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
