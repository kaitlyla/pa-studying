    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "CT with oral and IV contrast"
     },
     {
      "type": "text",
      "text": " is diagnostic in about ≥ 95% of patients with significant abdominal pain, but imaging must not delay surgery when the signs are definitive."
     }
