       }
      ],
      "text": "Urine pregnancy test"
     },
     {
      "type": "text",
      "text": " in every woman of childbearing age; a negative result effectively rules out ruptured ectopic pregnancy."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
