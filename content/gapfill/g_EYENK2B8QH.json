    "content": [
     {
      "type": "text",
      "text": "MSM and TGW w a bact STI (syphilis, chlamydia or gonorrhea) in past 12 mo: counsel on doxy-PEP"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
