       }
      ],
      "text": "Abd:"
     },
     {
      "type": "text",
      "text": " examine umbilical cord & cord vessels"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
