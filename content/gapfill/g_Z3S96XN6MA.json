       }
      ],
      "text": "♡:"
     },
     {
      "type": "text",
      "text": " auscult rate · rhythm · ♡ sounds · murmurs - palpate femoral pulses"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
