    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "MSK:"
     },
     {
      "type": "text",
      "text": " note any deformities of back & spine - note any foot or arm/hand abnormalities - palpate clavicles for crepitus"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
