    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Genitalia/rectum:"
     },
     {
      "type": "text",
      "text": " determine testes descended - observe for penile anomalies or labial or vaginal anomalies - assess position & patency of anus"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
