      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "PO:"
     },
     {
      "type": "text",
      "text": " note clefts of lip or palate - note presence of natal teeth · Epstein pearls"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
