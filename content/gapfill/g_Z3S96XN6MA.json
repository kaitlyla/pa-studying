      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Nose:"
     },
     {
      "type": "text",
      "text": " observe for patency · septal deviation"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
