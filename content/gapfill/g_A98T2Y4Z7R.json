      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Rituximab 375 mg/m2 IV weekly for 4 weeks (response 57%; 21% still in remission at 5 years)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
