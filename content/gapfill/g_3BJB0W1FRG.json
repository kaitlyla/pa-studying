    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "If all results are normal,"
     },
     {
      "type": "text",
      "text": " extensive further testing (CT, MRI) is not recommended."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
