    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "One suggested panel"
     },
     {
      "type": "text",
      "text": " without focal findings: chest x-ray, urinalysis, CBC with differential, ESR or CRP, HIV test, chemistries (electrolytes, calcium, liver and kidney tests) and TSH."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
