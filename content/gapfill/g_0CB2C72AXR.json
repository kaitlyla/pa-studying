    "content": [
     {
      "type": "text",
      "text": "Buzzword: "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "apple-core lesion"
     },
     {
      "type": "text",
      "text": " (barium / CT colon) = colorectal carcinoma"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
