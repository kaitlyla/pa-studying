    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Must disclose:"
     },
     {
      "type": "text",
      "text": " reportable infections (e.g., HIV, syphilis, TB), child abuse (and adult/elder abuse in many states), and in some states driving-impairing conditions (dementia, seizures) to the DMV."
     }
