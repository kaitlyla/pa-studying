    },
    "content": [
     {
      "type": "text",
      "text": "A long QTc, caused mainly by a long ST segment."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
