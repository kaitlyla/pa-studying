    "content": [
     {
      "type": "text",
      "text": "First-line biologics for moderate to severe disease not controlled with topicals: dupilumab (age 6 and older) or tralokinumab (adults; targets the IL-13 receptor)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Both given subcutaneously. Dupilumab adverse effects: injection site reactions, eye inflammation (conjunctivitis, blepharitis, keratitis, dry eye), herpes simplex infections, eosinophilia. Tralokinumab: upper respiratory infections, conjunctivitis, injection site reactions, eosinophilia"
     }
    ]
   }
  ]
 },
