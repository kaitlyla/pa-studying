     {
      "type": "text",
      "text": "Combo antifungal-corticosteroid prod such as clotrimazole-betamethasone generally should be avoided"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
