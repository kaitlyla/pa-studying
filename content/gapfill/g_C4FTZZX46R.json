    "content": [
     {
      "type": "text",
      "text": "Tx most staphylococcal folliculitis w topical mupirocin or topical clindamycin"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "If empiric therapy fails or folliculitis recurs: Gram stain and cx pustules (gram-negative or MRSA) and cx the nare for nasal staphylococcal carriage"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Decolonization: topical mupirocin w chlorhexidine gluconate or dilute bleach baths; often effective but often only temporarily"
     }
    ]
   }
  ]
 },
