       {
        "type": "bold"
       }
      ],
      "text": "Nitroprusside:"
     },
     {
      "type": "text",
      "text": " usually 0.5–10 mcg/kg/min IV; never more than 10 min at the maximum rate, and stop if BP isn't controlled by then. Only where BP can be monitored continuously."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "> 2 mcg/kg/min can accumulate cyanide (agitation, seizures, cardiac instability, anion-gap metabolic acidosis). Prolonged use (> 1 wk; 3–6 d with renal insufficiency) accumulates thiocyanate (lethargy, tremor, abdominal pain, vomiting): check levels daily after 3 d and stop if > 12 mg/dL."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Hydralazine:"
     },
     {
      "type": "text",
      "text": " CBC and ANA titer before and periodically during prolonged therapy, and if arthralgia, fever, chest pain or malaise develop. A lupus-like picture means stopping it unless the benefit clearly requires continuing."
     }
    ]
   }
  ]
 },
