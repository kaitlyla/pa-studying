    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Microhematuria, high risk"
     },
     {
      "type": "text",
      "text": " (men older than 60, more than 25 RBC/hpf, more than 30 pack-years): cystoscopy and upper tract CT or MRI."
     }
