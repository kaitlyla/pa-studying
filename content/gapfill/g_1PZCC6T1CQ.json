      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Possible epiglottitis:"
     },
     {
      "type": "text",
      "text": " examine a child's pharynx only in the operating room."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
