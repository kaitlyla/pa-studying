     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Group A strep in children:"
     },
     {
      "type": "text",
      "text": " rapid antigen test in the office; if negative, send a throat culture."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
