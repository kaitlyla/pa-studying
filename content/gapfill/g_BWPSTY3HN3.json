       }
      ],
      "text": "Role in JIA:"
     },
     {
      "type": "text",
      "text": " NSAIDs ↓Sx but don't alter long-term joint disease or prevent complications; most useful for enthesitis; naproxen, ibuprofen and indomethacin are among the most useful."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Peds dose:"
     },
     {
      "type": "text",
      "text": " Ibuprofen 5–10 mg/kg PO q6–8h; max 400 mg/dose or 40 mg/kg/day."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
