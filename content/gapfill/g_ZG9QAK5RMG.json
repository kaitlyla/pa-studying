       }
      ],
      "text": "Dicyclomine:"
     },
     {
      "type": "text",
      "text": " start 20 mg four times a day; after one week it may be raised to 40 mg four times a day unless side effects limit it."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Contraindications include infants under 6 months, unstable cardiovascular status in acute hemorrhage, myasthenia gravis, glaucoma, obstructive uropathy, obstructive GI disease and severe ulcerative colitis."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "In hot environments heat prostration (fever, heat stroke from decreased sweating) can occur; if symptoms occur, stop the drug."
     }
    ]
   }
  ]
 },
