      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "On echo (her chart):"
     },
     {
      "type": "text",
      "text": " "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "RV dilate, septal flattening, McConnell sign (apical sparing)"
     },
     {
      "type": "text",
      "text": " → acute PE w RV strain"
     }
    ]
   },
   {
    "type": "paragraph",
