     }
    },
    "content": [
     {
      "type": "text",
      "text": "Echo = most commonly used for risk stratification; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "RV dilate and hypokinesis"
     },
     {
      "type": "text",
      "text": " may suggest the need for more aggressive therapy"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
