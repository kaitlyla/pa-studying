     {
      "type": "text",
      "text": " impaired RV funct causing "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "hypotension: systol BP < 90 mm Hg or a drop of ≥ 40 mm Hg from baseline for 15 minutes"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
