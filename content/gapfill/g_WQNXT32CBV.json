        }
       }
      ],
      "text": "RV strain, septal flattening, RV/LV ratio >1"
     },
     {
      "type": "text",
      "text": " → massive / submassive PE"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
