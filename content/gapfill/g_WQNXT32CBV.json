    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Intermed risk (submassive):"
     },
     {
      "type": "text",
      "text": " impaired RV funct "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "w.o hypotension"
     },
     {
      "type": "text",
      "text": ": RV enlrg and/or hypokinesis on imaging plus ↑biomarkers (eg, troponin, BNP)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
