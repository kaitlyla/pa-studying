    },
    "content": [
     {
      "type": "text",
      "text": "Accompanies 15–20% of STEMIs, USU w I. or lat infarct; isolated posterior MI (5–10%) = often missed b/c there = ⍉ST elevation"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
