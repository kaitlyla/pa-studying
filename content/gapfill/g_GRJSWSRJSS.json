     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Estrogen:"
     },
     {
      "type": "text",
      "text": " USU needed to initiate puberty; generally started @ 11–12 y after ↑FSH on ≥ 2 occasions; 17β-estradiol preferred; transdermal route preferred when feasible; then estrogen/progestin contraceptives maintain 2/2 sexual characteristics."
     }
    ]
   }
