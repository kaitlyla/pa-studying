     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Deutetrabenazine, another VMAT2 inhibitor, is also approved for tardive dyskinesia."
     }
    ]
   }
  ]
 },
