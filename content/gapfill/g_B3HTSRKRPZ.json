     }
    },
    "content": [
     {
      "type": "text",
      "text": "Erythema migrans: doxycycline 100 mg PO twice a day for 10-14 days. Children: 4.4 mg/kg/day PO in 2 doses (max 100 mg/dose). Amoxicillin or cefuroxime for 14 days are the equal alternatives."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Where different durations work, the shorter one is preferred (fewer adverse effects, including infectious diarrhea, and less resistance)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Facial palsy: doxycycline for 14-21 days, adults and children of any age. Meningitis or radiculoneuritis: doxycycline 200 mg/day PO (in 1 or 2 doses) or IV ceftriaxone, 14-21 days."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Mild carditis (1st-degree AV block, PR <300 ms): doxycycline, amoxicillin or cefuroxime PO for 14-21 days."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Arthritis: doxycycline, amoxicillin or cefuroxime PO for 28 days. Children under 8: amoxicillin or cefuroxime only."
     }
    ]
   }
  ]
 },
