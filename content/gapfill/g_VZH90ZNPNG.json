      ],
      "text": "sudden HA"
     },
     {
      "type": "text",
      "text": ", often during activity (it may be mild or ⍉in older adults); LOC = common, often w.in seconds or a few minutes; N/V, delirium and focal or gen seizures are also common"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
