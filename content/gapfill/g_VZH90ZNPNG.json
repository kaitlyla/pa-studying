     }
    },
    "content": [
     {
      "type": "text",
      "text": "Neuro deficits are USU sudden and progress; lrg hemorrhages in the hemispheres cause "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
