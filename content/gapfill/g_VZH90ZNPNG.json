     }
    },
    "content": [
     {
      "type": "text",
      "text": "Essential supportive care may incl "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "reversing anticoagulation and lowering BP to 140 mm Hg"
     },
     {
      "type": "text",
      "text": " if systol BP = b/n 150 and 220 mm Hg; if > 220 mm Hg, consider aggressive reduction w cont IV nicardipine"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
