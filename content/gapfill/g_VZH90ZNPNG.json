     }
    },
    "content": [
     {
      "type": "text",
      "text": "⍉BP fluctuations, and maintain systol BP < 140 mm Hg, but ⍉lower than 130 mm Hg"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
