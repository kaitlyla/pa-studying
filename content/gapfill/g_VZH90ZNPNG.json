      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Cocaine or, occasionally, other sympathomimetic drugs can cause transient severe HTN leading to hemorrhage"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
