     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "aVR:"
     },
     {
      "type": "text",
      "text": " "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "terminal R wave > 3 mm or R/S ratio > 0.7"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
