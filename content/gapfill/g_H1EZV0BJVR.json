         "hex": "FF0000"
        }
       }
      ],
      "text": "sinus tachycardia"
     },
     {
      "type": "text",
      "text": " (usual; muscarinic M1 receptor blockade)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
