     "marker": null
    },
    "content": [
     {
      "type": "text",
      "text": "Sinus tachycardia, a widened QRS, and a dominant terminal R wave in aVR."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
