    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Chest CT, possibly bronchoscopy"
     },
     {
      "type": "text",
      "text": " when lung CA or another bronchial tumor = sus (long smoke Hx, constitutional signs) or empiric therapy has failed w inconclusive tests."
     }
