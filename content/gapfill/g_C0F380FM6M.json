     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Pulse oximetry and CXR"
     },
     {
      "type": "text",
      "text": " w red flag dyspnea or hemoptysis, or when sus of PNA or other parenchymal lung dz = ↑."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
