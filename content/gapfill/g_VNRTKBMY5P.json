     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Acute nasal Sx: USU ⍉testing,"
     },
     {
      "type": "text",
      "text": " unless invasive sinusitis = sus in a diabetic or immunocompromised pt (CT, bx and histopathology for fungal hyphae)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
