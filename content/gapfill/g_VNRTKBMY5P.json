      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Chronic or seasonal symptoms:"
     },
     {
      "type": "text",
      "text": " allergy testing (skin testing or allergen-specific IgE)."
     }
    ]
   },
   {
