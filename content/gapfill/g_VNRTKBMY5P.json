    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Acute nasal symptoms: usually no testing,"
     },
     {
      "type": "text",
      "text": " unless invasive sinusitis is suspected in a diabetic or immunocompromised patient (CT, biopsy and histopathology for fungal hyphae)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
