     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "POCUS or echocardiography"
     },
     {
      "type": "text",
      "text": " in unstable patients, to look for ventricular dysfunction, valve disease, effusion or tamponade."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
