      ],
      "text": "First:"
     },
     {
      "type": "text",
      "text": " pulse oximetry, ECG and chest x-ray in most patients."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
