      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Caution:"
     },
     {
      "type": "text",
      "text": " tinidazole: ↑ warfarin effect; ⍉studied in liver dz (use w caution, if @ all)."
     }
    ]
   }
