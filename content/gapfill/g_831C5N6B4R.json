      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "OD:"
     },
     {
      "type": "text",
      "text": " the ½ life = under 10 s, so SE are generally rapidly self-limiting; tx any prolonged effect directly."
     }
    ]
   }
