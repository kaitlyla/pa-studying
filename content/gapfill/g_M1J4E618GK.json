       }
      ],
      "text": "Dose after MI:"
     },
     {
      "type": "text",
      "text": " metoprolol tartrate 50 mg PO every 6 hrs in hemodynamically stable pts (25 mg every 6 hrs for 48 hrs if ⍉tolerated), titrated to HR and BP."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
