       }
      ],
      "text": "Viscous lidocaine (adults):"
     },
     {
      "type": "text",
      "text": " 15 mL undiluted; swish & spit out for the mouth, gargle (may be swallowed) for the pharynx; ⍉more often than every 3 hrs, & ⍉more than 8 doses in 24 hrs"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
