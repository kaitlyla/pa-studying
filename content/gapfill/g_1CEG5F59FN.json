    "content": [
     {
      "type": "text",
      "text": "poss NMS has been reported w dose reduction or w.draw, so observe carefully, esp w neuroleptics."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
