     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "PEG-electrolyte (GoLYTELY) CI:"
     },
     {
      "type": "text",
      "text": " GI obstruction, bowel perforation, toxic colitis or toxic megacolon, gastric retention, ileus."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
