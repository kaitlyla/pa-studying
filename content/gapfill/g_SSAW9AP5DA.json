      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Aspiration risk:"
     },
     {
      "type": "text",
      "text": " caution with impaired gag reflex, unconscious or semiconscious pts, or pts prone to regurgitation; observe during administration, esp. via NG tube."
     }
