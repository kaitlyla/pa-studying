      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Fitusiran (lowers antithrombin), concizumab (anti-TFPI) and marstacimab (anti-TFPI) for hemophilia A and B; concizumab also w inhibitors."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
