    "content": [
     {
      "type": "text",
      "text": "Emicizumab (bispecific Ab that replaces factor VIII funct) for hemophilia A, subcutaneously every 1, 2 or 4 wks."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
