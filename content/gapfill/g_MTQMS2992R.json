       }
      ],
      "text": "Alosetron:"
     },
     {
      "type": "text",
      "text": " start 0.5 mg twice a day; if well tolerated but not controlling symptoms after 4 weeks, it can go up to 1 mg twice a day; stop if not controlled after 4 weeks on 1 mg twice a day."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Boxed warning:"
     },
     {
      "type": "text",
      "text": " serious GI reactions, including ischemic colitis and serious complications of constipation, have led to hospitalization and, rarely, transfusion, surgery and death; stop it immediately if constipation or signs of ischemic colitis develop, and don't restart it after ischemic colitis."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Contraindicated with fluvoxamine, a strong CYP1A2 inhibitor that raises alosetron AUC about 6-fold."
     }
    ]
   }
  ]
