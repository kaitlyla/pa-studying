      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Sus stone:"
     },
     {
      "type": "text",
      "text": " UA and USU imaging."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
