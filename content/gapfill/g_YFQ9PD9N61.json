    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Don't miss a dissecting aortic aneurysm"
     },
     {
      "type": "text",
      "text": ", esp in older pts: renal a. involvement can cause hematuria and ureteral-type pain."
     }
    ]
   },
