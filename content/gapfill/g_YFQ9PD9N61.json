      ],
      "text": "UA first"
     },
     {
      "type": "text",
      "text": " to tell true hematuria from red urine."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
