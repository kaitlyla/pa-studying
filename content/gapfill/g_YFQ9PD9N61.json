      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Noncontrast CT"
     },
     {
      "type": "text",
      "text": " = the preferred first imaging in most pts: it shows the stone's location, the degree of obstruct, and other Eti such as aortic aneurysm."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
