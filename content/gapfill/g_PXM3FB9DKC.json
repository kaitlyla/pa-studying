       }
      ],
      "text": "Screen alone:"
     },
     {
      "type": "text",
      "text": " ask when the patient is alone; the partner and anyone else with her can be asked to step away."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
