    "content": [
     {
      "type": "text",
      "text": "Consider corticosteroids to accelerate fetal lung maturity if gestational age is <34 wk; also later in some cases if none were given before 34 wk"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Betamethasone 12 mg IM q24h × 2 doses (or dexamethasone 6 mg IM q12h × 4 doses)"
     }
    ]
   }
  ]
 },
