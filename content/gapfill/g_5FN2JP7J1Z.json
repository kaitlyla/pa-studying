       "shade": null,
       "borders": null,
       "marker": null
      },
      "content": [
       {
        "type": "text",
        "text": "Merck splits men by age: ≥ 2 mm @ 40 or older and ≥ 2.5 mm under 40; 1.5 mm for women of all ages."
       }
      ]
     }
    ]
   }
