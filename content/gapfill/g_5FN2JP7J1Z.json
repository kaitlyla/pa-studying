      },
      "content": [
       {
        "type": "text",
        "text": "Your EKG notes give V2–V3 thresholds of ≥ 2 mm for men and ≥ 1.5 mm for women."
       }
      ]
     },
     {
      "type": "paragraph",
      "attrs": {
       "indLeft": 0,
       "indRight": 0,
       "indFirst": 0,
       "spaceBefore": 0,
       "spaceAfter": 0,
       "line": null,
       "align": "left",
       "shade": null,
       "borders": null,
       "marker": null
      },
      "content": [
       {
        "type": "text",
        "text": "Merck splits men by age: ≥ 2 mm at 40 or older and ≥ 2.5 mm under 40; 1.5 mm for women of all ages."
       }
      ]
     }
    ]
   }
  },
