        "text": "Your EKG notes give V2–V3 thresholds of ≥ 2 mm for men and ≥ 1.5 mm for women."
       }
      ]
     },
     {
      "type": "paragraph",
      "attrs": {
       "indLeft": 0,
       "indRight": 0,
       "indFirst": 0,
       "spaceBefore": 0,
