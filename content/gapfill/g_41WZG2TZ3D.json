      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "A rare, severe disease, often with "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "dark brown or red currant-jelly sputum"
     },
     {
      "type": "text",
      "text": ", lung abscess formation and empyema"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
