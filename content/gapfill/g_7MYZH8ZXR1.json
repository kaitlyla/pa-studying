      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Inconclusive:"
     },
     {
      "type": "text",
      "text": " Trichomonas NAAT, or cx for fungi or trichomonads. A Pap test = ⍉reliable for vaginitis."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
