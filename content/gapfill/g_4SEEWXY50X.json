      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Mental status exam:"
     },
     {
      "type": "text",
      "text": " speech (rate, vol, articulation, coherence, spontaneity); thought processes (rate, content, abstract reasoning, computation); associations; abnorm or psychotic thoughts (hallucinations, delusions, preoccupation w violence, homicidal or suicidal ideation, obsessions); judgment and insight; orientation; recent and remote memory; attention and concentration; language; fund of knowledge; mood and affect."
     }
    ]
   }
