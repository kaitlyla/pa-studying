     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Social history:"
     },
     {
      "type": "text",
      "text": " social service records (interviews with the patient, family and others) assess home plans, family attitudes and community resource contacts, and include a social history."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
