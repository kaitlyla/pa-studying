     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Psychiatric evaluation:"
     },
     {
      "type": "text",
      "text": " a medical history, a record of mental status, the onset of illness and circumstances leading to admission, attitudes and behavior, estimates of intellectual functioning, memory and orientation, and an inventory of the patient's assets written descriptively, not interpretively."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Mental status exam:"
     },
     {
      "type": "text",
      "text": " speech (rate, volume, articulation, coherence, spontaneity); thought processes (rate, content, abstract reasoning, computation); associations; abnormal or psychotic thoughts (hallucinations, delusions, preoccupation with violence, homicidal or suicidal ideation, obsessions); judgment and insight; orientation; recent and remote memory; attention and concentration; language; fund of knowledge; mood and affect."
     }
    ]
   }
  ]
