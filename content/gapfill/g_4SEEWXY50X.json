       }
      ],
      "text": "Admitting dx:"
     },
     {
      "type": "text",
      "text": " a provisional or admitting dx @ admission, incl intercurrent (medical) diseases as well as psychiatric diagnoses."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
