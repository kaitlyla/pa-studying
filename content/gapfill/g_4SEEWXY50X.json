       {
        "type": "bold"
       }
      ],
      "text": "Psychiatric eval:"
     },
     {
      "type": "text",
      "text": " a medical Hx, a record of mental status, the onset of illness and circumstances leading to admission, attitudes and behavior, estimates of intellectual functioning, memory and orientation, and an inventory of the pt's assets written descriptively, ⍉interpretively."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
