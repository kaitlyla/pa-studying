       {
        "type": "bold"
       }
      ],
      "text": "Neuro exam:"
     },
     {
      "type": "text",
      "text": " when indicated, a complete neurological exam = recorded w the admission physical."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
