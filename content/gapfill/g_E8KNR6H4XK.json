      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Overdose:"
     },
     {
      "type": "text",
      "text": " the half-life is under 10 s, so adverse effects are generally rapidly self-limiting; treat any prolonged effect directly."
     }
    ]
   }
  ]
