    "content": [
     {
      "type": "text",
      "text": "Local heat, oral or topical NSAIDs, capsaicin cream and lidocaine patches are first-line therapies."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Capsaicin, diclofenac gel and lidocaine patches are recommended mainly from experience w other inflam MSK conditions; ⍉high-quality studies have examined any costochondritis tx."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Corticosteroid inj has inadeq evidence for costochondritis and = considered only when Sx don't improve w traditional therapies."
     }
    ]
   }
  ]
 },
