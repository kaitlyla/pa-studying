     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Not automatically abuse:"
     },
     {
      "type": "text",
      "text": " that notification does not by itself define child abuse under federal law or require prosecution."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
