    "content": [
     {
      "type": "text",
      "text": "One or a few superficial lesions: intralesional vinblastine or interferon alfa"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Advanced HIV with limited skin disease: intralesional vinblastine or bleomycin can be added; pomalidomide for more indolent lesions"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Extensive or visceral disease: pegylated liposomal doxorubicin 20 mg/m2 IV every 2 to 3 weeks; paclitaxel is an alternative first-line choice or used if it fails"
     }
    ]
   }
  ]
 },
