       }
      ],
      "text": "Mechanism:"
     },
     {
      "type": "text",
      "text": " electrical signals are wrongly recognized as native cardiac activity, so pacing is inhibited"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
