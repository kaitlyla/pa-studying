      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Output failure:"
     },
     {
      "type": "text",
      "text": " no paced stimulus is generated when one is expected"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
