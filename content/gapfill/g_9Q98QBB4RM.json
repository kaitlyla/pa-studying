         "hex": "FF0000"
        }
       }
      ],
      "text": "Trach deviation TOWARD white-out"
     },
     {
      "type": "text",
      "text": " → atelectasis / pneumonectomy / mucous plug"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 6,
     "spaceAfter": 0,
