    },
    "content": [
     {
      "type": "text",
      "text": "Three or more consecutive PVCs at a rate over 100, with a wide QRS (> 0.12 sec)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 6,
