     }
    },
    "content": [
     {
      "type": "text",
      "text": "Give anticoagulants when PE = diagnosed or strongly sus (anticoagulation improves survival)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
