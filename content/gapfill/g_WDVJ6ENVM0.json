     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Most specific:"
     },
     {
      "type": "text",
      "text": " "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "simultaneous T inversions in the inferior (II, III, aVF) and right precordial (V1–4) leads"
     },
     {
      "type": "text",
      "text": " — specificity up to 99% in one study"
     }
    ]
   },
