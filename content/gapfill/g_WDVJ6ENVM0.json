        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "inversions in V1–V4"
     },
     {
      "type": "text",
      "text": ", ± the inferior leads (II, III, aVF); linked to high pulmonary artery pressures (34%)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
