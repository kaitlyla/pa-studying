     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Many emboli are sm, physiologically insignificant, and aSx"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
