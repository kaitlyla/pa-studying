      ],
      "text": "Dx:"
     },
     {
      "type": "text",
      "text": " CTA = the preferred imaging test"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
