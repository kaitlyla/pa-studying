    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "What it =:"
     },
     {
      "type": "text",
      "text": " thrombi, typically from the lrg veins of the legs or pelvis, occluding the pulm arteries; RF impair venous return, injure the endothelium, or make blood hypercoag"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
