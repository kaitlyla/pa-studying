     }
    },
    "content": [
     {
      "type": "text",
      "text": "MC signs: tachy and tachypnea"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
