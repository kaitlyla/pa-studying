     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "⍉unique to PE:"
     },
     {
      "type": "text",
      "text": " a similar spectrum of chgs may be seen w any cause of acute or chronic cor pulmonale"
     }
    ]
   },
