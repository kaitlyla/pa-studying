    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "ECG mech:"
     },
     {
      "type": "text",
      "text": " Rt atrial and ventricular dilate (shifting the ♡), RV ischemia, and sympathetic stim from pain, anxiety and hypoxia"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
