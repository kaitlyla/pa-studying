     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Bili > 10 mg/dL (preterm) or > 18 mg/dL (term):"
     },
     {
      "type": "text",
      "text": " HCT, smear, retic count, direct Coombs, total and direct bili, and blood type and Rh of infant and mother."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Blood, urine and CSF cx and RBC enzyme levels"
     },
     {
      "type": "text",
      "text": " as Hx and exam suggest, and for any initial bili > 25 mg/dL."
     }
    ]
   }
