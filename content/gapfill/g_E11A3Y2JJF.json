       {
        "type": "bold"
       }
      ],
      "text": "Serum bili"
     },
     {
      "type": "text",
      "text": " confirms jaundice; transcutaneous and photo-based measurements correlate well w it."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
