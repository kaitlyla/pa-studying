        }
       }
      ],
      "text": "Carotid stenosis >50% by Doppler velocities"
     },
     {
      "type": "text",
      "text": " → Sxtomatic carotid dz"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 6,
