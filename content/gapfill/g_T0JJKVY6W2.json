    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Anaphylaxis:"
     },
     {
      "type": "text",
      "text": " H1 blocker (eg, diphenhydramine) every 6 h until symptoms resolve. Onset one to two hours; improves erythema and pruritus but not shown to reverse upper airway obstruction or improve hypotension."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Diphenhydramine injection (adults):"
     },
     {
      "type": "text",
      "text": " 10–50 mg IV at ≤ 25 mg/min or deep IM; 100 mg if required; max 400 mg/day."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Injection CI:"
     },
     {
      "type": "text",
      "text": " nursing mothers (higher risk for infants, esp. neonates and prematures); not for use as a local anesthetic (local necrosis)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "MAOIs prolong and intensify its anticholinergic (drying) effects."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Overdose:"
     },
     {
      "type": "text",
      "text": " CNS depression or stimulation (stimulation esp. in children); atropine-like signs (dry mouth, fixed dilated pupils, flushing, GI symptoms); can cause hallucinations, convulsions or death."
     }
    ]
   }
  ]
 },
