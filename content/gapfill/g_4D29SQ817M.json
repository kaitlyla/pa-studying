    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "U waves:"
     },
     {
      "type": "text",
      "text": " incl lrg U waves (> 1 mm) fused to the T wave; exclude smaller U waves and those separate from the T wave"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
