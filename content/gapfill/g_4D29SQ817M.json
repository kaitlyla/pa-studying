     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Which lead and beat:"
     },
     {
      "type": "text",
      "text": " USU II or V5–6, but use the lead w the longest measurement; measure several successive beats and take the max"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
