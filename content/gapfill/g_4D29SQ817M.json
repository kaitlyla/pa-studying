      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "QTc:"
     },
     {
      "type": "text",
      "text": " norm < 440 ms (men), < 460 ms (women)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
