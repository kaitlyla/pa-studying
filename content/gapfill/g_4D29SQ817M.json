      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Where to measure:"
     },
     {
      "type": "text",
      "text": " lead II or V5, ideally where T waves are most distinct"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
