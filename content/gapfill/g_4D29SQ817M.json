     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Poisoning:"
     },
     {
      "type": "text",
      "text": " w QT-prolonging agents, torsades risk = better described by the absolute (⍉corrected) QT together w the HR on the same tracing, plotted on the QT nomogram"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 6,
