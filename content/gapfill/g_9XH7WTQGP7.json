      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Expected emotions:"
     },
     {
      "type": "text",
      "text": " can swing like a roller coaster, from excitement and happiness to fear, anger, and tantrums."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
