     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Type and cross-match"
     },
     {
      "type": "text",
      "text": " if bleeding is ongoing; repeat hemoglobin and hematocrit up to every 6 hours in severe bleeding."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Nasogastric aspiration and lavage"
     },
     {
      "type": "text",
      "text": " for suspected upper GI bleeding; up to 15% of upper bleeds have no blood in the aspirate."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Upper endoscopy"
     },
     {
      "type": "text",
      "text": " for upper GI bleeding: rapidly if significant, deferrable 24 hours if bleeding stops or is minimal."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
