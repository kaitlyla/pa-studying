      "text": "CBC;"
     },
     {
      "type": "text",
      "text": " with significant bleeding add coagulation studies (platelets, PT, PTT) and liver tests."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
