     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Colonoscopy"
     },
     {
      "type": "text",
      "text": " for hematochezia (anoscopy and flexible sigmoidoscopy may suffice for typical hemorrhoidal bleeding)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
