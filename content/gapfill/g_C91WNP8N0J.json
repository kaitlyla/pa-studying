       }
      ],
      "text": "Who reports:"
     },
     {
      "type": "text",
      "text": " the provider, the lab, or both; ask the health department if unsure. Reports are kept confidential."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
