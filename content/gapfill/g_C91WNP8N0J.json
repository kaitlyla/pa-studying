       {
        "type": "bold"
       }
      ],
      "text": "EPT:"
     },
     {
      "type": "text",
      "text": " giving the patient prescriptions or medication for her partners without examining the partners."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
