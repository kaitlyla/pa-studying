      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Caution:"
     },
     {
      "type": "text",
      "text": " hypersensitivity MC (rash common; anaphylaxis rare); C. diff; leukopenia, thrombocytopenia; (+) Coombs."
     }
    ]
   }
