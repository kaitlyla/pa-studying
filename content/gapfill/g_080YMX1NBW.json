       }
      ],
      "text": "Peds dose:"
     },
     {
      "type": "text",
      "text": " 29 days–2 y: 15 mg/kg q6h, max 60 mg/kg/day; 2–12 y: 12.5 mg/kg q4h or 15 mg/kg q6h; max single dose 15 mg/kg, max 75 mg/kg/day."
     }
    ]
