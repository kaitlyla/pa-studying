    },
    "content": [
     {
      "type": "text",
      "text": "Linezolid was effective for vancomycin-resistant E faecium IE."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
