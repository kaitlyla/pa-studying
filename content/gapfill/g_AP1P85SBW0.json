    "content": [
     {
      "type": "text",
      "text": "N-acetylcysteine treats acetaminophen toxicity and is also recommended by professional societies for other causes of acute liver failure (evidence less definitive)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Mannitol 0.5-1 g/kg (repeat once or twice as needed) temporarily lowers cerebral blood flow; contraindicated with acute kidney injury; check serum osmolality before a second dose."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Lactulose and rifaximin haven't been shown to help encephalopathy in acute liver failure."
     }
    ]
   }
  ]
 },
