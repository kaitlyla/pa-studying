     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Diascopy:"
     },
     {
      "type": "text",
      "text": " press a slide on the lesion; hemorrhagic lesions don't blanch, inflammatory and vascular lesions do."
     }
    ]
   }
