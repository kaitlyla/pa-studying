     }
    },
    "content": [
     {
      "type": "text",
      "text": "Recurr calcium stones: thiazide, potassium citrate or allopurinol."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
