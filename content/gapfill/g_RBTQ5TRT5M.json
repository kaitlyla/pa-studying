     }
    },
    "content": [
     {
      "type": "text",
      "text": "Uric acid stones: raise urine pH to 6-6.5 w an oral K-containing alkalinizer (eg, potassium citrate) + fluids."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
