      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "The vas deferens is isolated, cut and occluded (ligation or fulguration)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
