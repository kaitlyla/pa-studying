    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Complications:"
     },
     {
      "type": "text",
      "text": " hematoma, infection, sperm granuloma, chronic post-vasectomy pain syndrome (~1–2%)."
     }
    ]
