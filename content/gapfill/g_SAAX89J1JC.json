    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Severe serotonin syndrome:"
     },
     {
      "type": "text",
      "text": " electrolytes, platelet count, renal function, CK, coagulation panel, urine myoglobin."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
