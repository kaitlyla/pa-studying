       }
      ],
      "text": "EEG"
     },
     {
      "type": "text",
      "text": " to exclude nonconvulsive status epilepticus."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
