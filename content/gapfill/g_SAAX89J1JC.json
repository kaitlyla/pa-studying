      ],
      "text": "NMS has no confirmatory test;"
     },
     {
      "type": "text",
      "text": " check for complications: electrolytes, BUN, creatinine, glucose, calcium, magnesium, CK and urine myoglobin."
     }
    ]
   },
   {
