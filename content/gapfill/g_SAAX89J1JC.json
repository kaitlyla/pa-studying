       }
      ],
      "text": "Neuroimaging and CSF analysis"
     },
     {
      "type": "text",
      "text": " are usually done as well."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
