    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Favors serotonin syndrome over NMS:"
     },
     {
      "type": "text",
      "text": " a serotonergic drug, onset within 24 hours, and hyperreflexia."
     }
