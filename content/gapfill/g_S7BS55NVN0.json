     {
      "type": "text",
      "text": "Mainstay of therapy; start during the prodrome if poss"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
