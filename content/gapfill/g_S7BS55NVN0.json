      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Apply several times a day for about 2 wks; monitor for oral candidiasis"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Cont or severe RAS (oral medicine specialist): intralesional betamethasone, dexamethasone or triamcinolone, or prolonged systemic glucocorticoids, azathioprine, pentoxifylline or thalidomide"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
