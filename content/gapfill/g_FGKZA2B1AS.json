     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "ST segment:"
     },
     {
      "type": "text",
      "text": " no ECG criteria can safely tell it apart from STEMI in the ED; if in doubt, activate the STEMI protocol"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
