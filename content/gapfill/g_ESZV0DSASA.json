     }
    },
    "content": [
     {
      "type": "text",
      "text": "IG dose: IM 0.5 mL/kg (max 15 mL); IV 400 mg/kg"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
