      "type": "text",
      "text": "Suscep contacts: MMR vax w.in 3 days unless contraindicated; otherwise immune globulin w.in 6 days"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
