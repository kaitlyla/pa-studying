     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Bronchiolitis:"
     },
     {
      "type": "text",
      "text": " pulse oximetry; a chest X-ray only with hypoxemia or severe distress."
     }
