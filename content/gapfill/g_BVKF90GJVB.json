       {
        "type": "bold"
       }
      ],
      "text": "Pulse oximetry"
     },
     {
      "type": "text",
      "text": " for severity; a blood gas if the child is in distress or tiring."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
