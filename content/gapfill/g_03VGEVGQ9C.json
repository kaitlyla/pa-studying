    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Norm XR, consistent Hx, ⍉massive:"
     },
     {
      "type": "text",
      "text": " tx empirically for bronchitis; abnorm results or ⍉supporting Hx need CT and bronchoscopy."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
