      ],
      "text": "Massive hemoptysis:"
     },
     {
      "type": "text",
      "text": " tx and stabilize, USU in the ICU, b4 testing."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
