       }
      ],
      "text": "Hypertensive emergency:"
     },
     {
      "type": "text",
      "text": " clevidipine may be preferred over nitroprusside for most emergencies (caution in acute HFrEF); nicardipine suits most emergencies except acute heart failure, and is most often used postoperatively and in pregnancy."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "IV doses:"
     },
     {
      "type": "text",
      "text": " nicardipine start 5 mg/h, increase by 2.5 mg/h every 5–15 min to a max of 15 mg/h; clevidipine start 1–2 mg/h; most patients need ≤ 16 mg/h."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Clevidipine is contraindicated with soy or egg allergy, defective lipid metabolism, or severe aortic stenosis; nicardipine IV with advanced aortic stenosis."
     }
    ]
   }
  ]
 },
