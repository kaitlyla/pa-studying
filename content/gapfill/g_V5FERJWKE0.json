     }
    },
    "content": [
     {
      "type": "text",
      "text": "BBs: glucagon, IV lipid emulsion. CCBs: calcium, high-dose IV insulin w IV glucose, IV lipid emulsion."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
