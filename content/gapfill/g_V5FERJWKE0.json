      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "IV lipid emulsion (10% or 20%) and high-dose insulin used for several cardiac toxins (eg, bupivacaine, diltiazem, verapamil)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
