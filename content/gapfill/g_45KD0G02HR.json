      ],
      "text": "ABI:"
     },
     {
      "type": "text",
      "text": " ≤ 0.90 = diagnostic of PAD; 0.91 to 0.99 = borderline."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
