     }
    },
    "content": [
     {
      "type": "text",
      "text": "Mavacamten: echo assessments required b4 and during tx; available only thru a restricted program (REMS)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
