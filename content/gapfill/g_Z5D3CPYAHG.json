     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Motor:"
     },
     {
      "type": "text",
      "text": " holds head steady without support when you are holding her; holds a toy when you put it in his hand; uses her arm to swing at toys; brings hands to mouth; pushes up onto elbows/forearms when on tummy."
     }
