    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Social/emotional:"
     },
     {
      "type": "text",
      "text": " smiles on his own to get your attention; chuckles (not yet a full laugh) when you try to make her laugh; looks at you, moves, or makes sounds to get or keep your attention."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
