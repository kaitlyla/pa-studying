       {
        "type": "bold"
       }
      ],
      "text": "MSD:"
     },
     {
      "type": "text",
      "text": " routine LFT monitoring isn't necessary, and routine CK doesn't predict rhabdomyolysis; check muscle enzymes only if myalgias or other muscle symptoms develop. If symptoms don't subside within 1 to 2 weeks off the statin, look for another cause (eg, polymyalgia rheumatica)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Atorvastatin:"
     },
     {
      "type": "text",
      "text": " use with cyclosporine or gemfibrozil is not recommended; avoid more than 1.2 L/day of grapefruit juice."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
