     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Atorvastatin:"
     },
     {
      "type": "text",
      "text": " discontinue when pregnancy is recognized, or weigh the patient's ongoing need; breastfeeding not recommended."
     }
    ]
   }
