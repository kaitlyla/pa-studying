    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Recheck in 4 to 8 weeks;"
     },
     {
      "type": "text",
      "text": " a third recurrence or a persistent mass after aspiration needs biopsy."
