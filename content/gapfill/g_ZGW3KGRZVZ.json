      ],
      "text": "Breast ultrasound"
     },
     {
      "type": "text",
      "text": " first, to tell solid from cystic masses."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
