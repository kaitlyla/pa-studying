    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Cyst aspiration:"
     },
     {
      "type": "text",
      "text": " send fluid for cytology if it is turbid or grossly bloody, if little fluid is obtained, or if a mass remains."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
