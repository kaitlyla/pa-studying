     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Extraspinal causes:"
     },
     {
      "type": "text",
      "text": " eg, chest x-ray for pulmonary disorders, urinalysis for urinary tract disorders or back pain with no clear mechanical cause."
     }
    ]
   }
