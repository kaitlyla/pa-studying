       }
      ],
      "text": "Retic count"
     },
     {
      "type": "text",
      "text": " shows how well the marrow = compensating."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
