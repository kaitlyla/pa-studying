       {
        "type": "bold"
       }
      ],
      "text": "Benztropine:"
     },
     {
      "type": "text",
      "text": " usual 1 to 2 mg/day PO (range 0.5 to 6 mg); idiopathic parkinsonism may start @ 0.5 to 1 mg @ bedtime."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Benztropine may cause anhidrosis:"
     },
     {
      "type": "text",
      "text": " use caution in hot weather, esp w other atropine-like drugs or manual labor in heat. W phenothiazines, haloperidol or other anticholinergic or antidopaminergic drugs, report GI complaints, fever or heat intol promptly (paralytic ileus, hyperthermia and heat stroke have sometimes been fatal)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Anticholinergic intoxication:"
     },
     {
      "type": "text",
      "text": " physostigmine 1 to 2 mg SC or IV reportedly reverses Sx; otherwise tx = Sxtomatic and supportive."
     }
    ]
   }
  ]
 },
