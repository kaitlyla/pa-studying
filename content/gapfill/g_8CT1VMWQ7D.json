    },
    "content": [
     {
      "type": "text",
      "text": "HA = USU severe, "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "peaking w.in seconds"
     },
     {
      "type": "text",
      "text": "; pts often describe it as \"the worst headache in their life\"; LOC may follow, USU STAT but sometimes ⍉for several hrs"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
