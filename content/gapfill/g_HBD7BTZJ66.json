      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Pharynx:"
     },
     {
      "type": "text",
      "text": " nasopharynx, oropharynx and laryngopharynx."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
