       {
        "type": "bold"
       }
      ],
      "text": "Rt vs Lt:"
     },
     {
      "type": "text",
      "text": " the Rt lung = shorter and wider; the Lt occupies a smaller vol."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
