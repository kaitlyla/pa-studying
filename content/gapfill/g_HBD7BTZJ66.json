     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Larynx:"
     },
     {
      "type": "text",
      "text": " connects the pharynx to the trach; its three lrg cartilages are the thyroid cartilage (anterior), epiglottis (S.) and cricoid cartilage (inferior)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
