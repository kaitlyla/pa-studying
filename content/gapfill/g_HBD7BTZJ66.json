       {
        "type": "bold"
       }
      ],
      "text": "Cricoid:"
     },
     {
      "type": "text",
      "text": " the thick cricoid cartilage forms a ring."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
