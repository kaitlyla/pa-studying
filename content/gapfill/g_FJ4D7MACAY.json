     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Abscesses are found mainly by exam (focal tenderness, fluctuance); imaging can separate cellulitis from abscess (such as ultrasound) or from necrotizing infection (such as MRI)"
     }
    ]
   }
