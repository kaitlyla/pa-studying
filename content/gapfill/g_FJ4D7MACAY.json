     }
    },
    "content": [
     {
      "type": "text",
      "text": "Point-of-care ultrasound helps tell an abscess from cellulitis when the exam is unclear"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
