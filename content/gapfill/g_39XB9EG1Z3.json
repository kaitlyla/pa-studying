       {
        "type": "bold"
       }
      ],
      "text": "C – Cardiac:"
     },
     {
      "type": "text",
      "text": " cardiothoracic ratio < 50% on PA (< 60% on AP); contour; valves; pacemaker leads"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
