       {
        "type": "bold"
       }
      ],
      "text": "B – Bones / soft tissue:"
     },
     {
      "type": "text",
      "text": " look for "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "rib fractures, lytic lesions, rib notching, subQ air"
     },
     {
      "type": "text",
      "text": "; breast shadows"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
