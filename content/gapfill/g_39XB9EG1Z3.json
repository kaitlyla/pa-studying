       {
        "type": "bold"
       }
      ],
      "text": "A – Airway:"
     },
     {
      "type": "text",
      "text": " trachea midline; carina; ETT tip ~4 cm above the carina"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
