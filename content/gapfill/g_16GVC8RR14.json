       }
      ],
      "text": "Trach deviation AWAY from white-out"
     },
     {
      "type": "text",
      "text": " → tension pneumothorax"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
