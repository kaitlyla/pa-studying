        }
       }
      ],
      "text": "Tracheal deviation AWAY from white-out"
     },
     {
      "type": "text",
      "text": " → tension pneumothorax"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 6,
