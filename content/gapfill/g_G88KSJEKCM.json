      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Know:"
     },
     {
      "type": "text",
      "text": " ethionamide (second-line): less effective and more toxic than other anti-TB drugs."
     }
    ]
   }
