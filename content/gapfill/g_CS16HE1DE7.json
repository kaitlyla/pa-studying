     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Acute or critical illness: cautious diuresis, inotropic support (eg, milrinone) and pulmonary vasodilation (if not contraindicated) may help."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Pulmonary vasodilators: generally not effective for causes other than select group 1 PAH; not typically indicated for cor pulmonale from chronic lung disease, but may have a role in severe cases."
     }
    ]
   }
  ]
 },
