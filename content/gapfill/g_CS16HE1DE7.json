     {
      "type": "text",
      "text": "Tx focuses on the cause, esp alleviating or moderating hypoxia."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
