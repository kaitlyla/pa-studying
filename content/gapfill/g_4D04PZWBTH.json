     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Non-respiratory sinus arrhythmia"
     },
     {
      "type": "text",
      "text": " (not tied to breathing) is less common, usually in elderly patients, and more likely pathological (e.g., heart disease, digoxin toxicity)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
