      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Don't confuse with:"
     },
     {
      "type": "text",
      "text": " frequent PACs, Mobitz I, type I SA exit block"
     }
    ]
   },
