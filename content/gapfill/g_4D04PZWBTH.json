      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Who:"
     },
     {
      "type": "text",
      "text": " a norm finding, MC in young, healthy people"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
