       }
      ],
      "text": "Mech:"
     },
     {
      "type": "text",
      "text": " reflex chgs in vagal tone w breathing — inspiration lowers vagal tone (rate rises); expiration restores it (rate falls)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
