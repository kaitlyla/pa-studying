    "content": [
     {
      "type": "text",
      "text": "Chemo given with radiation (cisplatin or carboplatin) is often used to sensitize the tumor to radiation"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
