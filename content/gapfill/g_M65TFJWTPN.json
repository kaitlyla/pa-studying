     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Headaches, visual field defects or pituitary dysfunction:"
     },
     {
      "type": "text",
      "text": " brain MRI."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
