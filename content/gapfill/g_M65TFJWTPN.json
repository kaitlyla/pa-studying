    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Progestin challenge"
     },
     {
      "type": "text",
      "text": " (secondary amenorrhea with normal prolactin, FSH and thyroid tests, no virilization): withdrawal bleeding means estrogen is sufficient."
     }
