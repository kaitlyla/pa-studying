     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Dressing:"
     },
     {
      "type": "text",
      "text": " petrolatum and a bandage; avoid Neosporin (high contact-allergy rate)."
     }
