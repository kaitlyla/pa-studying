        }
       }
      ],
      "text": "Mobile echodensity (vegetation) on a valve, regurg, abscess"
     },
     {
      "type": "text",
      "text": " → infective endocarditis"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 6,
