      "text": "BPH workup:"
     },
     {
      "type": "text",
      "text": " DRE, IPSS score, UA to rule out infection, PSA to rule out prostate cancer, PVR for retention."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
