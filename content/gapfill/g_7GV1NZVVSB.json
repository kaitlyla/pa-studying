     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Before biopsy:"
     },
     {
      "type": "text",
      "text": " mpMRI; biopsy if PI-RADS 3 or higher."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
