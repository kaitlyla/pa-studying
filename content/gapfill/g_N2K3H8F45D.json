     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Dexamethasone 0.15, 0.3 or 0.6 mg/kg appear equally effective; 0.6 mg/kg is the most used. Oral is preferred; one dose is enough for most children."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Nebulized racemic epinephrine ↑Sx scores within 30 min but may wear off after 2 h → prolonged observation (home after 4 h if improved)."
     }
    ]
   }
  ]
