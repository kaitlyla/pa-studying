    "content": [
     {
      "type": "text",
      "text": "Mild: single dose of dexamethasone + supportive care; moderate–severe: nebulized epinephrine + dexamethasone."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
