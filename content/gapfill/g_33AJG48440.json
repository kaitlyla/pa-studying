     {
      "type": "text",
      "text": "Over-the-counter topical antimicrobial, mildly comedolytic; reduces inflammatory and noninflammatory lesions"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
