    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Toxicity (salicylism):"
     },
     {
      "type": "text",
      "text": " early N/V, tinnitus and hypervent; resp alkalosis plus met acidosis, which eventually becomes the primary finding. Tx w activated charcoal and alkaline diuresis w extra KCl; consider hemodialysis if poisoning = severe."
     }
    ]
   }
