       }
      ],
      "text": "Treats:"
     },
     {
      "type": "text",
      "text": " neomycin + polymyxin B cover S. aureus, E. coli, H. flu, Klebsiella-Enterobacter, Neisseria and P. aeruginosa (⍉Serratia or strep)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
