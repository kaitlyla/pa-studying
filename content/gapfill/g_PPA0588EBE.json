    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Caution:"
     },
     {
      "type": "text",
      "text": " neomycin can cause permanent sensorineural hearing loss (risk ↑ w prolonged use; limit to 10 days); don't use w a perforated TM."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
