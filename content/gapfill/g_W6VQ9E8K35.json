     "borders": null,
     "marker": null
    },
    "content": [
     {
      "type": "text",
      "text": "RBBB plus left axis deviation (RBBB + LAFB) or RBBB plus right axis deviation (RBBB + LPFB)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
