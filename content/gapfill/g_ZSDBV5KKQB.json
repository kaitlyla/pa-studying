    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Coronary origins:"
     },
     {
      "type": "text",
      "text": " the coronary arteries are the first branches of the ascending aorta, arising from aortic sinuses just above the aortic valve."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
