       }
      ],
      "text": "Pericardium:"
     },
     {
      "type": "text",
      "text": " a sturdy outer fibrous layer and an inner serous layer."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
