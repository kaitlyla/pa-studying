    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Tricuspid and mitral:"
     },
     {
      "type": "text",
      "text": " tricuspid on the Rt and mitral on the Lt, both attached to papillary muscles by chordae tendineae."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
