    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Neuropathy, myopathy or neuromuscular junction disorder:"
     },
     {
      "type": "text",
      "text": " electromyography and nerve conduction studies."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
