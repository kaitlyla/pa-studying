      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Carpal tunnel:"
     },
     {
      "type": "text",
      "text": " clinical (Tinel, Phalen); nerve conduction testing if severe or uncertain."
     }
    ]
   },
   {
    "type": "paragraph",
