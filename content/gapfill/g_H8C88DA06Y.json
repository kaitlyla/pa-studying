      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Suspected myelopathy:"
     },
     {
      "type": "text",
      "text": " spinal MRI."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
