      "text": "Thumbprint sign on lateral neck"
     },
     {
      "type": "text",
      "text": " → acute epiglottitis (Hib historically; now mostly other org)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
