    },
    "content": [
     {
      "type": "text",
      "text": "Caution: HF, hypertension, renal insufficiency; peptic ulcer, diverticulitis (perforation risk)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
