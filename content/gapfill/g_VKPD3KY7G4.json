     }
    },
    "content": [
     {
      "type": "text",
      "text": "CYP3A4 inducers (phenytoin, carbamazepine, rifampin, barbiturates) may require a higher steroid dose"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
