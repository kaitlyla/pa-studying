        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "Periventricular ovoid T2/FLAIR lesions perpendicular to ventricles ('Dawson fingers'); lesions disseminated in time/space"
     },
     {
      "type": "text",
      "text": " → MS"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
