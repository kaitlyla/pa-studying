    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "New-onset sz or a newly abnorm exam:"
     },
     {
      "type": "text",
      "text": " neuroimaging, plus lytes, BUN, creatinine, glucose, calcium, magnesium, phosphate and liver tests."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
