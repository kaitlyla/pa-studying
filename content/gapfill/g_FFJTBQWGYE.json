      "text": "Treats:"
     },
     {
      "type": "text",
      "text": " topical only; bactericidal vs staph and beta-hemolytic strep; negligible systemic absorb."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
