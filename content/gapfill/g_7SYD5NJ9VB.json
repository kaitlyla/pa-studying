    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Brain death pattern:"
     },
     {
      "type": "text",
      "text": " technetium-99m HMPAO brain scanning (or angiography, or transcranial Doppler in adults) shows no intracranial blood flow"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
