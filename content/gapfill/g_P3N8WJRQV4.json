       {
        "type": "bold"
       }
      ],
      "text": "Ibuprofen adult analgesic dose:"
     },
     {
      "type": "text",
      "text": " 400 mg every 4 to 6 hrs prn for pain."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
