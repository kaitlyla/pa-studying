     }
    },
    "content": [
     {
      "type": "text",
      "text": "Drive the needle in at 90° to evert the wound edges."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
