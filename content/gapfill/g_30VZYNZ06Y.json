    "content": [
     {
      "type": "text",
      "text": "Mainly bacteriostatic; bind the 50S ribosomal subunit and inhibit protein synthesis."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
