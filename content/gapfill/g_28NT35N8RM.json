    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Older adults:"
     },
     {
      "type": "text",
      "text": " fatigue is often the first symptom of a disorder, such as pneumonia, and is not normal aging."
     }
