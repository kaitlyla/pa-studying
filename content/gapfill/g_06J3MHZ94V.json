      "text": "Newborn visit:"
     },
     {
      "type": "text",
      "text": " evaluate within 3 to 5 days of birth and within 48 to 72 hours after hospital discharge, including feeding and jaundice. Newborns discharged less than 48 hours after delivery must be examined within 48 hours of discharge."
     }
    ]
