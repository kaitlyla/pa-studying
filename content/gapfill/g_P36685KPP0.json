        "type": "bold"
       }
      ],
      "text": "MCCs:"
     },
     {
      "type": "text",
      "text": " HTN, CAD, cardiomyopathy, valvular dz (MS, MR, TR), hyperthyroidism, binge drinking (“holiday heart”)"
