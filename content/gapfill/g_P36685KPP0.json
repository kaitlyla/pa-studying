     }
    },
    "content": [
     {
      "type": "text",
      "text": "Once Eti are managed: ventricular rate control, rhythm control, and prev of thromboembolism"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
