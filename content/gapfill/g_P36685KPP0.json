     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "Do ⍉give AV node blockers in WPW w an accessory pathway (wide QRS)"
     },
     {
      "type": "text",
      "text": " — they can increase conduction down the bypass tract and cause VF"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
