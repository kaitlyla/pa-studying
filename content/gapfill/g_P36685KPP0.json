     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Anticoagulation:"
     },
     {
      "type": "text",
      "text": " weigh CVA risk against bleed risk, using RF or a score such as CHADS2 or CHA2DS2-VASc"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
