     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "may be present — fine (< 0.5 mm) or coarse (> 0.5 mm)"
     },
     {
      "type": "text",
      "text": "; they can mimic P waves and lead to misdiagnosis"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
