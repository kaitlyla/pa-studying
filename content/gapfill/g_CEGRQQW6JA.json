     }
    },
    "content": [
     {
      "type": "text",
      "text": "Bedside US can also make the dx if underlying lung dz does ⍉prevent adequate visualization"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
