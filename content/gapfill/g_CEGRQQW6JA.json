       }
      ],
      "text": "Her chart:"
     },
     {
      "type": "text",
      "text": " needle decompression if tension; chest tube"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
