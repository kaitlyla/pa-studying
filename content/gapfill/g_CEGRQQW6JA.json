        }
       }
      ],
      "text": "Visible pleural line, absent lung markings beyond"
     },
     {
      "type": "text",
      "text": " → pneumothorax"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
