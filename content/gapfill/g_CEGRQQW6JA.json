      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Sus in a stable pt w dyspnea or pleuritic CP and USU confirmed w an upright inspir chest radiograph; expir films increase lung density and so the contrast w the pleural air"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
