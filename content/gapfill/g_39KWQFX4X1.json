     "borders": null,
     "marker": null
    },
    "content": [
     {
      "type": "text",
      "text": "Orthodromic AVRT: a narrow-QRS tachy — down the AV node and His-Purkinje system, back up the accessory pathway — w the P wave shortly after the QRS (short RP)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 6,
