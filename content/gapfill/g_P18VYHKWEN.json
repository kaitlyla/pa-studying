     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Newborn pulse oximetry screening"
     },
     {
      "type": "text",
      "text": " for critical congenital Hdz b4 d/c, @ ≥ 24 hrs of age."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
