      "text": "prominent"
     },
     {
      "type": "text",
      "text": " (best seen in the precordial leads V2–V3)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
