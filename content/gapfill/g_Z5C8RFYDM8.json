      ],
      "text": "CI:"
     },
     {
      "type": "text",
      "text": " ↑risk of severe hyponatremia, eg, excessive fluid intake, fluid/electrolyte-disturbing illness, loop diuretics, systemic or inhaled glucocorticoids."
     }
    ]
   },
