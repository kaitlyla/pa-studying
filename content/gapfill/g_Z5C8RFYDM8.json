     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Dose:"
     },
     {
      "type": "text",
      "text": " intranasal spray delivers 10 mcg per 0.1 mL (fixed dose; can be given several times a day)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
