      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Contact w a bat is an absolute indication for PEP (bat bites may be hard to detect)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Giving vaccine and immune globulin after clinical rabies develops may cause more rapid deterioration."
     }
    ]
   }
