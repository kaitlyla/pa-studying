     {
      "type": "text",
      "text": "After exposure: thoroughly clean and debride any wounds, then give rabies vaccine and rabies immune globulin."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
