      ],
      "text": "Vonoprazan for H. pylori:"
     },
     {
      "type": "text",
      "text": " triple therapy 20 mg + amoxicillin 1,000 mg + clarithromycin 500 mg, each twice daily for 14 days; dual therapy 20 mg twice daily + amoxicillin 1,000 mg three times daily for 14 days."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Vonoprazan is contraindicated with rilpivirine-containing products."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Vonoprazan may raise exposure to CYP3A4 substrates; a strong or moderate CYP3A4 inducer (eg, rifampicin, efavirenz) is predicted to lower vonoprazan exposure by 80% or 50%."
     }
    ]
   }
  ]
