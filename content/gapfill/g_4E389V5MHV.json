    },
    "content": [
     {
      "type": "text",
      "text": "The first question = cystic versus solid, b/c cysts are rarely CA; US USU decides this"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
