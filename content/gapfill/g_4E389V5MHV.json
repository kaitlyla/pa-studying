      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Cyst or solid?"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
