    },
    "content": [
     {
      "type": "text",
      "text": "Each yes answer scores one point; a score of 2 or more means anorexia nervosa or bulimia nervosa is likely."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
