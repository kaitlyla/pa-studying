    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Furosemide (edema):"
     },
     {
      "type": "text",
      "text": " 20–80 mg PO as a single dose; repeat or raise by 20–40 mg ⍉sooner than 6–8 h later until the desired diuresis."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
