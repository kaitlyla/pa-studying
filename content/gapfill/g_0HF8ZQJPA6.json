      "text": "Role in PAH:"
     },
     {
      "type": "text",
      "text": " adjunctive HF tx, incl diuretics, is needed for many pts."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
