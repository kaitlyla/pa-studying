    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Fever persisting > 48 hours on treatment:"
     },
     {
      "type": "text",
      "text": " CT of the abdomen and pelvis for pelvic abscess; consider septic pelvic thrombophlebitis."
     }
    ]
