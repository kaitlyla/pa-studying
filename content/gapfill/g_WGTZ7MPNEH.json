      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Mild to moderate scalp psoriasis: calcipotriene foam or calcipotriene/betamethasone dipropionate gel for four to 12 weeks (SORT A)"
     }
    ]
   }
  ]
 },
