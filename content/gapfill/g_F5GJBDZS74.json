    "content": [
     {
      "type": "text",
      "text": "Tdap: 1 dose each preg, whatever the prior Hx"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
