    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "LP landmarks:"
     },
     {
      "type": "text",
      "text": " spinous processes are hyperechoic crescents with acoustic shadowing."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
