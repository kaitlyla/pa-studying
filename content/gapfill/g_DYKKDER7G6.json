      ],
      "text": "subpleural, reticular opacities"
     },
     {
      "type": "text",
      "text": " w irregularly thickened interlobular septa and intralobular lines; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "subpleural honeycombing"
     },
     {
      "type": "text",
      "text": "; "
