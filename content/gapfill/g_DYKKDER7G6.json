       {
        "type": "bold"
       }
      ],
      "text": "CXR:"
     },
     {
      "type": "text",
      "text": " typically diffuse reticular opacities in the "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "lower and periph lung zones"
     },
     {
      "type": "text",
      "text": "; honeycombing and traction bronchiectasis USU in more advanced cases"
     }
    ]
   },
   {
