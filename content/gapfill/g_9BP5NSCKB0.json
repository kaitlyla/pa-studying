       }
      ],
      "text": "RWMA in a coronary distribution, thinned scar, ± apical aneurysm/thrombus"
     },
     {
      "type": "text",
      "text": " → prior MI"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
