    "content": [
     {
      "type": "text",
      "text": "Chest CT = more sensitive for pleural and parenchymal abnormalities and typically shows a usual interstitial PNA pattern; honeycombing, which may involve the mid and lower lung fields, signifies more advanced dz"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
