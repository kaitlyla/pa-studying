     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Thyroid storm:"
     },
     {
      "type": "text",
      "text": " PTU 600 mg PO given before iodine, then SSKI 5 drops (0.25 mL) PO q6h."
     }
    ]
   }
  ]
