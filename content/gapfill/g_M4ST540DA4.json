    "content": [
     {
      "type": "text",
      "text": "Iodine's block is transitory (a few days to a week), then usually stops. It generally isn't used for routine hyperthyroidism tx; uses are thyroid storm, emergency nonthyroid surgery, and prep for thyroidectomy."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Before thyroidectomy:"
     },
     {
      "type": "text",
      "text": " SSKI 3 drops (about 100–150 mg) PO TID for 10 days. Give methimazole first; the patient should be euthyroid before iodide is given."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
