    "content": [
     {
      "type": "text",
      "text": "IV volume expansion: 1 L of 5% dextrose in 0.9% saline over 1 to 2 hours, then more 0.9% saline IV until hypotension, dehydration and hyponatremia are corrected."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
