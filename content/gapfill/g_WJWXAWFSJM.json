     "align": "left",
     "shade": null,
     "borders": null,
     "marker": null
    },
    "content": [
     {
      "type": "text",
      "text": "A narrow QRS @ 40–60 (junctional escape) or 60–100 (accelerated), w inverted or ⍉P waves, or P waves buried in the QRS."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
