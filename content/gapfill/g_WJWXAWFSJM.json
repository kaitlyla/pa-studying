     {
      "type": "text",
      "text": " "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "digoxin toxicity (the classic cause)"
     },
     {
      "type": "text",
      "text": ", beta-agonists (isoprenaline, adrenaline), myocard ischemia, myocarditis, ♡ surg"
     }
