    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Accelerated (nonparoxysmal) junctional tachycardia:"
     },
     {
      "type": "text",
      "text": " treat the underlying heart disorder"
     }
    ]
   }
