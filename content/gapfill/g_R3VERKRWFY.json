       }
      ],
      "text": "Rimegepant ODT:"
     },
     {
      "type": "text",
      "text": " 75 mg PO as needed for acute migraine (max 75 mg in 24 hours), or 75 mg every other day to prevent episodic migraine. Ubrogepant: 50 or 100 mg PO; a second dose may be taken at least 2 hours later (max 200 mg in 24 hours)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Ubrogepant is contraindicated with strong CYP3A4 inhibitors; with potent P-gp inhibitors, avoid another rimegepant dose within 48 hours."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
