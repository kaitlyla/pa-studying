     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Rimegepant:"
     },
     {
      "type": "text",
      "text": " serious hypersensitivity (anaphylaxis, dyspnea, rash) can occur, sometimes days after a dose; new-onset or worsening hypertension may occur."
     }
    ]
   }
  ]
