     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Modified Schwartz score, ECG points (table):"
     },
     {
      "type": "text",
      "text": " QTc ≥ 480 ms 3; QTc 460–479 ms 2; QTc 450–459 ms (males only) 1; QTc ≥ 480 ms in the 4th minute of exercise recovery 1; torsades 2; T-wave alternans 1; notched T wave in 3 leads 1; resting heart rate < 2nd percentile for age 0.5"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
