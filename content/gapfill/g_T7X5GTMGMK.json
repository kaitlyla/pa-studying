     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "LQTS3:"
     },
     {
      "type": "text",
      "text": " mexiletine = added when a BB doesn't relieve Sx"
     }
    ]
