       }
      ],
      "text": "May present first as:"
     },
     {
      "type": "text",
      "text": " fetal or neonatal brady, or 2:1 AV block"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
