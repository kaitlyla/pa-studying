      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Borderline QT or genotype-positive w a norm resting QT: exercise testing, b/c some abnormalities appear only during or after exercise"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 6,
