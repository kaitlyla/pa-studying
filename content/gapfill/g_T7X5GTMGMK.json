    },
    "content": [
     {
      "type": "text",
      "text": "Some types have typical patterns: LQTS1 wide T waves; LQTS2 low-voltage, notched T waves; LQTS3 a long ST segment with normal-looking T waves."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 6,
