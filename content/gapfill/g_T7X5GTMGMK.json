     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "BB:"
     },
     {
      "type": "text",
      "text": " recommended w QTc prolongation or Sx (most effective in LQTS1 or LQTS2); prefer a long-acting ⍉selective one (ex, nadolol, slow-release propranolol)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
