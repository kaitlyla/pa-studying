     }
    },
    "content": [
     {
      "type": "text",
      "text": "Gepotidacin (Blujepa): uUTI in females age ≥12 y weighing ≥40 kg."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
