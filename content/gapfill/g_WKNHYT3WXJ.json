     }
    },
    "content": [
     {
      "type": "text",
      "text": "Ex CT: a lrg "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "acute necrotizing collection replacing most of the pancreatic tissue"
     },
     {
      "type": "text",
      "text": ", < 4 wks after necrotizing pancreatitis first presented"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
