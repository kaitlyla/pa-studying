     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "Grey Turner sign"
     },
     {
      "type": "text",
      "text": " (flank ecchymoses) and "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "Cullen sign"
     },
     {
      "type": "text",
      "text": " (umbilical ecchymoses) indicate extravasation of hemorrhagic exudate, occur in < 3% of cases and portend a poor prognosis"
     }
    ]
   },
