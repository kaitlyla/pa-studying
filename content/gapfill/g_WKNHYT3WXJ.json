    "content": [
     {
      "type": "text",
      "text": "Basic tx: resuscitation w a "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "mod fluid vol of lactated Ringer’s solution"
     },
     {
      "type": "text",
      "text": ", analgesia and nutritional support"
     }
    ]
   },
   {
