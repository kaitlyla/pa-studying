    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Know:"
     },
     {
      "type": "text",
      "text": " paromomycin = safe in preg; iodoquinol = a 20-day course, paromomycin 7 days."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
