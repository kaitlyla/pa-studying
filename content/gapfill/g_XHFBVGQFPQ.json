    "content": [
     {
      "type": "text",
      "text": "Monitor closely for resp depression, esp @ the start or after a dose increase; have naloxone and resuscitative equipment STAT available."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
