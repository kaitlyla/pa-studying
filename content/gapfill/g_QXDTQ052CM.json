      ],
      "text": "Peripheral colon > 6 cm with haustra; cecum > 9 cm"
     },
     {
      "type": "text",
      "text": " → large bowel obstruction"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
