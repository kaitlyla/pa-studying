     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Kleihauer-Betke"
     },
     {
      "type": "text",
      "text": " measures fetal blood in the maternal circ to dose additional Rho(D) immune globulin"
     }
