       }
      ],
      "text": "H&P (admission) — Admission H&P timing:"
     },
     {
      "type": "text",
      "text": " completed and documented no more than 30 days before or 24 hours after admission, and before surgery or a procedure requiring anesthesia; it must be in the chart within 24 hours after admission."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "H&P (admission) — Updated exam:"
     },
     {
      "type": "text",
      "text": " if the H&P was done within the 30 days before admission, document an updated exam noting any changes in the patient's condition within 24 hours after admission (and before surgery or a procedure requiring anesthesia)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
