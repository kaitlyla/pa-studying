     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Progress note — Complications:"
     },
     {
      "type": "text",
      "text": " document complications, hospital-acquired infections, and unfavorable reactions to drugs and anesthesia."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
