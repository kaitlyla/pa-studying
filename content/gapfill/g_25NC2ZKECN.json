       {
        "type": "bold"
       }
      ],
      "text": "Uncomplicated pericarditis, first line:"
     },
     {
      "type": "text",
      "text": " aspirin 325–650 mg PO q4–6h, usually with colchicine. Use aspirin when pericarditis occurs with acute MI."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Precautions:"
     },
     {
      "type": "text",
      "text": " avoid in severe renal failure (GFR < 10 mL/min) and severe hepatic insufficiency."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Toxicity (salicylism):"
     },
     {
      "type": "text",
      "text": " early nausea, vomiting, tinnitus and hyperventilation; respiratory alkalosis plus metabolic acidosis, which eventually becomes the primary finding. Treat with activated charcoal and alkaline diuresis with extra KCl; consider hemodialysis if poisoning is severe."
     }
    ]
   }
  ]
 },
