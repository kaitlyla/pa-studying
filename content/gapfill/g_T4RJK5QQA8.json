    "content": [
     {
      "type": "text",
      "text": "Cisplatin-based combo chemo: three cycles of BEP or four cycles of etoposide + cisplatin (EP)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
