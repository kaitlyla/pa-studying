      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Stage I seminoma: cure rate on surveillance = adjuvant RT or carboplatin; adjuvant option studied (vs para-aortic RT): a single dose of carboplatin."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
