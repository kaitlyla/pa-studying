     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Labels:"
     },
     {
      "type": "text",
      "text": " guanfacine ER (Intuniv): ADHD, as monotherapy or adjunct to stimulants; clonidine ER: ADHD safety and efficacy established in pts 6–17 y."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
