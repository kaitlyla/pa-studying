    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Guanfacine ER rebound HTN:"
     },
     {
      "type": "text",
      "text": " abrupt stop → clinically significant, persistent rebound HTN (hypertensive encephalopathy reported); taper ≤ 1 mg every 3–7 days; children who vomit and miss doses may be esp at risk."
     }
    ]
   }
  ]
