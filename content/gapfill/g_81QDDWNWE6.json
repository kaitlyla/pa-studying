    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Bone age"
     },
     {
      "type": "text",
      "text": " from a left-hand X-ray when growth is abnormal."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
