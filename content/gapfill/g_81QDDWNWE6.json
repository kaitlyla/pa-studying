       {
        "type": "bold"
       }
      ],
      "text": "Pituitary and hypothalamic MRI"
     },
     {
      "type": "text",
      "text": " once GH deficiency is found."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
