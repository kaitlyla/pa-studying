     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Screening labs for other causes:"
     },
     {
      "type": "text",
      "text": " TSH and T4, electrolytes and creatinine, tTG antibodies and CRP, and CBC with differential."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
