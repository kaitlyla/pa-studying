      ],
      "text": "Plot height and weight"
     },
     {
      "type": "text",
      "text": " on growth charts: WHO for 0 to 2 years, CDC for 2 years and older."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
