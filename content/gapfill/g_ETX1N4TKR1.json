     {
      "type": "text",
      "text": "LQTS w resting QTc >470 ms: a BB = recommended."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
