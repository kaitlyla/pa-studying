      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Peds dose:"
     },
     {
      "type": "text",
      "text": " Ibuprofen 5–10 mg/kg PO q6–8h; max 400 mg/dose or 40 mg/kg/day."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Boxed warning:"
     },
     {
      "type": "text",
      "text": " serious cardiovasc thrombotic events (MI, CVA), which can be fatal; risk may occur early and may rise w duration of use. Boxed warning: serious GI bleed, ulceration and perf, any time and w.o warning; elderly @ greater risk."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
