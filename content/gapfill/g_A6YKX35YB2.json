       }
      ],
      "text": "Role in teething:"
     },
     {
      "type": "text",
      "text": " acetaminophen or ibuprofen if necessary; ⍉teething gels (⍉effective; benzocaine can be dangerous in infancy)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
