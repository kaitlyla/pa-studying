    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Eszopiclone:"
     },
     {
      "type": "text",
      "text": " start 1 mg, raised to 2 mg or 3 mg if clinically indicated; ⍉more than 3 mg QD STAT b4 bedtime; elderly or debilitated pts: ⍉more than 2 mg."
     }
    ]
   }
  ]
