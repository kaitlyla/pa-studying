      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Wide QRS (≥ 0.12 seconds):"
     },
     {
      "type": "text",
      "text": " ventricular origin, or a supraventricular rhythm with a conduction defect or WPW pre-excitation"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
