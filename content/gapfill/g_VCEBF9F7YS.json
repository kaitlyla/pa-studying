     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Narrow or wide QRS?"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
