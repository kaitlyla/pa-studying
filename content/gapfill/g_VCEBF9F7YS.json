       {
        "type": "bold"
       }
      ],
      "text": "Regular or irregular?"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Irregular rhythms are "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "regularly irregular"
     },
     {
      "type": "text",
      "text": " (a pattern, e.g., premature beats, sinus arrhythmia, second-degree block) or "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "irregularly irregular"
     },
     {
      "type": "text",
      "text": " (no pattern)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 6,
