     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Dental home:"
     },
     {
      "type": "text",
      "text": " check that the child has one; if not, do a risk assessment and refer. Recommend brushing with fluoride toothpaste in the right amount for age."
     }
    ]
   }
