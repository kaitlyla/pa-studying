       {
        "type": "bold"
       }
      ],
      "text": "Newborn hearing screen:"
     },
     {
      "type": "text",
      "text": " confirm the initial screen was completed, verify results and follow up as appropriate; newborns should be screened per the Year 2007 Position Statement: Principles and Guidelines for Early Hearing Detection and Intervention Programs."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Hearing:"
     },
     {
      "type": "text",
      "text": " audiometry including 6,000 and 8,000 Hz once between 11 and 14 years, once between 15 and 17 years, and once between 18 and 21 years."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Vision:"
     },
     {
      "type": "text",
      "text": " visual acuity screen at ages 4 and 5 years and in cooperative 3-year-olds; instrument-based screening may assess risk at 12 and 24 months, in addition to the 3- through 5-year visits."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
