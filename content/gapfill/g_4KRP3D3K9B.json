    "content": [
     {
      "type": "text",
      "text": "IV (adults, adolescents, children ≥ 5 y or > 20 kg): 0.4–2 mg every 2–3 min as needed, max total 10 mg."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
