      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Most opioids may outlast naloxone:"
     },
     {
      "type": "text",
      "text": " keep monitoring after a response; if respiratory depression recurs, give another IV bolus or intubate and ventilate."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Abrupt reversal:"
     },
     {
      "type": "text",
      "text": " N/V, sweating, tremulousness, tachycardia, hypo- or hypertension, seizures, VT/VF, pulmonary edema, cardiac arrest. Withdrawal is still preferable to severe respiratory depression."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
