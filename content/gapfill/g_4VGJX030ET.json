      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "ST and T:"
     },
     {
      "type": "text",
      "text": " "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "discordant"
     },
     {
      "type": "text",
      "text": " (opposite the QRS)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
