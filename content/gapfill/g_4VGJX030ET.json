        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "⍉P wave b4 the QRS"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
