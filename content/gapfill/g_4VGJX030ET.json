    },
    "content": [
     {
      "type": "text",
      "text": "A wide, bizarre QRS with no P wave before it, typically followed by a compensatory pause."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
