      "content": [
       {
        "type": "text",
        "text": "Your EKG notes call a new LBBB with chest pain a STEMI equivalent."
       }
      ]
     },
     {
      "type": "paragraph",
      "attrs": {
       "indLeft": 0,
       "indRight": 0,
       "indFirst": 0,
       "spaceBefore": 0,
       "spaceAfter": 0,
       "line": null,
       "align": "left",
       "shade": null,
       "borders": null,
       "marker": null
      },
      "content": [
       {
        "type": "text",
        "text": "LITFL notes this was once the teaching, but newer data show chest-pain patients with new LBBB have little added risk of acute MI; practice now looks for excessive discordance or concordant ST changes (Sgarbossa)."
       }
      ]
     }
    ]
   }
