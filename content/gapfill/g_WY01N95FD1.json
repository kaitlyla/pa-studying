        "type": "bold"
       }
      ],
      "text": "Overdose:"
     },
     {
      "type": "text",
      "text": " DHPs cause marked hypotension, possibly with reflex tachycardia; non-DHPs cause bradycardia, hypotension and heart block. Treat with IV calcium, fluids and pressors; atropine or pacing for bradycardia/heart block. Observe a verapamil overdose for at least 48 h (especially ER)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "IV doses:"
     },
     {
      "type": "text",
      "text": " nicardipine start 5 mg/h, increase by 2.5 mg/h every 5–15 min to a max of 15 mg/h; clevidipine start 1–2 mg/h; most patients need ≤ 16 mg/h."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Clevidipine is contraindicated with soy or egg allergy, defective lipid metabolism, or severe aortic stenosis; nicardipine IV with advanced aortic stenosis."
     }
    ]
   }
  ]
