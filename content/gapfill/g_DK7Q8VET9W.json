    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Antidote flumazenil:"
     },
     {
      "type": "text",
      "text": " use is controversial (toxicity if indications, administration and monitoring aren't appropriate; toxicologist consult recommended); it can precipitate life-threatening withdrawal (eg, seizures)."
     }
