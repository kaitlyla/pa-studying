     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Merck, outpt w ⍉comorbidities or MRSA/Pseudomonas RF:"
     },
     {
      "type": "text",
      "text": " amoxicillin plus either a macrolide (azithro or clarithromycin) or doxycycline (if allergic to macrolides)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
