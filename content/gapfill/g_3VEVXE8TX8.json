       }
      ],
      "text": "Lobar consolidation + air bronchograms"
     },
     {
      "type": "text",
      "text": " → bact PNA (typical, S. pneumoniae)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
