     }
    },
    "content": [
     {
      "type": "text",
      "text": "Check the lung fields for: symmetry, opacities, vasc markings, masses, nodules"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
