       {
        "type": "bold"
       }
      ],
      "text": "Naltrexone for opioid dependence:"
     },
     {
      "type": "text",
      "text": " start with 25 mg; if no withdrawal signs occur, may then go to 50 mg a day."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Contraindicated with opioid analgesics or current opioid dependence (including methadone or buprenorphine maintenance), or acute opioid withdrawal; opioid-dependent patients, including those treated for alcohol dependence, should be opioid-free (including tramadol) before starting: at least 7 to 10 days after short-acting opioids."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Naloxone IV (adults, adolescents, children ≥ 5 y or > 20 kg): repeat every 2–3 min, max total 10 mg."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Naloxone abrupt reversal:"
     },
     {
      "type": "text",
      "text": " N/V, sweating, tremulousness, tachycardia, hypo- or hypertension, seizures, VT/VF, pulmonary edema, cardiac arrest. Withdrawal is still preferable to severe respiratory depression."
     }
    ]
   }
  ]
 },
