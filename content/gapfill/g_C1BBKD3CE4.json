        }
       }
      ],
      "text": "Calcified AV: peak velocity ≥4 m/s, mean gradient ≥40 mmHg, AVA ≤1.0 cm²"
     },
     {
      "type": "text",
      "text": " → severe AS"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
