     {
      "type": "text",
      "text": "Neutralize unbound toxin outside the CNS w human tetanus immune globulin (TIG)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
