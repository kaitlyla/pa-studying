       {
        "type": "bold"
       }
      ],
      "text": "Four regions:"
     },
     {
      "type": "text",
      "text": " cerebrum, diencephalon, brain stem and cerebellum."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
