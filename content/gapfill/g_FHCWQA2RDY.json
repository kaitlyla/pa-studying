    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Axillary nerve injury:"
     },
     {
      "type": "text",
      "text": " anterior shoulder dislocation can injure it, giving decreased sensation over the deltoid."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
