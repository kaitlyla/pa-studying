      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Superfic radial n.:"
     },
     {
      "type": "text",
      "text": " sensation to the dorsum of the hand, the dorsal first to third digits and the dorsal lat fourth finger, sparing the fingertips."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
