     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Superficial radial nerve:"
     },
     {
      "type": "text",
      "text": " sensation to the dorsum of the hand, the dorsal first to third digits and the dorsal lateral fourth finger, sparing the fingertips."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
