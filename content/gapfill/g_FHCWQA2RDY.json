      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Median nerve in the forearm and wrist:"
     },
     {
      "type": "text",
      "text": " enters the forearm between the two heads of pronator teres (giving off the anterior interosseous nerve), runs between flexor digitorum superficialis and profundus, gives off the palmar cutaneous branch about 5 cm above the wrist, and is the only nerve through the carpal tunnel, deep to the flexor retinaculum."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
