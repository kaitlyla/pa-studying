      ],
      "text": "Axillary nerve origin:"
     },
     {
      "type": "text",
      "text": " one of the two terminal branches of the posterior cord, from C5 and C6."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
