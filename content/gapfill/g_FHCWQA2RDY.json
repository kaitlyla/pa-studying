    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Median nerve roots:"
     },
     {
      "type": "text",
      "text": " a lateral root from the lateral cord (C5, C6, C7) and a medial root from the medial cord (C8, T1)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
