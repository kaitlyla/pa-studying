    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Radial palsy look-alike:"
     },
     {
      "type": "text",
      "text": " C7 radiculopathy can cause motor deficits similar to radial nerve palsy (wristdrop)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
