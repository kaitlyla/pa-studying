      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Median nerve motor supply:"
     },
     {
      "type": "text",
      "text": " every anterior forearm flexor and pronator except flexor carpi ulnaris and the ulnar half of flexor digitorum profundus; in the hand, the thenar muscles and the lateral two lumbricals."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
