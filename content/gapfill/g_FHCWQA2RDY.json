    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Radial nerve course:"
     },
     {
      "type": "text",
      "text": " winds around the spiral groove of the humerus with the profunda brachii artery, pierces the lateral intermuscular septum at mid-humerus, passes in front of the lateral epicondyle and divides in the cubital fossa into superficial and deep branches."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
