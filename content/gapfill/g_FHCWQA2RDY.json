      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Musculocutaneous nerve origin:"
     },
     {
      "type": "text",
      "text": " a terminal branch of the lateral cord (alongside the lateral root of the median nerve), from C5–7."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
