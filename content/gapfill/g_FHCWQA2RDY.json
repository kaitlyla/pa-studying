    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Ulnar n. @ the wrist:"
     },
     {
      "type": "text",
      "text": " gives off the dorsal cutaneous branch b4 the wrist, then enters the hand superfic to the flexor retinaculum in Guyon's canal w the ulnar a. and v."
     }
    ]
   },
   {
