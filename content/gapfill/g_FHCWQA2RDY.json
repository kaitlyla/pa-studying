       }
      ],
      "text": "Musculocutaneous n. origin:"
     },
     {
      "type": "text",
      "text": " a terminal branch of the lat cord (alongside the lat root of the median n.), from C5–7."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
