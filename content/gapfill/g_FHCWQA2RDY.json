    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Radial n. supply in the arm:"
     },
     {
      "type": "text",
      "text": " triceps brachii, anconeus, brachioradialis and extensor carpi radialis longus."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
