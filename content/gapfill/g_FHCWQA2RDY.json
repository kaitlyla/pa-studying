     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Median n. motor supply:"
     },
     {
      "type": "text",
      "text": " every anterior forearm flexor and pronator except flexor carpi ulnaris and the ulnar ½ of flexor digitorum profundus; in the hand, the thenar muscles and the lat two lumbricals."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
