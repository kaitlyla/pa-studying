      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Radial n. course:"
     },
     {
      "type": "text",
      "text": " winds around the spiral groove of the humerus w the profunda brachii a., pierces the lat intermuscular septum @ mid-humerus, passes in front of the lat epicondyle and divides in the cubital fossa into superfic and deep branches."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
