      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Musculocutaneous n. course:"
     },
     {
      "type": "text",
      "text": " pierces and supplies coracobrachialis, descends b/n biceps brachii and brachialis, and continues past the elbow as the lat cutaneous n. of the forearm (its sensory continuation)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
