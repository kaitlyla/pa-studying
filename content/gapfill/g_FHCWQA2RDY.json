      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Ulnar nerve motor supply:"
     },
     {
      "type": "text",
      "text": " flexor carpi ulnaris, medial half of flexor digitorum profundus, the hypothenar muscles, 3rd and 4th lumbricals, palmar and dorsal interossei, deep head of flexor pollicis brevis, adductor pollicis and palmaris brevis."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
