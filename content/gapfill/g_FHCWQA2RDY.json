       }
      ],
      "text": "Ulnar n. sensory supply:"
     },
     {
      "type": "text",
      "text": " medial palm, palmar and dorsal fifth digit, and the adjacent ½ of the fourth digit."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
