      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Axillary nerve course:"
     },
     {
      "type": "text",
      "text": " runs behind the axillary artery, passes below the shoulder joint and leaves the axilla through the quadrangular space with the posterior circumflex humeral artery."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
