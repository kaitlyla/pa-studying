      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Median n. roots:"
     },
     {
      "type": "text",
      "text": " a lat root from the lat cord (C5, C6, C7) and a medial root from the medial cord (C8, T1)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
