      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Ulnar nerve sensory supply:"
     },
     {
      "type": "text",
      "text": " medial palm, palmar and dorsal fifth digit, and the adjacent half of the fourth digit."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
