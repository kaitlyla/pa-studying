     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Ulnar nerve at the wrist:"
     },
     {
      "type": "text",
      "text": " gives off the dorsal cutaneous branch before the wrist, then enters the hand superficial to the flexor retinaculum in Guyon's canal with the ulnar artery and vein."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
