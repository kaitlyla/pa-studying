    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Median nerve sensory supply:"
     },
     {
      "type": "text",
      "text": " skin over the thenar eminence and the palmar thumb, index, middle finger and radial half of the ring finger."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
