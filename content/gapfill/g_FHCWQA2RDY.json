     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Ulnar compression at the elbow:"
     },
     {
      "type": "text",
      "text": " paresthesias and sensory loss in the fifth digit and medial half of the fourth; weak, possibly atrophied thumb adductor, fifth-digit abductor and interosseous muscles."
     }
    ]
   },
   {
