       }
      ],
      "text": "Radial n. origin:"
     },
     {
      "type": "text",
      "text": " one of the two terminal branches of the posterior cord, from C5–T1."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
