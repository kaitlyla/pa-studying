     {
      "type": "text",
      "text": " for hemothorax, US can detect as little as ~20 mL of pleural fluid"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
