     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Throat culture"
     },
     {
      "type": "text",
      "text": " is the most reliable way to tell viral pharyngitis from group A strep."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
