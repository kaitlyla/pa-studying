      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Neck CT"
     },
     {
      "type": "text",
      "text": " right away if an abscess's location and extent are unclear."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
