      ],
      "text": "MOA:"
     },
     {
      "type": "text",
      "text": " macrolide that inhibits RNA synth by binding RNA polymerase; bactericidal vs C. diff."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
