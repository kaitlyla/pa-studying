    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Mild (potassium < 6 mEq/L, no ECG changes):"
     },
     {
      "type": "text",
      "text": " may respond to less potassium intake or stopping potassium-raising medications; adding a loop diuretic helps if the patient is not volume depleted"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
