     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Caution:"
     },
     {
      "type": "text",
      "text": " the potassium level may not correlate closely with the ECG — a patient with a relatively normal ECG can still have a sudden hyperkalemic cardiac arrest"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 6,
