    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Differential for a rapid ventricular-paced rhythm w ⍉preceding atrial activity:"
     },
     {
      "type": "text",
      "text": " pacemaker-mediated tachy, sensor-induced tachy, or potentially norm w an appropriate physiological stimulus (ex, exercise)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
