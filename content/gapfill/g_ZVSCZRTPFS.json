    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Stratum basalis:"
     },
     {
      "type": "text",
      "text": " the endometrial layer next to the myometrium; it does ⍉shed during menses."
     }
    ]
   },
   {
