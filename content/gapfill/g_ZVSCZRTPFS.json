      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Endometrium:"
     },
     {
      "type": "text",
      "text": " the innermost layer of the uterus."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
