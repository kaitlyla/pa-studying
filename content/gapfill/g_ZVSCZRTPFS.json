      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Uterine wall:"
     },
     {
      "type": "text",
      "text": " the perimetrium = the outer serous layer; the myometrium = the thick smooth musc layer responsible for contractions."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
