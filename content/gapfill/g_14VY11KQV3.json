      "text": "MOA:"
     },
     {
      "type": "text",
      "text": " beta-lactam; binds and inactivates enzymes required for bact cell wall synth."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
