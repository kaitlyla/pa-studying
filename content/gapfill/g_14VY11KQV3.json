    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Know:"
     },
     {
      "type": "text",
      "text": " add other abx for sus gram (+) or anaerobes; dose ↓in renal failure."
     }
