    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "AV node as the gate:"
     },
     {
      "type": "text",
      "text": " the ♡ skeleton keeps the impulse out of the ventricles except @ the AV node."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
