    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Sarcoidosis:"
     },
     {
      "type": "text",
      "text": " nonbiologic immunosuppressant option (with azathioprine, mycophenolate, cyclophosphamide, HCQ)."
     }
    ]
   }
  ]
