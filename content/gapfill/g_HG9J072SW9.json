      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Foot:"
     },
     {
      "type": "text",
      "text": " seven tarsal bones form the posterior foot and five metatarsals the mid-foot."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
