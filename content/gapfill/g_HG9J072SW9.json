      ],
      "text": "Bones:"
     },
     {
      "type": "text",
      "text": " femur, patella, tibia, fibula, tarsal bones, metatarsal bones and phalanges."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
