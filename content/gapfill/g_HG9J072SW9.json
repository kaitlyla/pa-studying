     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Knee:"
     },
     {
      "type": "text",
      "text": " the lateral and medial femoral condyles articulate with the tibia to form the knee joint."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
