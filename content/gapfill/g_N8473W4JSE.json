       }
      ],
      "text": "Mechanism:"
     },
     {
      "type": "text",
      "text": " impulses reach the LV via the posterior fascicle, which inserts into the inferoseptal wall"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
