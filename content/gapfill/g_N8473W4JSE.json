     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Spread:"
     },
     {
      "type": "text",
      "text": " the main wave of depolarization is slightly delayed and spreads upward and leftward — tall R waves in left-sided leads, deep S waves inferiorly"
     }
    ]
   },
   {
    "type": "paragraph",
