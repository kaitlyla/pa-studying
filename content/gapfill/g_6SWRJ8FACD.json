    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "FSH"
     },
     {
      "type": "text",
      "text": " is rarely needed (eg, after hysterectomy or at a younger age); one value can mislead, and consistently high levels confirm menopause."
     }
