       }
      ],
      "text": "Menopause is diagnosed clinically:"
     },
     {
      "type": "text",
      "text": " no menses for 12 months with no other likely cause."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
