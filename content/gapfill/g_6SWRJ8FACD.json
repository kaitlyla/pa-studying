     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Consider other causes:"
     },
     {
      "type": "text",
      "text": " pregnancy, other causes of amenorrhea, and uterine cancer causing abnormal bleeding."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
