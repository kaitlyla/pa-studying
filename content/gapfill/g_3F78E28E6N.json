      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Develop surveillance — language:"
     },
     {
      "type": "text",
      "text": " makes brief short vowel sounds; alerts to unexpected sound; quiets or turns to your voice; has different types of cries for hunger and tiredness."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Sensitivity to the environment:"
     },
     {
      "type": "text",
      "text": " ask about excessive crying, tremors, or excessive startles, or a need for extra support to handle activities of daily living."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Develop surveillance — motor:"
     },
     {
      "type": "text",
      "text": " moves both arms and both legs together; holds chin up when on stomach; opens fingers slightly when at rest."
     }
    ]
   }
  ]
