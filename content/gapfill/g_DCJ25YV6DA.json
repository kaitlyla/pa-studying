       }
      ],
      "text": "LA mass attached to the fossa ovalis, ball-on-stalk"
     },
     {
      "type": "text",
      "text": " → atrial myxoma"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
