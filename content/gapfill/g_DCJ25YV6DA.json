     }
    },
    "content": [
     {
      "type": "text",
      "text": "Ex ♡ CTA: a "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "Lt atrial mass attached by a stalk to the interatrial septum"
     },
     {
      "type": "text",
      "text": ", an appearance typical of atrial myxoma"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 6,
