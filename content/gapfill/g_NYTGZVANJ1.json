     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Poss myasthenia gravis:"
     },
     {
      "type": "text",
      "text": " ice pack test and acetylcholine-r antibodies."
     }
    ]
