     {
      "type": "text",
      "text": "Renal failure: calcitriol (or another analog that needs no renal activation); hypoparathyroidism: often needs calcitriol 0.5 to 2 mcg PO daily (can't activate cholecalciferol)"
     }
    ]
   },
