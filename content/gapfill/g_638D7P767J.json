        }
       }
      ],
      "text": "Intimal flap w two lumens in the aorta (CTA)"
     },
     {
      "type": "text",
      "text": " → aortic dissection (Stanford A = ascending; B = descending)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
