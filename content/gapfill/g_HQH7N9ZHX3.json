      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Aneuploidy:"
     },
     {
      "type": "text",
      "text": " ACOG recommends offering testing to all women regardless of age or baseline risk, including cell-free DNA (NIPT)."
     }
    ]
   },
   {
