      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Parkland formula: (4 mL/kg) × % TBSA burned (partial- and full-thickness) estimates fluid needs for the first 24 hours after the burn and sets the IV rate"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
