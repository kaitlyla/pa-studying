     {
      "type": "text",
      "text": "Large burns (> 20% TBSA) require fluid resuscitation"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
