     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "For lrg vessel occlusion, IV thrombolysis b4 thrombectomy = recommended when its criteria are met and should ⍉be omitted in favor of thrombectomy alone"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
