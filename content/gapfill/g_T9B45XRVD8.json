    },
    "content": [
     {
      "type": "text",
      "text": "Mech thrombectomy = strd of care in lrg CVA centers for recent large-vessel occlusion in the anterior circ"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
