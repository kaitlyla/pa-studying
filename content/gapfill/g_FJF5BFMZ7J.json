    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Preseptal vs orbital cellulitis"
     },
     {
      "type": "text",
      "text": " is mainly an eye-exam diagnosis; get CT or MRI if findings are equivocal, the exam is difficult (young children) or there is nasal discharge."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Reduced eye movement, pain with eye movement, proptosis or reduced acuity:"
     },
     {
      "type": "text",
      "text": " suspect orbital cellulitis and consult ophthalmology."
     }
    ]
   }
