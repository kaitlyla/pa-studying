     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Apremilast (oral PDE4 inhibitor): data suggest it = less effective than biologics; deucravacitinib (oral TYK2 inhibitor) = effective; spesolimab (IL-36 inhibitor) treats gen pustular psoriasis"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
