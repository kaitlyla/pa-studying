     }
    },
    "content": [
     {
      "type": "text",
      "text": "Icotrokinra (Icotyde): oral tablets"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Icotrokinra = IL-23-r antagonist for mod-severe plaque psoriasis in adults and children 12 and older weighing ± 40 kg who are candidates for systemic therapy or phototherapy"
     }
    ]
   }
