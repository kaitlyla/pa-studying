      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Aspiration PNA:"
     },
     {
      "type": "text",
      "text": " typically develops over hrs to a few days (subacut w anaerobes); high-grade fever favors PNA over chem pneumonitis"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 6,
