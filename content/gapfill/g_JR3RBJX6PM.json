     }
    },
    "content": [
     {
      "type": "text",
      "text": "Buzzword: "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "tree-in-bud"
     },
     {
      "type": "text",
      "text": " on chest CT = endobronchial spread (TB, MAC, aspiration)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 6,
