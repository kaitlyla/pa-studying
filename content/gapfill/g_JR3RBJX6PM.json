    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "MAC, one common scenario (Lady Windermere syndrome):"
     },
     {
      "type": "text",
      "text": " immunocompetent, middle-aged or older White women w ↓BMI who have middle lobe bronchiectasis, scoliosis, pectus excavatum or MVP, typically presenting w a "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "chronic nonproductive cough"
     },
     {
      "type": "text",
      "text": " and ⍉other lung abnormalities"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
