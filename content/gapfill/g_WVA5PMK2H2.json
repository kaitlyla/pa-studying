     }
    },
    "content": [
     {
      "type": "text",
      "text": "Ex lat cervical spine radiograph (severe, long-standing dz): "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "a rigid cervical spine, completely ankylosed (“bamboo spine”)"
     },
     {
      "type": "text",
      "text": " ← "
     },
     {
      "type": "text",
      "marks": [
       {
