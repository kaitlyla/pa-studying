     }
    },
    "content": [
     {
      "type": "text",
      "text": "Example lateral cervical spine radiograph (severe, long-standing disease): "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "highlight",
        "attrs": {
         "hex": "FF0000"
        }
       }
      ],
      "text": "a rigid cervical spine, completely ankylosed (“bamboo spine”)"
     },
     {
      "type": "text",
      "text": " due to "
     },
     {
      "type": "text",
      "marks": [
       {
