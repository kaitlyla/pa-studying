       }
      ],
      "text": "Wandering atrial pacemaker:"
     },
     {
      "type": "text",
      "text": " the same irregularly irreg multifocal rhythm @ a rate ≤ 100"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
