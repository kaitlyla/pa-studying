     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "vs AF:"
     },
     {
      "type": "text",
      "text": " the presence of P waves distinguishes MAT from AF"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
