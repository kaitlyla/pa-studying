      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Conduction:"
     },
     {
      "type": "text",
      "text": " some P waves may not conduct; others may conduct aberrantly"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
