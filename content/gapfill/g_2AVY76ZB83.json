        }
       }
      ],
      "text": "Diffuse 1-3 mm “millet seed” nodules"
     },
     {
      "type": "text",
      "text": " → miliary TB (hematogenous)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
