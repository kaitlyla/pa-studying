     "borders": null,
     "marker": null
    },
    "content": [
     {
      "type": "text",
      "text": "Chaotic, irreg deflections w ⍉identifiable QRS complexes — STAT fatal w.o defib."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
