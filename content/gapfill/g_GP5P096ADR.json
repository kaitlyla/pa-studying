     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Intravaginal DHEA may relieve vaginal dryness and is effective for dyspareunia; no progestogen needed"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 18,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Ospemifene (oral): for dyspareunia when vaginal estrogen or DHEA can't be self-administered or an oral drug is preferred; may ↑ venous thrombosis risk"
     }
    ]
   }
  ]
 },
