           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "•signs of liver failure: asterixis · jaundice · mental status Δ"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
