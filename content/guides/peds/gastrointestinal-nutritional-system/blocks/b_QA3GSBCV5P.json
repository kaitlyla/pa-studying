           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "•children MC present w liver dz - teens & y/a ↑likely to present w neuro sxs"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
