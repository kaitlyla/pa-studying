           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "Based on clinical presentation, results of liver bx, & exclusion of other causes of cholestasis "
           }
          ]
         }
        ]
       },
       {
        "type": "table_cell",
        "attrs": {
         "colspan": 1,
         "rowspan": 1,
         "colwidth": null,
         "fill": "EAFFEE",
         "vAlign": "top",
         "borders": null
        },
        "content": [
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "marks": [
             {
              "type": "bold"
             }
            ],
            "text": "Supportive"
           },
           {
            "type": "text",
            "text": " "
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "•decreased fat absorption may lead to growth failure & vitamin deficiencies; increased nutritional supportive w/ concentrated calories, use of medium-chain-triglyceride-containing formulas, & provision of "
           },
           {
            "type": "text",
            "marks": [
             {
              "type": "bold"
             }
            ],
            "text": "fat-soluble vitamins ADEK"
           },
           {
            "type": "text",
            "text": " are indicated; TPN may be needed in growth remains problematic "
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "•"
           },
           {
            "type": "text",
            "marks": [
             {
              "type": "bold"
             },
             {
              "type": "color",
              "attrs": {
               "hex": "4472C4"
              }
             }
            ],
            "text": "Ursodeoxycholic acid"
           },
           {
            "type": "text",
            "text": ", a bile acid, is used to enhance bile flow & to reduce bile viscosity; not used until biliary obstruction has been excluded as a possibility "
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "•liver transplant may be necessary in cases of severe liver failure "
           }
          ]
         }
        ]
