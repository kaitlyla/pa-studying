            ],
            "text": "jaundice"
           },
           {
            "type": "text",
            "text": ", "
           },
           {
            "type": "text",
            "marks": [
             {
              "type": "bold"
             },
             {
              "type": "color",
              "attrs": {
               "hex": "ED7D31"
              }
             }
            ],
            "text": "acholic stools"
           },
           {
            "type": "text",
            "marks": [
             {
              "type": "color",
              "attrs": {
               "hex": "ED7D31"
              }
             }
            ],
            "text": " "
           },
           {
            "type": "text",
            "text": "→ liver failure, cirrhosis, portal HTN "
