           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "Presenting features in the first week of life include "
           },
           {
            "type": "text",
            "marks": [
             {
              "type": "bold"
             },
             {
              "type": "color",
              "attrs": {
               "hex": "ED7D31"
              }
             }
            ],
            "text": "jaundice & hepatomegaly"
           },
           {
            "type": "text",
            "text": " in 50% of pts "
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "•FTT & more significant liver disease occurring later in infancy in 33% of pts "
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          }
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "The course of the disease is generally self-limited, with full recovery during infancy in as many as 70% of pts "
           }
          ]
         }
        ]
       },
