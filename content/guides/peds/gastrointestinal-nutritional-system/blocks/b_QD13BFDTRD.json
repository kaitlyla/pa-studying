           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "Incidence is 1/5,000-10,000 live births, "
           },
           {
            "type": "text",
            "marks": [
             {
              "type": "bold"
             }
            ],
            "text": "MC in males"
           },
           {
