           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "Gilbert:"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "•intermittent jaundice (scleral icterus) during episodes = predominant sx - aSx b/n episodes"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "•nonspecific: malaise · abd discomfort · fatigue"
           }
          ]
         }
        ]
       },
       {
        "type": "table_cell",
        "attrs": {
         "colspan": 1,
