           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "•duodenal obstruct w dilated stomach & prox duodenum or beak appearance if volvulus (⍉evident on plain XR)"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
