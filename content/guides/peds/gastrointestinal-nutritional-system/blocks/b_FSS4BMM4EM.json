          },
          "content": [
           {
            "type": "text",
            "text": "Stable pts → further imaging to establish dx"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
