          },
          "content": [
           {
            "type": "text",
            "text": "AXR first: r/o perf & emergent need for surg exploration - double bubble sign w distal gas present"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
