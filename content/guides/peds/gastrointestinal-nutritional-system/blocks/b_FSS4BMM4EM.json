          },
          "content": [
           {
            "type": "text",
            "text": "Disturbed development of the norm embryonic gut → malrotation of intestine"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "•often w.in first yr of life"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "•assoc: congenital diaphragmatic hernia (almost all pts) · congenital heart dz (ex, heterotaxy syndrome) · omphalocele"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "•volvulus = intestine twists on itself - can cause intestinal obstruct but ⍉MCC @ 6-36mo (intussusception = MC)"
           }
          ]
         }
        ]
       },
       {
        "type": "table_cell",
        "attrs": {
         "colspan": 1,
         "rowspan": 1,
         "colwidth": null,
