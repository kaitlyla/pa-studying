            "marks": [
             {
              "type": "bold"
             }
            ],
            "text": "•lactose foods: milk · ice cream · cheese · yogurt · butter"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
