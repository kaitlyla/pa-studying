          "content": [
           {
            "type": "text",
            "text": "•MC neuro d/o in early childhood - up to 4% of children <5yo"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
