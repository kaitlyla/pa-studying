           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "•strong genetic predisposition · high risk of recurrence (up to ⅓ have more) but low risk of future epilepsy (rarely → epilepsy in adulthood)"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
