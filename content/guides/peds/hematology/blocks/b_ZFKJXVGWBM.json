          "text": "o",
          "font": "Courier New",
          "marks": [],
          "tabPt": 18
         }
        },
        "content": [
         {
          "type": "text",
          "text": "B12 is a cofactor in the metabolism of MMA & homocysteine, & both are therefore "
         },
         {
          "type": "text",
          "marks": [
           {
            "type": "highlight",
            "attrs": {
             "hex": "FFFF00"
