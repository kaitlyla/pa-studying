        },
        "content": [
         {
          "type": "text",
          "marks": [
           {
            "type": "bold"
           }
          ],
          "text": "Vitamin K Deficiency"
         },
         {
          "type": "text",
          "text": ": factor V normal, factor VII ↓, factor VIII normal, factor X ↓"
         }
        ]
       },
       {
        "type": "paragraph",
        "attrs": {
         "indLeft": 0,
         "indRight": 0,
         "indFirst": 0,
         "spaceBefore": 0,
         "spaceAfter": 0,
         "line": null,
         "align": "left",
         "shade": null,
         "borders": null,
         "marker": null
        },
        "content": [
         {
          "type": "text",
          "marks": [
           {
            "type": "bold"
           }
          ],
          "text": "Liver Disease"
         },
         {
          "type": "text",
          "text": ": factor V ↓, factor VII ↓, factor VIII normal, factor X ↓"
         }
        ]
       },
       {
        "type": "paragraph",
        "attrs": {
         "indLeft": 0,
         "indRight": 0,
         "indFirst": 0,
         "spaceBefore": 0,
         "spaceAfter": 0,
         "line": null,
