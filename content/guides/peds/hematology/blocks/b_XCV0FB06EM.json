         "borders": null,
         "marker": null
        },
        "content": [
         {
          "type": "text",
          "marks": [
           {
            "type": "bold"
           }
          ],
          "text": "DIC"
         },
         {
          "type": "text",
          "text": ": factor V, factor VII, factor VIII, factor X all ↓"
         }
        ]
       },
