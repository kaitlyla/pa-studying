            "attrs": {
             "style": "single"
            }
           }
          ],
          "text": "Disorders of Primary Hemostasis"
         },
         {
          "type": "text",
          "text": ":"
         }
        ]
       },
       {
        "type": "paragraph",
        "attrs": {
         "indLeft": 18,
         "indRight": 0,
         "indFirst": -18,
         "spaceBefore": 0,
         "spaceAfter": 0,
         "line": null,
         "align": "left",
         "shade": null,
         "borders": null,
         "marker": {
          "text": "•",
          "font": null,
          "marks": [],
          "tabPt": 18
         }
        },
        "content": [
         {
          "type": "text",
          "text": "Primary Hemostasis → formation of weak platelet plus; "
         },
         {
          "type": "text",
          "marks": [
           {
            "type": "highlight",
            "attrs": {
             "hex": "FFFF00"
            }
           }
          ],
          "text": "mucocutaneous bleeding"
         }
        ]
       },
       {
        "type": "paragraph",
        "attrs": {
         "indLeft": 18,
         "indRight": 0,
         "indFirst": -18,
         "spaceBefore": 0,
         "spaceAfter": 0,
         "line": null,
         "align": "left",
         "shade": null,
         "borders": null,
         "marker": {
          "text": "•",
          "font": null,
          "marks": [],
          "tabPt": 18
         }
        },
        "content": [
         {
          "type": "text",
          "text": "Primary hemostatic problems usually cause "
         },
         {
          "type": "text",
          "marks": [
           {
            "type": "bold"
           },
           {
            "type": "color",
            "attrs": {
             "hex": "ED7D31"
            }
           }
          ],
          "text": "petechiae"
         },
         {
          "type": "text",
          "marks": [
           {
            "type": "color",
            "attrs": {
             "hex": "ED7D31"
            }
           }
          ],
          "text": " "
         },
         {
          "type": "text",
          "text": "(pinpoint superficial skin bleeds), "
         },
         {
          "type": "text",
          "marks": [
           {
            "type": "bold"
           },
           {
            "type": "color",
            "attrs": {
             "hex": "ED7D31"
            }
           }
          ],
          "text": "anterior epistaxis"
         },
         {
          "type": "text",
          "marks": [
           {
            "type": "color",
            "attrs": {
             "hex": "ED7D31"
            }
           }
          ],
          "text": " "
         },
         {
          "type": "text",
          "text": "(mild nosebleeds), immediate bleeding after surgical procedures (e.g., tooth extraction), or bleeding from mucosal surfaces (e.g., gingival, GI, vaginal)"
         }
        ]
       },
       {
        "type": "paragraph",
        "attrs": {
         "indLeft": 0,
         "indRight": 0,
         "indFirst": 0,
         "spaceBefore": 0,
         "spaceAfter": 0,
         "line": null,
         "align": "left",
         "shade": null,
         "borders": null,
         "marker": null
        },
        "content": [
         {
          "type": "text",
          "marks": [
           {
            "type": "bold"
           },
           {
            "type": "underline",
            "attrs": {
             "style": "single"
            }
           }
          ],
          "text": "Disorders of Secondary Hemostasis"
         },
         {
          "type": "text",
          "text": ":"
         }
        ]
       },
       {
        "type": "paragraph",
        "attrs": {
         "indLeft": 18,
         "indRight": 0,
         "indFirst": -18,
         "spaceBefore": 0,
         "spaceAfter": 0,
         "line": null,
         "align": "left",
         "shade": null,
         "borders": null,
         "marker": {
          "text": "•",
          "font": null,
          "marks": [],
          "tabPt": 18
         }
        },
        "content": [
         {
          "type": "text",
          "text": "Secondary Hemostasis → problems w/ coagulation factors; "
         },
         {
          "type": "text",
          "marks": [
           {
            "type": "highlight",
            "attrs": {
             "hex": "FFFF00"
            }
           }
          ],
          "text": "deep tissue bleeding"
         }
        ]
       },
       {
        "type": "paragraph",
        "attrs": {
         "indLeft": 18,
         "indRight": 0,
         "indFirst": -18,
         "spaceBefore": 0,
         "spaceAfter": 0,
         "line": null,
         "align": "left",
         "shade": null,
         "borders": null,
         "marker": {
          "text": "•",
          "font": null,
          "marks": [],
          "tabPt": 18
         }
        },
        "content": [
         {
          "type": "text",
          "text": "Secondary hemostatic problems cause large bruises ("
         },
         {
          "type": "text",
          "marks": [
           {
            "type": "bold"
           },
           {
            "type": "color",
            "attrs": {
             "hex": "ED7D31"
            }
           }
          ],
          "text": "ecchymoses"
         },
         {
          "type": "text",
          "text": "), deep tissue hematomas or "
         },
         {
          "type": "text",
          "marks": [
           {
            "type": "bold"
           },
           {
            "type": "color",
            "attrs": {
             "hex": "ED7D31"
            }
           }
          ],
          "text": "hemarthrosis"
         },
         {
          "type": "text",
          "marks": [
           {
            "type": "color",
            "attrs": {
             "hex": "ED7D31"
            }
           }
          ],
          "text": " "
         },
         {
          "type": "text",
          "text": "(bleeding inside the joint space), "
         },
         {
          "type": "text",
          "marks": [
           {
            "type": "bold"
           },
           {
            "type": "color",
            "attrs": {
             "hex": "ED7D31"
            }
           }
          ],
          "text": "posterior epistaxis"
         },
         {
          "type": "text",
          "marks": [
           {
            "type": "color",
            "attrs": {
             "hex": "ED7D31"
            }
           }
          ],
          "text": " "
         },
         {
          "type": "text",
          "text": "(severe nosebleeds), persistent bleeding after surgical procedures, or intracerebral hemorrhage "
         }
        ]
       },
       {
        "type": "paragraph",
        "attrs": {
         "indLeft": 0,
         "indRight": 0,
         "indFirst": 0,
         "spaceBefore": 0,
         "spaceAfter": 0,
         "line": null,
         "align": "left",
         "shade": null,
         "borders": null,
         "marker": null
        },
        "content": [
         {
          "type": "text",
          "marks": [
           {
            "type": "bold"
           }
          ],
          "text": "↓ platelet number"
         },
         {
          "type": "text",
          "text": ": thrombocytopenia; can be caused by decreased production, increased destruction, or sequestration "
         }
        ]
       },
       {
        "type": "paragraph",
        "attrs": {
         "indLeft": 36,
         "indRight": 0,
         "indFirst": -18,
         "spaceBefore": 0,
         "spaceAfter": 0,
         "line": null,
         "align": "left",
         "shade": null,
         "borders": null,
         "marker": {
          "text": "•",
          "font": null,
          "marks": [],
          "tabPt": 18
         }
        },
        "content": [
         {
          "type": "text",
          "marks": [
           {
            "type": "underline",
            "attrs": {
             "style": "single"
            }
           }
          ],
          "text": "Increased destruction"
         },
         {
          "type": "text",
          "text": ": IPT, DIC, HUS, TTP, meds (aspirin, nitrofurantoin, heparin, NSAIDs, sulfonamides, penicillin, digoxin, procainamide, methyldopa, phenytoin, valproic acid, barbiturates, cimetidine, ranitidine)"
         }
        ]
       },
       {
        "type": "paragraph",
        "attrs": {
         "indLeft": 36,
         "indRight": 0,
         "indFirst": -18,
         "spaceBefore": 0,
         "spaceAfter": 0,
         "line": null,
         "align": "left",
         "shade": null,
         "borders": null,
         "marker": {
          "text": "•",
          "font": null,
          "marks": [],
          "tabPt": 18
         }
        },
        "content": [
         {
          "type": "text",
          "marks": [
           {
            "type": "underline",
            "attrs": {
             "style": "single"
            }
           }
          ],
          "text": "Decreased production"
         },
         {
          "type": "text",
          "text": ": trisomy 13 & 18, ALL, lymphomas, aplastic anemia, meds (thiazide diuretics, chemo drugs, alcoholism, estrogen, furosemide, TMP-SMX), infections (CMV, EBV, varicella, rubella, rubeola, mumps, parvovirus B19, TB, typhoid)"
         }
        ]
       },
       {
        "type": "paragraph",
        "attrs": {
         "indLeft": 36,
         "indRight": 0,
         "indFirst": -18,
         "spaceBefore": 0,
         "spaceAfter": 0,
         "line": null,
         "align": "left",
         "shade": null,
         "borders": null,
         "marker": {
          "text": "•",
          "font": null,
          "marks": [],
          "tabPt": 18
         }
        },
        "content": [
         {
          "type": "text",
          "marks": [
           {
            "type": "underline",
            "attrs": {
             "style": "single"
            }
           }
          ],
          "text": "Sequestration"
         },
         {
          "type": "text",
          "text": ": splenomegaly, hypothermia, burns "
         }
        ]
       },
       {
        "type": "paragraph",
        "attrs": {
         "indLeft": 0,
         "indRight": 0,
         "indFirst": 0,
         "spaceBefore": 0,
         "spaceAfter": 0,
         "line": null,
         "align": "left",
         "shade": null,
         "borders": null,
         "marker": null
        },
        "content": [
         {
          "type": "text",
          "marks": [
           {
            "type": "bold"
           }
          ],
          "text": "↓ platelet function"
         },
         {
          "type": "text",
          "text": ": Von Willebrand Disease, Bernard-Soulier Disease, Glanzmann thrombasthenia, uremic platelet dysfunction (CKD), meds (aspirin, NSAIDs, clopidogrel)"
         }
        ]
       },
       {
        "type": "paragraph",
        "attrs": {
         "indLeft": 0,
         "indRight": 0,
         "indFirst": 0,
         "spaceBefore": 0,
         "spaceAfter": 0,
         "line": null,
         "align": "left",
         "shade": null,
         "borders": null,
         "marker": null
        },
        "content": [
         {
          "type": "text",
          "marks": [
           {
            "type": "bold"
           }
          ],
          "text": "↓ clotting factors"
         },
         {
          "type": "text",
          "text": ": anticoagulant meds (heparin, warfarin), hemophilia, liver cirrhosis, vitamin K deficiency, DIC "
         }
        ]
       },
       {
        "type": "paragraph",
        "attrs": {
         "indLeft": 0,
         "indRight": 0,
         "indFirst": 0,
         "spaceBefore": 0,
         "spaceAfter": 0,
         "line": null,
         "align": "left",
         "shade": null,
         "borders": null,
         "marker": null
        }
       },
       {
        "type": "paragraph",
        "attrs": {
         "indLeft": 0,
         "indRight": 0,
         "indFirst": 0,
         "spaceBefore": 0,
         "spaceAfter": 0,
         "line": null,
         "align": "left",
         "shade": null,
         "borders": null,
         "marker": null
        },
        "content": [
         {
          "type": "text",
          "marks": [
           {
            "type": "bold"
           }
          ],
          "text": "Activated Partial Thromboplastin Time (aPTT)"
         },
         {
          "type": "text",
          "text": ": measures intrinsic (5, 8, 9, 10, 11, 12, fibrinogen, prothrombin)"
         }
        ]
       },
       {
        "type": "paragraph",
        "attrs": {
         "indLeft": 0,
         "indRight": 0,
         "indFirst": 0,
         "spaceBefore": 0,
         "spaceAfter": 0,
         "line": null,
         "align": "left",
         "shade": null,
         "borders": null,
         "marker": null
        },
        "content": [
         {
          "type": "text",
          "marks": [
           {
            "type": "bold"
           }
          ],
          "text": "Prothrombin Time (PT)"
         },
         {
          "type": "text",
          "text": ": measures extrinsic (5, 7, 10, fibrinogen, prothrombin)"
         }
        ]
       },
       {
        "type": "paragraph",
        "attrs": {
         "indLeft": 0,
         "indRight": 0,
         "indFirst": 0,
         "spaceBefore": 0,
         "spaceAfter": 0,
         "line": null,
         "align": "left",
         "shade": null,
         "borders": null,
         "marker": null
        }
       },
       {
        "type": "paragraph",
        "attrs": {
