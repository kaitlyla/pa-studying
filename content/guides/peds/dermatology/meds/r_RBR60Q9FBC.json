         "shade": null,
         "borders": null,
         "marker": null
        },
        "content": [
         {
          "type": "text",
          "text": "-    prevents cervical CA (high-risk types) - recommended for males + females @ 11 or 12 yo"
         }
        ]
       },
       {
        "type": "paragraph",
        "attrs": {
         "indLeft": 36,
         "indRight": 0,
         "indFirst": -18,
         "spaceBefore": 0,
