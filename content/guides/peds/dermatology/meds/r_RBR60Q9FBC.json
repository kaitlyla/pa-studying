         "marker": null
        },
        "content": [
         {
          "type": "text",
          "text": "-    2-dose schedule for pts <15 yo - 3-dose schedule for pts ≥15 yo"
         }
        ]
       },
       {
        "type": "paragraph",
        "attrs": {
         "indLeft": 36,
         "indRight": 0,
         "indFirst": -18,
         "spaceBefore": 0,
