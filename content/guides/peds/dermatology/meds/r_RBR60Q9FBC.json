        "content": [
         {
          "type": "text",
          "text": "-    9vHPV vax used in the US - protects against HPV 6 · 11 · 16 · 18 · 31 · 33 · 45 · 52 + 58"
         }
        ]
       },
       {
        "type": "paragraph",
        "attrs": {
         "indLeft": 36,
         "indRight": 0,
