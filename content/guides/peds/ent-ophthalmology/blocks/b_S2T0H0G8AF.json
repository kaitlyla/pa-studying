          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "White cotton-like plaques on tongue · oral mucosa · inner cheeks · palate · oropharynx - easily scraped off w tongue depressor · bleed easily · erythematous base"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "ASx (infants may refuse to eat ← pain) or dysgeusia · dysphagia · pain w eating"
           }
          ]
         }
        ]
