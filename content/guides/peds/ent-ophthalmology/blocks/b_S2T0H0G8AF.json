          "content": [
           {
            "type": "text",
            "text": "•1-11mo: nystatin susp QID x7-14d - stop 2-3d after lesions resolve"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
