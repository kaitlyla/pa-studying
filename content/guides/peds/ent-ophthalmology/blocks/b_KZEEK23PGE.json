     "shade": null,
     "borders": null,
     "marker": null
    },
    "content": [
     {
      "type": "text",
      "text": "Hearing loss can be classified as "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "conductive, sensorineural, or both"
     },
     {
      "type": "text",
      "text": " (mixed loss); "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "underline",
        "attrs": {
         "style": "single"
        }
       }
      ],
      "text": "TX"
     },
     {
      "type": "text",
      "text": ": treat underlying cause, hearing aids, cochlear implants, surgery "
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": null
    },
    "content": [
     {
      "type": "text",
      "text": "•"
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "shade",
        "attrs": {
         "hex": "F7CAAC"
        }
       }
      ],
      "text": "MCC of conductive loss is otitis media"
     },
     {
      "type": "text",
      "text": "; others include "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "italic"
       }
      ],
      "text": "cerumen impaction"
     },
     {
      "type": "text",
      "text": ", otitis externa, "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "italic"
       }
      ],
      "text": "exostoses"
     },
     {
      "type": "text",
      "text": " (bony outgrowths of external auditory canal related to cold water exposure), TM perforation, otosclerosis, neoplasms "
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 0,
