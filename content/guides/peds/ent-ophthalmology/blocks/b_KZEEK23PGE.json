      "marks": [
       {
        "type": "bold"
       },
       {
        "type": "shade",
        "attrs": {
         "hex": "F7CAAC"
        }
       }
      ],
      "text": "MCC of sensorineural loss is presbycusis"
     },
     {
      "type": "text",
      "text": " (gradual, symmetrical loss associated w/ age); others include noise-induced, infection, drug-induced, congenital, Meniere disease, CNS lesions"
     }
