         "align": "left",
         "shade": null,
         "borders": null,
         "marker": null
        },
        "content": [
         {
          "type": "text",
          "text": "-    CAP: doxycycline covers typical + atypical organisms where S. pneumoniae resistance rate = acceptable"
         }
        ]
       },
       {
        "type": "paragraph",
        "attrs": {
         "indLeft": 0,
         "indRight": 0,
         "indFirst": 0,
         "spaceBefore": 0,
         "spaceAfter": 0,
         "line": null,
         "align": "left",
         "shade": null,
         "borders": null,
         "marker": null
        },
        "content": [
         {
          "type": "text",
          "text": "-    Lyme: doxycycline for early dz & late arthritis (amoxicillin · cefuroxime = alts) - children: amoxicillin or doxycycline if <21d - preg: amoxicillin - prophylaxis: single-dose doxycycline if Ixodes · attached ≥36h · w.in 72h of removal"
         }
        ]
       }
      ]
     }
