          "content": [
           {
            "type": "text",
            "text": "•met acidosis: "
           },
           {
            "type": "text",
            "marks": [
             {
              "type": "bold"
             }
            ],
            "text": "venous pH <7.3 or serum HCO3 <18mEq/L"
