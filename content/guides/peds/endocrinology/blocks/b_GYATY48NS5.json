           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "•irritability · lethargy · anorexia · N/V · vague abd pain"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
