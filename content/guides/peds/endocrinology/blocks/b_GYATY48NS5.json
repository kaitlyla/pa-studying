           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "•polyuria · polydipsia · fatigue · wt loss · nocturnal enuresis"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
