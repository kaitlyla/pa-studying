           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "•ketosis: blood ketones (β-hydroxybutyrate >3mmol/L) or mod/large urine ketones"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
