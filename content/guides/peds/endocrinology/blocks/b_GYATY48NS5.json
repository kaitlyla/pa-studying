           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "•Na usually ↓ - total body Na deficit ~5-13mmol/kg - hyperglycemia draws water ICF → ECF - Na ↓1.6mmol/L per 100mg/dL glucose >100"
           }
          ]
         },
         {
          "type": "paragraph",
