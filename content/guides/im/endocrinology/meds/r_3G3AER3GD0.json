              "content": [
               {
                "type": "text",
                "text": "•block sodium/Cl reabsorb in the thick ascending loop of Henle by interfering w/ the chloride-binding co-transport system "
               }
              ]
             },
             {
              "type": "paragraph",
              "attrs": {
               "indLeft": 0,
               "indRight": 0,
               "indFirst": 0,
               "spaceBefore": 0,
