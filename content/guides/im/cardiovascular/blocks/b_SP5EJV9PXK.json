            ],
            "text": "Etiology"
           },
           {
            "type": "text",
            "text": ": at least 1 episode of acute rheumatic fever from group A streptococci "
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
