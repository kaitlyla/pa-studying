          "content": [
           {
            "type": "text",
            "marks": [
             {
              "type": "underline",
              "attrs": {
               "style": "single"
              }
             }
            ],
            "text": "PATHO"
           },
           {
            "type": "text",
            "text": ": cumulative inflammation & scarring of the heart valves resulting from an abnormal immune response to group A streptococci "
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "•molecular mimicry between streptococcal M protein & cardiac proteins "
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "•cross-reaction of antibodies to streptococcal M protein w/ self-antigens "
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "•immune-mediated (type II) hypersensitivity "
           }
          ]
         }
        ]
