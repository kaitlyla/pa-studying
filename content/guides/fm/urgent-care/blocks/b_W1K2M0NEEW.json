           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "•sudden episode of coughing or choking"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
