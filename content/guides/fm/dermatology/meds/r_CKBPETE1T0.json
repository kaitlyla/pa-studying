                  "attrs": {
                   "style": "single"
                  }
                 }
                ],
                "text": "Physiologic Actions of Cortisol"
               },
               {
                "type": "text",
                "text": ":"
               }
              ]
             },
             {
              "type": "paragraph",
              "attrs": {
               "indLeft": 0,
               "indRight": 0,
               "indFirst": 0,
               "spaceBefore": 0,
               "spaceAfter": 0,
               "line": null,
               "align": "left",
               "shade": null,
               "borders": null,
               "marker": null
              },
              "content": [
               {
                "type": "text",
                "text": "Metabolism:"
               }
              ]
             },
             {
              "type": "paragraph",
              "attrs": {
               "indLeft": 18,
               "indRight": 0,
               "indFirst": -18,
               "spaceBefore": 0,
               "spaceAfter": 0,
               "line": null,
               "align": "left",
               "shade": null,
               "borders": null,
               "marker": {
                "text": "•",
                "font": null,
                "marks": [],
                "tabPt": 18
               }
              },
              "content": [
               {
                "type": "text",
                "text": "Increases BG, increases protein catabolism from muscle/bone, antagonist of insulin "
               }
              ]
             },
             {
              "type": "paragraph",
              "attrs": {
               "indLeft": 0,
               "indRight": 0,
               "indFirst": 0,
               "spaceBefore": 0,
               "spaceAfter": 0,
               "line": null,
               "align": "left",
               "shade": null,
               "borders": null,
               "marker": null
              },
              "content": [
               {
                "type": "text",
                "text": "Anti-inflammatory:"
               }
              ]
             },
             {
              "type": "paragraph",
              "attrs": {
               "indLeft": 18,
               "indRight": 0,
               "indFirst": -18,
               "spaceBefore": 0,
               "spaceAfter": 0,
               "line": null,
               "align": "left",
               "shade": null,
               "borders": null,
               "marker": {
                "text": "•",
                "font": null,
                "marks": [],
                "tabPt": 18
               }
              },
              "content": [
               {
                "type": "text",
                "text": "Inhibits number/activity of cells involved in inflammatory response"
               }
              ]
             },
             {
              "type": "paragraph",
              "attrs": {
               "indLeft": 18,
               "indRight": 0,
               "indFirst": -18,
               "spaceBefore": 0,
               "spaceAfter": 0,
               "line": null,
               "align": "left",
               "shade": null,
               "borders": null,
               "marker": {
                "text": "•",
                "font": null,
                "marks": [],
                "tabPt": 18
               }
              },
              "content": [
               {
                "type": "text",
                "text": "Inhibits fibroblast proliferation & scar formation"
               }
              ]
             },
             {
              "type": "paragraph",
              "attrs": {
               "indLeft": 18,
               "indRight": 0,
               "indFirst": -18,
               "spaceBefore": 0,
               "spaceAfter": 0,
               "line": null,
               "align": "left",
               "shade": null,
               "borders": null,
               "marker": {
                "text": "•",
                "font": null,
                "marks": [],
                "tabPt": 18
               }
              },
              "content": [
               {
                "type": "text",
                "text": "Decreases capillary permeability & local edema"
               }
              ]
             },
             {
              "type": "paragraph",
              "attrs": {
               "indLeft": 18,
               "indRight": 0,
               "indFirst": -18,
               "spaceBefore": 0,
               "spaceAfter": 0,
               "line": null,
               "align": "left",
               "shade": null,
               "borders": null,
               "marker": {
                "text": "•",
                "font": null,
                "marks": [],
                "tabPt": 18
               }
              },
              "content": [
               {
                "type": "text",
                "text": "Inhibits histamine release from mast cells"
               }
              ]
             },
             {
              "type": "paragraph",
              "attrs": {
               "indLeft": 18,
               "indRight": 0,
               "indFirst": -18,
               "spaceBefore": 0,
               "spaceAfter": 0,
               "line": null,
               "align": "left",
               "shade": null,
               "borders": null,
               "marker": {
                "text": "•",
                "font": null,
                "marks": [],
                "tabPt": 18
               }
              },
              "content": [
               {
                "type": "text",
                "text": "Stabilizes lysosomal membranes "
               }
              ]
             },
             {
              "type": "paragraph",
              "attrs": {
               "indLeft": 0,
               "indRight": 0,
               "indFirst": 0,
               "spaceBefore": 0,
               "spaceAfter": 0,
               "line": null,
               "align": "left",
               "shade": null,
               "borders": null,
               "marker": null
              },
              "content": [
               {
                "type": "text",
                "text": "Immunosuppression"
               }
              ]
             },
             {
              "type": "paragraph",
              "attrs": {
               "indLeft": 0,
               "indRight": 0,
               "indFirst": 0,
               "spaceBefore": 0,
               "spaceAfter": 0,
               "line": null,
               "align": "left",
               "shade": null,
               "borders": null,
               "marker": null
              },
              "content": [
               {
                "type": "text",
                "text": "Mineralocorticoid effects: salt/water retention, potassium loss"
               }
              ]
             }
            ]
