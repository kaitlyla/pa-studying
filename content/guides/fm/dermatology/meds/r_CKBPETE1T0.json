               "align": "left",
               "shade": null,
               "borders": null,
               "marker": null
              },
              "content": [
               {
                "type": "text",
                "text": "•Replacement therapy: adrenal insufficiency (Addison's disease) and congenital adrenal hyperplasia (defects in enzymes for steroid hormone synthesis)"
               }
              ]
             },
             {
              "type": "paragraph",
              "attrs": {
               "indLeft": 0,
               "indRight": 0,
               "indFirst": 0,
               "spaceBefore": 0,
               "spaceAfter": 0,
               "line": null,
               "align": "left",
               "shade": null,
               "borders": null,
               "marker": null
              },
              "content": [
               {
                "type": "text",
                "text": "•Dexamethasone suppression test (DST): diagnosis of Cushing’s syndrome"
               }
              ]
             },
             {
              "type": "paragraph",
              "attrs": {
               "indLeft": 0,
               "indRight": 0,
               "indFirst": 0,
               "spaceBefore": 0,
               "spaceAfter": 0,
               "line": null,
               "align": "left",
               "shade": null,
               "borders": null,
               "marker": null
              },
              "content": [
               {
                "type": "text",
                "text": "•Treatment of chronic inflammatory diseases:  RA, ulcerative colitis, asthma, SLE, eye and skin inflammation"
               }
              ]
             },
             {
              "type": "paragraph",
              "attrs": {
               "indLeft": 0,
               "indRight": 0,
               "indFirst": 0,
               "spaceBefore": 0,
               "spaceAfter": 0,
               "line": null,
               "align": "left",
               "shade": null,
               "borders": null,
               "marker": null
              },
              "content": [
               {
                "type": "text",
                "text": "•Treatment of allergic reactions: drug, serum, and transfusion reactions"
               }
              ]
             },
             {
              "type": "paragraph",
              "attrs": {
               "indLeft": 0,
               "indRight": 0,
               "indFirst": 0,
               "spaceBefore": 0,
               "spaceAfter": 0,
               "line": null,
               "align": "left",
               "shade": null,
               "borders": null,
               "marker": null
              },
              "content": [
               {
                "type": "text",
                "text": "•Immunosuppression: prevention of graft rejection after transplantation"
               }
              ]
             },
