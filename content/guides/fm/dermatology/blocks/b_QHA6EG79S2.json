           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "▪︎chronic, benign inflammatory dz; fairly common, w/ high negative psychosocial impact"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
