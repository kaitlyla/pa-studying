           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "▪︎relapses triggered by: strep infection, psych stress, smoking, alcohol, obesity, skin trauma, + meds (lithium, antimalarials, NSAIDs)"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
