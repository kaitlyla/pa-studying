          },
          "content": [
           {
            "type": "text",
            "text": "▪︎acute immune-mediated polyneuropathy; autoimmune neuromuscular d/o → damage to myelin sheath of nerve cells"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "▪︎C. jejuni = MC identified precipitant (follows respiratory or GI illness)"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "▪︎immune response to preceding infection → cross-reacts w/ peripheral nerve components d/t molecular mimicry → demyelination"
           }
          ]
         }
        ]
       },
       {
        "type": "table_cell",
        "attrs": {
         "colspan": 1,
         "rowspan": 1,
