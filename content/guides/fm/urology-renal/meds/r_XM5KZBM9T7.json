         "shade": null,
         "borders": null,
         "marker": null
        },
        "content": [
         {
          "type": "text",
          "text": "•hepatotoxic, photosensitivity, Pseudotumor cerebri "
         }
        ]
       },
       {
        "type": "paragraph",
        "attrs": {
