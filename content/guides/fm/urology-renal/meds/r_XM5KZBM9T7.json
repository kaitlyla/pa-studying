            "attrs": {
             "style": "single"
            }
           }
          ],
          "text": "Contraindications"
         },
         {
          "type": "text",
          "text": ": preg, renal impairment (except Doxycycline)"
         }
        ]
       },
       {
        "type": "paragraph",
        "attrs": {
         "indLeft": 0,
