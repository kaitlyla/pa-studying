         "borders": null,
         "marker": null
        },
        "content": [
         {
          "type": "text",
          "text": "•broad spectrum of activity – good against gram (+), gram (-), atypical organisms, & organisms other than bacteria "
         }
        ]
       },
       {
        "type": "paragraph",
        "attrs": {
         "indLeft": 0,
