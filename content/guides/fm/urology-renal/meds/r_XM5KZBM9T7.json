         "marker": null
        },
        "content": [
         {
          "type": "text",
          "text": "•poor GI tolerance: may cause diarrhea & gastritis "
         }
        ]
       },
       {
        "type": "paragraph",
        "attrs": {
         "indLeft": 0,
         "indRight": 0,
         "indFirst": 0,
         "spaceBefore": 0,
         "spaceAfter": 0,
         "line": null,
         "align": "left",
         "shade": null,
         "borders": null,
         "marker": null
        },
        "content": [
         {
          "type": "text",
          "text": "•deposition in calcified tissue: deposition in teeth → teeth discoloration & may affect growth (⍉USU given in children <8yo for >21d)"
         }
        ]
       },
       {
        "type": "paragraph",
        "attrs": {
         "indLeft": 0,
         "indRight": 0,
         "indFirst": 0,
         "spaceBefore": 0,
         "spaceAfter": 0,
         "line": null,
