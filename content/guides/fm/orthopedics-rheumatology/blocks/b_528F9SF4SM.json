            "marks": [
             {
              "type": "bold"
             }
            ],
            "text": "*Plantar Fasciitis"
           }
          ]
         }
        ]
       },
       {
        "type": "table_cell",
        "attrs": {
         "colspan": 1,
         "rowspan": 1,
         "colwidth": null,
         "fill": "DDFBFD",
         "vAlign": "top",
         "borders": null
        },
        "content": [
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "marks": [
             {
              "type": "underline",
              "attrs": {
               "style": "single"
              }
             }
            ],
            "text": "Mech"
           },
           {
            "type": "text",
            "text": ": inflam & microscopic tears of the plantar fascia ← overuse (esp. in pts w/ flat ft, ↑arches, or heel spurs) "
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "▪︎"
           },
           {
            "type": "text",
            "marks": [
             {
              "type": "bold"
             }
            ],
            "text": "MC in females"
           },
           {
            "type": "text",
            "text": ", 40-60yrs, older, obese "
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "▪︎leading cause of heel pain in the US"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "▪︎plantar fascia = connective tissue band on the plantar surface of the foot, from the calcaneus to the tendons of the forefoot + proximal phalanges"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "▪︎repetitive microtears → degeneration, thickening, + inflammation"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "▪︎RFs: prolonged standing or walking, obesity, poorly fitted shoes, flat feet or high arches, improper gait (eg excessive pronation), limb length discrepancy, tight Achilles tendon, gastrocnemius, or intrinsic foot muscles"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "▪︎also: excessive training (esp a sudden ⇡ in distance run), faulty running shoes, running on unyielding surfaces, limited ankle dorsiflexion"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "▪︎usually resolves spontaneously w/in 1 yr regardless of tx"
           }
          ]
         }
        ]
       },
       {
        "type": "table_cell",
        "attrs": {
         "colspan": 1,
         "rowspan": 1,
         "colwidth": null,
         "fill": "DDFBFD",
         "vAlign": "top",
         "borders": null
        },
        "content": [
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "marks": [
             {
              "type": "underline",
              "attrs": {
               "style": "single"
              }
             }
            ],
            "text": "S/SXS"
           },
           {
            "type": "text",
            "text": ": I. heel pain (often sharp) worse after period of rest (AM) & gradually ⇣ throughout the day w/ activity, walking, stretching"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "▪︎may return in PM after prolonged wt bearing  "
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "▪︎"
           },
           {
            "type": "text",
            "marks": [
             {
              "type": "bold"
             },
             {
              "type": "color",
              "attrs": {
               "hex": "942093"
              }
             }
            ],
            "text": "local point tenderness"
           },
           {
            "type": "text",
            "marks": [
             {
              "type": "color",
              "attrs": {
               "hex": "942093"
              }
             }
            ],
            "text": " "
           },
           {
            "type": "text",
            "text": "to the underside of the heel"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "▪︎"
           },
           {
            "type": "text",
            "marks": [
             {
              "type": "bold"
             },
             {
              "type": "color",
              "attrs": {
               "hex": "942093"
              }
             }
            ],
            "text": "pain "
           },
           {
            "type": "text",
            "marks": [
             {
              "type": "color",
              "attrs": {
               "hex": "942093"
              }
             }
            ],
            "text": "⇡"
           },
           {
            "type": "text",
            "marks": [
             {
              "type": "bold"
             },
             {
              "type": "color",
              "attrs": {
               "hex": "942093"
              }
             }
            ],
            "text": " w/ dorsiflexion of toes"
           },
           {
            "type": "text",
            "marks": [
             {
              "type": "color",
              "attrs": {
               "hex": "942093"
              }
             }
            ],
            "text": " "
           },
           {
            "type": "text",
            "text": "(stretching of the plantar fascia) "
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "▪︎poststatic dyskinesia = heel pain upon rising after a period of immobility that resolves w/ movement"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "▪︎PE: tenderness to the medial plantar calcaneal region, tight Achilles tendon or gastrocnemius; may see excessive pronation w/ ambulation"
           }
          ]
         }
        ]
       },
       {
        "type": "table_cell",
        "attrs": {
         "colspan": 1,
         "rowspan": 1,
         "colwidth": null,
         "fill": "DDFBFD",
