          },
          "content": [
           {
            "type": "text",
            "marks": [
             {
              "type": "underline",
              "attrs": {
               "style": "single"
              }
             }
            ],
            "text": "TX"
           },
           {
            "type": "text",
            "text": ": conservative (1st-line; most resolve in 6–12 mo): rest, ice, stretching (plantar fascia + calf), NSAIDs/APAP, heel cups/orthotics, night splints, supportive shoes (avoid flat shoes + barefoot walking), activity mod, wt loss"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "▪︎"
           },
           {
            "type": "text",
            "marks": [
             {
              "type": "underline",
              "attrs": {
               "style": "single"
              }
             }
            ],
            "text": "refractory"
           },
           {
            "type": "text",
            "text": ": CS inj (⍉ 1st-line; short-term relief only; risk of fascia rupture/fat pad atrophy, esp young active pts), ESWT; limited evidence: PRP/autologous blood inj, topical steroids"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "▪︎surgery after 6–12 mo failed conservative care: partial plantar fasciotomy ± gastrocnemius recession"
           }
          ]
         }
        ]
       }
