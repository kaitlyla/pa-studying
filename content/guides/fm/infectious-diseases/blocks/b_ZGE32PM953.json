           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "▪︎rabies virus — transmitted through saliva into bite wounds or mucous membranes → virus replicates in muscle cells near the bite site"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "▪︎incubation 30–90 days; bite on head/neck = shorter incubation, extremity = longer"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "▪︎nonmammals do NOT harbor rabies"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "▪︎transmission: dog, cat, ferret, bat, raccoon, fox, skunk, coyote, rodent, livestock"
           }
          ]
         }
        ]
       },
       {
        "type": "table_cell",
        "attrs": {
         "colspan": 1,
         "rowspan": 1,
         "colwidth": null,
         "fill": "FBF9D8",
         "vAlign": "top",
         "borders": null
        },
        "content": [
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "▪︎viral prodrome: HA, fever, rhinorrhea, pharyngitis"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "▪︎encephalitis (agitation + extreme irritability), hallucinations, ataxia, seizure"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "▪︎aerophobia (fear of air in motion), hydrophobia (fear of water → throat spasms, difficult to swallow water), hypersalivation"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "▪︎coma + death"
           }
          ]
         }
        ]
       },
