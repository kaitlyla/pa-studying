           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "▪︎previously vaccinated: RIG not indicated + vaccine 1 mL IM (deltoid) days 0, 3"
           }
          ]
         },
         {
          "type": "paragraph",
