              "content": [
               {
                "type": "text",
                "marks": [
                 {
                  "type": "underline",
                  "attrs": {
                   "style": "single"
                  }
                 }
                ],
                "text": "MOA"
               },
               {
                "type": "text",
                "text": ": binds irreversibly to the 30S ribosomal subunit, inhibiting bact protein synth; bactericidal  "
               }
              ]
             }
            ]
           },
           {
            "type": "table_cell",
            "attrs": {
             "colspan": 1,
             "rowspan": 1,
             "colwidth": null,
             "fill": "D9D9D9",
             "vAlign": "top",
             "borders": null
            },
            "content": [
             {
              "type": "paragraph",
              "attrs": {
               "indLeft": 0,
               "indRight": 0,
               "indFirst": 0,
               "spaceBefore": 0,
               "spaceAfter": 0,
               "line": null,
               "align": "left",
               "shade": null,
               "borders": null,
               "marker": null
              },
              "content": [
               {
                "type": "text",
                "text": "•gram (-) aerobic bacilli only (incl Pseudomonas)"
               }
              ]
             },
             {
              "type": "paragraph",
              "attrs": {
               "indLeft": 0,
               "indRight": 0,
               "indFirst": 0,
               "spaceBefore": 0,
               "spaceAfter": 0,
               "line": null,
               "align": "left",
               "shade": null,
               "borders": null,
               "marker": null
              },
              "content": [
               {
                "type": "text",
                "text": "•there = a synergistic effect when combined w/ a beta-lactam or vanco"
               }
              ]
             },
             {
              "type": "paragraph",
              "attrs": {
               "indLeft": 0,
               "indRight": 0,
               "indFirst": 0,
               "spaceBefore": 0,
               "spaceAfter": 0,
               "line": null,
               "align": "left",
               "shade": null,
               "borders": null,
               "marker": null
              },
              "content": [
               {
                "type": "text",
                "text": "•⍉good for gram (+) or anaerobic coverage "
               }
              ]
             }
            ]
           },
           {
            "type": "table_cell",
            "attrs": {
             "colspan": 1,
             "rowspan": 1,
             "colwidth": null,
             "fill": "D9D9D9",
             "vAlign": "top",
             "borders": null
            },
            "content": [
             {
              "type": "paragraph",
              "attrs": {
               "indLeft": 0,
               "indRight": 0,
               "indFirst": 0,
               "spaceBefore": 0,
               "spaceAfter": 0,
               "line": null,
               "align": "left",
               "shade": null,
               "borders": null,
               "marker": null
              },
              "content": [
               {
                "type": "text",
                "marks": [
                 {
                  "type": "underline",
                  "attrs": {
                   "style": "single"
                  }
                 }
                ],
                "text": "Clin Use"
               },
               {
                "type": "text",
                "text": ": slightly ↑activity against Pseudomonas; topical use for Keratitis  "
               }
              ]
             }
            ]
           },
           {
            "type": "table_cell",
            "attrs": {
             "colspan": 1,
             "rowspan": 1,
             "colwidth": null,
             "fill": "D9D9D9",
