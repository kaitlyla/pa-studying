                 }
                ],
                "text": "SE"
               },
               {
                "type": "text",
                "text": ":"
               }
              ]
             },
             {
              "type": "paragraph",
              "attrs": {
               "indLeft": 0,
               "indRight": 0,
               "indFirst": 0,
               "spaceBefore": 0,
               "spaceAfter": 0,
               "line": null,
               "align": "left",
               "shade": null,
               "borders": null,
               "marker": null
              },
              "content": [
               {
                "type": "text",
                "text": "•nephrotoxicity: ATN "
               }
              ]
             },
             {
              "type": "paragraph",
              "attrs": {
               "indLeft": 0,
               "indRight": 0,
               "indFirst": 0,
               "spaceBefore": 0,
               "spaceAfter": 0,
               "line": null,
               "align": "left",
               "shade": null,
               "borders": null,
               "marker": null
              },
              "content": [
               {
                "type": "text",
                "text": "•ototoxicity (vestibular & cochlear) – cautious use of Gentamicin w/ other ototoxic drugs, such as Cisplatin, Furosemide, Bumetanide, Ethacrynic acid, & ↑dose NSAIDs "
               }
              ]
             },
             {
              "type": "paragraph",
              "attrs": {
               "indLeft": 0,
               "indRight": 0,
               "indFirst": 0,
               "spaceBefore": 0,
               "spaceAfter": 0,
               "line": null,
               "align": "left",
               "shade": null,
               "borders": null,
               "marker": null
              },
              "content": [
               {
                "type": "text",
                "text": "•Neuromusc paralysis – ↑musc weakness in pts w/ Myasthenia gravis "
               }
              ]
             },
             {
              "type": "paragraph",
              "attrs": {
               "indLeft": 0,
               "indRight": 0,
               "indFirst": 0,
               "spaceBefore": 0,
               "spaceAfter": 0,
               "line": null,
               "align": "left",
               "shade": null,
               "borders": null,
               "marker": null
              },
              "content": [
               {
                "type": "text",
                "text": "•↓activity in sites w/ acidic pH"
               }
              ]
             },
             {
              "type": "paragraph",
              "attrs": {
               "indLeft": 0,
               "indRight": 0,
               "indFirst": 0,
               "spaceBefore": 0,
               "spaceAfter": 0,
               "line": null,
               "align": "left",
               "shade": null,
               "borders": null,
               "marker": null
              },
              "content": [
               {
                "type": "text",
                "text": "•topical Neomycin – contact derm "
               }
              ]
             },
             {
              "type": "paragraph",
              "attrs": {
               "indLeft": 0,
               "indRight": 0,
               "indFirst": 0,
               "spaceBefore": 0,
               "spaceAfter": 0,
               "line": null,
               "align": "left",
               "shade": null,
               "borders": null,
               "marker": null
              }
             },
             {
              "type": "paragraph",
              "attrs": {
               "indLeft": 0,
               "indRight": 0,
               "indFirst": 0,
               "spaceBefore": 0,
               "spaceAfter": 0,
               "line": null,
               "align": "left",
               "shade": null,
               "borders": null,
               "marker": null
              },
              "content": [
               {
                "type": "text",
                "marks": [
                 {
                  "type": "underline",
                  "attrs": {
                   "style": "single"
                  }
                 }
                ],
                "text": "Notes"
               },
               {
                "type": "text",
                "text": ":"
               }
              ]
             },
             {
              "type": "paragraph",
              "attrs": {
               "indLeft": 0,
               "indRight": 0,
               "indFirst": 0,
               "spaceBefore": 0,
               "spaceAfter": 0,
               "line": null,
               "align": "left",
               "shade": null,
               "borders": null,
               "marker": null
              },
              "content": [
               {
                "type": "text",
                "text": "•needs to be renally dosed in pts w/ renal impairment "
               }
              ]
             },
             {
              "type": "paragraph",
              "attrs": {
               "indLeft": 0,
               "indRight": 0,
               "indFirst": 0,
               "spaceBefore": 0,
               "spaceAfter": 0,
               "line": null,
               "align": "left",
               "shade": null,
               "borders": null,
               "marker": null
              },
              "content": [
               {
                "type": "text",
                "text": "•monitor serum drug levels – peak levels are typically evaluated 30min after completion of the infusion "
               }
              ]
             },
             {
              "type": "paragraph",
              "attrs": {
               "indLeft": 0,
               "indRight": 0,
