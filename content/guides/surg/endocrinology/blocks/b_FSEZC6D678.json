           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "•less common benign masses include myelolipoma/lipoma, ganglioneuroma, epithelial cyst, & pseudocyst "
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
