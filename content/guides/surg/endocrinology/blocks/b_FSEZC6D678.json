           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "•adrenal tumors can also be detected clinically due to manifestations of tumor hormone production "
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
