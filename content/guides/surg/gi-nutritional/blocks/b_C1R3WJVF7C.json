           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "•"
           },
           {
            "type": "text",
            "marks": [
             {
              "type": "bold"
             }
            ],
            "text": "55% occur in the GI tract"
           },
           {
            "type": "text",
            "text": ", 30% in the lungs "
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "•carcinoid tumors are thought to arise from transformation of enterochromaffin-like cells (ECL cells, which are responsible for histamine secretion) due to chronic stimulation by gastrin; autoimmune atrophic gastritis is associated w/ hypergastinermia"
           }
          ]
         }
        ]
