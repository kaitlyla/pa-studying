           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "•rare, well-differentiated neuroendocrine tumor that arise from enterochromaffin cells "
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
