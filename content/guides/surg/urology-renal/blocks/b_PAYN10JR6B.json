    },
    "content": [
     {
      "type": "text",
      "text": "Abdomen: ascites "
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
