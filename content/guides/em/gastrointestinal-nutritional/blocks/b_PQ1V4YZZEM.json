           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "▪︎incidence 1/100,000 → ~1/1,000,000 (early 1990s) after ASA advisories"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "▪︎inborn errors (medium-chain acyl-CoA dehydrogenase deficiency · urea cycle) mimic/predispose - rare w ASA for Kawasaki - possible NSAID link (juvenile idiopathic arthritis · connective tissue dz)"
           }
          ]
         }
        ]
