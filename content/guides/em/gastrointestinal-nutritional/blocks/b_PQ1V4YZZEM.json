          "content": [
           {
            "type": "text",
            "text": "▪︎encephalopathy + fatty liver - children/adolescents"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
