           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "▪︎EBV → ↑splenic inj/rupture risk"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
