          },
          "content": [
           {
            "type": "text",
            "marks": [
             {
              "type": "bold"
             }
            ],
            "text": "MC seen in pts in late teens/early 20s; male predominance "
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
