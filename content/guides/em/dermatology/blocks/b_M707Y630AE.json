          "content": [
           {
            "type": "text",
            "text": "Results from an abscess, or sinus tract, in the upper part of the natal (gluteal) cleft"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
