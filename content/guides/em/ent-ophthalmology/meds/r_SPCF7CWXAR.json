        "content": [
         {
          "type": "text",
          "text": "-    Gonococcal ophthalmia neonatorum prevention: erythromycin 0.5% ophthalmic ointment shortly after birth"
         }
        ]
       },
       {
        "type": "paragraph",
        "attrs": {
