          },
          "content": [
           {
            "type": "text",
            "text": "▪︎definitive airway = cuffed tube in trachea, secured: orotracheal · nasotracheal · cricothyrotomy"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "▪︎HFNC: up to 100% O2 @ max 60 L/min, heated 37°C - oxygenation only, ⍉definitive"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
