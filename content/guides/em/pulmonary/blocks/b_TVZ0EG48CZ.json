           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "▪︎oropharyngeal airway: adjunct - holds tongue off epiglottis - ⍉definitive"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "▪︎LMA: supraglottic, seals above glottis - intubating LMA can become definitive w endotracheal tube passed through"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": null,
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "▪︎King LT: blind insertion - distal & proximal balloons fill esophagus/hypopharynx"
           }
          ]
         }
        ]
