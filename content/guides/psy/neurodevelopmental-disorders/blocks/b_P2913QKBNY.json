           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "text": "•most stimulants are CI in pts w/ marked anxiety, tension, agitation, glaucoma, hyperthyroidism, or hx of a tic disorder"
           }
          ]
         }
        ]
