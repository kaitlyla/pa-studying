          },
          "content": [
           {
            "type": "text",
            "text": "•psychiatric – psychosis, mood disturbances, severe anxiety or panic attacks "
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
