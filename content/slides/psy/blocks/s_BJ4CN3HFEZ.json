        "font": null,
        "marks": [],
        "tabPt": 12
       }
      },
      "content": [
       {
        "type": "text",
        "text": "Olanzapine: Significant weight gain and sedation (highest metabolic risk other than clozapine; test questions always ask about olanzapine given clozapine’s other side effects)"
       }
      ]
     },
     {
      "type": "paragraph",
      "attrs": {
