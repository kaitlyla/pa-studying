      "content": [
       {
        "type": "text",
        "text": "Risperidone: Gynecomastia (most potent D2 antagonism → elevated prolactin)"
       }
      ]
     },
     {
      "type": "paragraph",
      "attrs": {
       "indLeft": 0,
       "indRight": 0,
       "indFirst": 0,
       "spaceBefore": 0,
