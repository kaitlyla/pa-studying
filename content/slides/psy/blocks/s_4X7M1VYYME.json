    "content": [
     {
      "type": "text",
      "text": "Serotonin Syndrome vs Neuroleptic Malignant Syndrome"
     }
    ]
   },
   {
    "type": "slide_card",
    "content": [
     {
      "type": "paragraph",
      "attrs": {
       "indLeft": 0,
       "indRight": 0,
       "indFirst": 0,
       "spaceBefore": 0,
       "spaceAfter": 0,
       "line": null,
       "align": "left",
       "shade": null,
       "borders": null,
       "marker": null
      },
      "content": [
       {
        "type": "text",
        "text": "Serotonin syndrome"
       }
      ]
     },
     {
      "type": "paragraph",
      "attrs": {
       "indLeft": 0,
       "indRight": 0,
       "indFirst": 0,
       "spaceBefore": 0,
       "spaceAfter": 0,
       "line": null,
       "align": "left",
       "shade": null,
       "borders": null,
       "marker": {
        "text": "•",
        "font": null,
        "marks": [],
        "tabPt": 12
       }
      },
      "content": [
       {
        "type": "text",
        "text": "Hallmark symptoms are clonus and hyperreflexia"
       }
      ]
     },
     {
      "type": "paragraph",
      "attrs": {
       "indLeft": 0,
       "indRight": 0,
       "indFirst": 0,
       "spaceBefore": 0,
       "spaceAfter": 0,
       "line": null,
       "align": "left",
       "shade": null,
       "borders": null,
       "marker": {
        "text": "•",
        "font": null,
        "marks": [],
        "tabPt": 12
       }
      },
      "content": [
       {
        "type": "text",
        "text": "Will also typically have fever (but not higher than 102 degrees), nausea, vomiting, diarrhea, abdominal pain, flushing, sweating, hypertension, tachycardia"
       }
      ]
     },
     {
      "type": "paragraph",
      "attrs": {
       "indLeft": 0,
       "indRight": 0,
       "indFirst": 0,
       "spaceBefore": 0,
       "spaceAfter": 0,
       "line": null,
       "align": "left",
       "shade": null,
       "borders": null,
       "marker": {
        "text": "•",
        "font": null,
        "marks": [],
        "tabPt": 12
       }
      },
      "content": [
       {
        "type": "text",
        "text": "Most common causes: Not waiting long enough for antidepressant to wash out before starting another one (especially fluoxetine to MAOi), starting certain antibiotics (especially linezolid) with SSRIs on board"
       }
      ]
     },
     {
      "type": "paragraph",
      "attrs": {
       "indLeft": 0,
       "indRight": 0,
       "indFirst": 0,
       "spaceBefore": 0,
       "spaceAfter": 0,
       "line": null,
       "align": "left",
       "shade": null,
       "borders": null,
       "marker": {
        "text": "•",
        "font": null,
        "marks": [],
        "tabPt": 12
       }
      },
      "content": [
       {
        "type": "text",
        "text": "Treatment: Remove offending agent, can use cyproheptadine"
       }
      ]
     }
    ]
   },
   {
    "type": "slide_card",
    "content": [
     {
      "type": "paragraph",
      "attrs": {
       "indLeft": 0,
       "indRight": 0,
       "indFirst": 0,
       "spaceBefore": 0,
       "spaceAfter": 0,
       "line": null,
       "align": "left",
       "shade": null,
       "borders": null,
       "marker": null
      },
      "content": [
       {
        "type": "text",
        "text": "Neuroleptic malignant syndrome"
       }
      ]
     },
     {
      "type": "paragraph",
      "attrs": {
       "indLeft": 0,
       "indRight": 0,
       "indFirst": 0,
       "spaceBefore": 0,
       "spaceAfter": 0,
       "line": null,
       "align": "left",
       "shade": null,
       "borders": null,
       "marker": {
        "text": "•",
        "font": null,
        "marks": [],
        "tabPt": 12
       }
      },
      "content": [
       {
        "type": "text",
        "text": "Hallmark symptoms: Lead pipe rigidity, VERY HIGH CPK"
       }
      ]
     },
     {
      "type": "paragraph",
      "attrs": {
       "indLeft": 0,
       "indRight": 0,
       "indFirst": 0,
       "spaceBefore": 0,
       "spaceAfter": 0,
       "line": null,
       "align": "left",
       "shade": null,
       "borders": null,
       "marker": {
        "text": "•",
        "font": null,
        "marks": [],
        "tabPt": 12
       }
      },
      "content": [
       {
        "type": "text",
        "text": "Will also have a very high fever (greater than 102), HYPOreflexia"
       }
      ]
     },
     {
      "type": "paragraph",
      "attrs": {
       "indLeft": 0,
       "indRight": 0,
       "indFirst": 0,
       "spaceBefore": 0,
       "spaceAfter": 0,
       "line": null,
       "align": "left",
       "shade": null,
       "borders": null,
       "marker": {
        "text": "•",
        "font": null,
        "marks": [],
        "tabPt": 12
       }
      },
      "content": [
       {
        "type": "text",
        "text": "Most common causes: Too high of a dose of antipsychotic, or being on a med that inhibits metabolism of antipsychotic"
       }
      ]
     },
     {
      "type": "paragraph",
      "attrs": {
       "indLeft": 0,
       "indRight": 0,
       "indFirst": 0,
       "spaceBefore": 0,
       "spaceAfter": 0,
       "line": null,
       "align": "left",
       "shade": null,
       "borders": null,
       "marker": {
        "text": "•",
        "font": null,
        "marks": [],
        "tabPt": 12
       }
      },
      "content": [
       {
        "type": "text",
        "text": "Treatment: Remove offending agent, treat symptomatically"
       }
      ]
     },
     {
      "type": "paragraph",
      "attrs": {
       "indLeft": 18,
       "indRight": 0,
       "indFirst": 0,
       "spaceBefore": 0,
       "spaceAfter": 0,
       "line": null,
       "align": "left",
       "shade": null,
       "borders": null,
       "marker": {
        "text": "•",
        "font": null,
        "marks": [],
        "tabPt": 12
       }
      },
      "content": [
       {
        "type": "text",
        "text": "Can use dantrolene or bromocriptine in severe cases"
       }
      ]
     }
    ]
   }
  ]
