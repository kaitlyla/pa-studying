       "shade": null,
       "borders": null,
       "marker": null
      },
      "content": [
       {
        "type": "text",
        "text": "Retrocecal appendix → atypical pattern (diarrhea), + rectal or gynecologic examination; appendix may also be pelvic"
       }
      ]
     },
     {
      "type": "paragraph",
      "attrs": {
       "indLeft": 0,
       "indRight": 0,
