       "marker": null
      },
      "content": [
       {
        "type": "text",
        "text": "⊕Speed’s: elbow fully extended, forearm supinated, pain when attempting to forward elevate shoulder against resistance"
       }
      ]
     },
     {
      "type": "paragraph",
      "attrs": {
       "indLeft": 0,
       "indRight": 0,
