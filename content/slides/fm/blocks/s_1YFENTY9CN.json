       "marker": null
      },
      "content": [
       {
        "type": "text",
        "text": "⊕Yergason’s: elbow flexed 90°, pain w/ supination against resistance"
       }
      ]
     },
     {
      "type": "paragraph",
      "attrs": {
       "indLeft": 0,
       "indRight": 0,
       "indFirst": 0,
       "spaceBefore": 0,
