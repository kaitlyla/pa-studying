       "marker": null
      },
      "content": [
       {
        "type": "text",
        "text": "S/SXS: gradual onset anterior shoulder pain worse w/ lifting or overhead reaching, point tenderness at bicipital groove"
       }
      ]
     },
     {
      "type": "paragraph",
      "attrs": {
       "indLeft": 0,
       "indRight": 0,
       "indFirst": 0,
       "spaceBefore": 0,
