       "align": "left",
       "shade": null,
       "borders": null,
       "marker": null
      },
      "content": [
       {
        "type": "text",
        "text": "Pain starts near mouth & shoots to eye, ear, & nostril on the ipsilateral side & often occurs many times throughout the day"
       }
      ]
     },
     {
      "type": "paragraph",
      "attrs": {
       "indLeft": 0,
       "indRight": 0,
