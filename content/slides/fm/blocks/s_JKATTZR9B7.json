       "align": "left",
       "shade": null,
       "borders": null,
       "marker": null
      },
      "content": [
       {
        "type": "text",
        "text": "HA: paroxysmal, brief, episodic, stabbing, lancinating or shock-like pain in the 2nd/3rd division of the trigeminal nerve, lasting sec-mins"
       }
      ]
     },
     {
      "type": "paragraph",
      "attrs": {
       "indLeft": 0,
       "indRight": 0,
       "indFirst": 0,
       "spaceBefore": 0,
       "spaceAfter": 0,
       "line": null,
       "align": "left",
       "shade": null,
       "borders": null,
       "marker": null
      },
      "content": [
       {
        "type": "text",
        "text": "worse w/ touch, chewing, brushing teeth, drafts of wind, & movements (often unilateral)"
       }
      ]
     },
     {
      "type": "paragraph",
      "attrs": {
       "indLeft": 0,
       "indRight": 0,
       "indFirst": 0,
       "spaceBefore": 0,
       "spaceAfter": 0,
