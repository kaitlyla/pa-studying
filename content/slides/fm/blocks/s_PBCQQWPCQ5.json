      },
      "content": [
       {
        "type": "text",
        "text": "Early: high fever, myalgia, HA (w/ photophobia), V/D, abdominal pain"
       }
      ]
     },
     {
      "type": "paragraph",
      "attrs": {
       "indLeft": 0,
       "indRight": 0,
       "indFirst": 0,
       "spaceBefore": 0,
