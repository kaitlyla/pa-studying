      },
      "content": [
       {
        "type": "text",
        "text": "initially blanching, erythematous, macular"
       }
      ]
     },
     {
      "type": "paragraph",
      "attrs": {
       "indLeft": 0,
       "indRight": 0,
       "indFirst": 0,
       "spaceBefore": 0,
