      },
      "content": [
       {
        "type": "text",
        "text": "RASH (2-6d after fever onset): begins on ankles/wrists → trunk (within hours) & palms/soles"
       }
      ]
     },
     {
      "type": "paragraph",
      "attrs": {
       "indLeft": 0,
       "indRight": 0,
