       "align": "left",
       "shade": null,
       "borders": null,
       "marker": null
      },
      "content": [
       {
        "type": "text",
        "text": "Serology: indirect fluorescent or latex agglutination antibody (not ⊕ until 7-10d after onset); PCR from whole blood/skin biopsies (⊕ 1st week of illness)"
       }
      ]
     }
