       "shade": null,
       "borders": null,
       "marker": null
      },
      "content": [
       {
        "type": "text",
        "text": "Lochia"
       }
      ]
     },
     {
      "type": "paragraph",
      "attrs": {
       "indLeft": 0,
       "indRight": 0,
       "indFirst": 0,
       "spaceBefore": 0,
       "spaceAfter": 0,
       "line": null,
       "align": "left",
       "shade": null,
       "borders": null,
       "marker": null
      },
      "content": [
       {
        "type": "text",
        "text": "As the myometrial fibers contract, the blood clots from the uterus are expelled, & the thrombi in the large vessels of the placental bed undergo organization"
       }
      ]
     },
     {
      "type": "paragraph",
      "attrs": {
       "indLeft": 0,
       "indRight": 0,
       "indFirst": 0,
       "spaceBefore": 0,
       "spaceAfter": 0,
       "line": null,
       "align": "left",
       "shade": null,
       "borders": null,
       "marker": null
      },
      "content": [
       {
        "type": "text",
        "text": "Lochia: subsequent discharge – fairly heavy at first & rapidly ↓ in amount over the first 2-3d postpartum (may last for several weeks)"
       }
      ]
     },
     {
      "type": "paragraph",
      "attrs": {
       "indLeft": 0,
       "indRight": 0,
       "indFirst": 0,
       "spaceBefore": 0,
       "spaceAfter": 0,
       "line": null,
       "align": "left",
       "shade": null,
       "borders": null,
       "marker": null
      },
      "content": [
       {
        "type": "text",
        "text": "Lochia Rubra: menses-like bleeding in the first several days, consisting mainly of blood & necrotic decidual tissue"
       }
      ]
     }
    ]
   },
   {
    "type": "slide_card",
    "content": [
     {
      "type": "paragraph",
      "attrs": {
       "indLeft": 0,
       "indRight": 0,
       "indFirst": 0,
