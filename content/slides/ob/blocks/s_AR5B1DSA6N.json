       "shade": null,
       "borders": null,
       "marker": null
      },
      "content": [
       {
        "type": "text",
        "text": "1000g"
       }
      ]
     }
    ]
   },
   {
    "type": "slide_card",
    "content": [
     {
      "type": "paragraph",
      "attrs": {
       "indLeft": 0,
       "indRight": 0,
       "indFirst": 0,
       "spaceBefore": 0,
