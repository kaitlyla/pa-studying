       "marker": null
      },
      "content": [
       {
        "type": "text",
        "text": "Classic presentation: failure to lactate & amenorrhea or oligomenorrhea"
       }
      ]
     },
     {
      "type": "paragraph",
      "attrs": {
       "indLeft": 0,
       "indRight": 0,
       "indFirst": 0,
       "spaceBefore": 0,
       "spaceAfter": 0,
       "line": null,
       "align": "left",
       "shade": null,
       "borders": null,
       "marker": null
      },
      "content": [
       {
        "type": "text",
        "text": "Other possible manifestations: hypotension, hyponatremia, & hypothyroidism"
       }
      ]
     }
    ]
   },
   {
    "type": "slide_card",
    "content": [
     {
      "type": "paragraph",
