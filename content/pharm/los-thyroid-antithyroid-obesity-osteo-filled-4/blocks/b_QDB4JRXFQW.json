     "marker": null
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "• Calculate a bolus or IV drip of insulin"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 23,
     "indRight": 0,
     "indFirst": -13,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": {
      "rule": "auto",
      "value": 1
     },
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "-",
      "font": null,
      "marks": [],
      "tabPt": 13
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "IV insulin bolus = 0.1 units/kg"
     },
     {
      "type": "text",
      "text": " body weight."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 23,
     "indRight": 0,
     "indFirst": -13,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": {
      "rule": "auto",
      "value": 1
     },
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "-",
      "font": null,
      "marks": [],
      "tabPt": 13
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "IV insulin infusion = 0.1 units/kg/hour"
     },
     {
      "type": "text",
      "text": " (≈ 7 units/hour in a 70-kg patient). "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Same dosing for DKA or HHS."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": {
      "rule": "auto",
      "value": 1
     },
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": null
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Example:"
     },
     {
      "type": "text",
      "text": " a "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "70-kg"
     },
     {
      "type": "text",
      "text": " patient → bolus ≈ "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "7 units,"
     },
     {
      "type": "text",
      "text": " then "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "≈ 7 units/hour;"
     },
     {
      "type": "text",
      "text": " an "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "80-kg"
     },
     {
      "type": "text",
      "text": " patient → "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "8-unit"
     },
     {
      "type": "text",
      "text": " bolus, then "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "8 units/hour."
     },
     {
      "type": "text",
      "text": " Expect glucose to fall "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "~50–70 mg/dL per hour"
     },
     {
      "type": "text",
      "text": " on the drip; if it doesn’t, check the IV line, then double/increase the rate."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
