    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Severe DKA or HHS"
     },
     {
      "type": "text",
      "text": " warrants "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "IV insulin therapy"
     },
     {
      "type": "text",
      "text": " — a "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "bolus (0.1 units/kg)"
