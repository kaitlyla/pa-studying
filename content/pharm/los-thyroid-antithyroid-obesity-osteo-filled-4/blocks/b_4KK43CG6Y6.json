    },
    "content": [
     {
      "type": "text",
      "text": "Bicarbonate in DKA is "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "controversial and not well studied."
     },
     {
      "type": "text",
      "text": " Use "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "pH"
     },
     {
      "type": "text",
      "text": " to decide:"
     }
