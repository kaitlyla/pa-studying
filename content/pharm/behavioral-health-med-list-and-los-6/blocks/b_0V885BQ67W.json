      "rule": "auto",
      "value": 1
     },
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": null
    },
    "content": [
     {
      "type": "text",
      "text": "-    MOA: H1-receptor antagonist (1st-gen, cross BBB) -> block CNS his wakefulness -> sedation (+ anticholinergic)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 36,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": {
      "rule": "auto",
      "value": 1
     },
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": null
    },
    "content": [
     {
      "type": "text",
      "text": "-    SE: anticholinergic effects · delirium risk"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 36,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": {
      "rule": "auto",
      "value": 1
     },
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": null
    },
    "content": [
     {
      "type": "text",
      "text": "-    1st-gen: also brompheniramine, chlorpheniramine, clemastine (cross BBB → sedation + antimuscarinic)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 36,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": {
      "rule": "auto",
      "value": 1
     },
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": null
    },
    "content": [
     {
      "type": "text",
      "text": "-    2nd-gen: cetirizine, loratadine, fexofenadine, desloratadine, levocetirizine (⍉cross BBB → less sedation + ⍉antimuscarinic); use: allergic rhinitis, conjunctivitis, urticaria, atopy, eczema, food + drug allergy, hay fever"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": {
      "rule": "auto",
      "value": 1
     },
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": null
    },
    "content": [
     {
      "type": "text",
      "text": "Diphenhydramine (Benadryl):"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 36,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": {
      "rule": "auto",
      "value": 1
     },
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": null
    },
    "content": [
     {
      "type": "text",
      "text": "-    MOA: 1st-gen H1 antagonist (ethanolamine) -> sedation + anticholinergic"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 36,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": {
      "rule": "auto",
      "value": 1
     },
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": null
    },
    "content": [
     {
      "type": "text",
      "text": "-    Clin Use: allergy sx (runny nose, sneezing, itchy/watery eyes, throat itching) · common cold sx · insomnia (OTC sedative; may help initiate sleep; tolerance develops)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": null
    },
    "content": [
     {
      "type": "text",
      "text": "▪︎Pityriasis rosea: PO antihistamines for pruritus"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 36,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": {
      "rule": "auto",
      "value": 1
     },
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": null
    },
    "content": [
     {
      "type": "text",
      "text": "-    Caution: marked drowsiness (↑ w EToH/sedatives/tranquilizers) · ask doctor first: breathing problems, glaucoma, trouble urinating (enlrg prostate) · ⍉ use to make a child sleepy · excitability (children)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 36,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": {
      "rule": "auto",
      "value": 1
     },
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": null
    },
    "content": [
     {
      "type": "text",
      "text": "-    Toxicity: antimuscarinic + H1 block + Na-channel block → anticholinergic syndrome, sedation, seizure/dysrhythmia"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": {
      "rule": "auto",
      "value": 1
     },
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": null
    },
    "content": [
     {
      "type": "text",
      "text": "Promethazine (Phenergan):"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 36,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": {
      "rule": "auto",
      "value": 1
     },
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": null
    },
    "content": [
     {
      "type": "text",
      "text": "-    MOA: phenothiazine H1 antagonist (+ D2 block -> antiemetic) -> sedation + anticholinergic"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 36,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": {
      "rule": "auto",
      "value": 1
     },
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": null
    },
    "content": [
     {
      "type": "text",
      "text": "-    Clin Use: allergic conditions · motion sickness · N/V · sedation (relieves apprehension -> quiet sleep)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 36,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": {
      "rule": "auto",
      "value": 1
     },
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": null
    },
    "content": [
     {
      "type": "text",
      "text": "-    Caution: ↓ sz threshold · CI comatose states, phenothiazine hypersensitivity/idiosyncratic rxn"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 36,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": {
      "rule": "auto",
      "value": 1
     },
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": null
    },
    "content": [
     {
      "type": "text",
      "text": "-    BBW: potentially fatal resp depression · CI <2 y (peds ≥2 y: use w caution)"
     }
    ]
   },
