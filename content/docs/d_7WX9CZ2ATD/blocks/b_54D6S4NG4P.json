    "content": [
     {
      "type": "text",
      "text": "After placing pads in anterolateral placement, you see a jewelry piercing on the patient at the navel. What should you do next?"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 0,
