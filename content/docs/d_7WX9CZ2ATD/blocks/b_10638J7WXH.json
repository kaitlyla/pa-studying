     "marker": null
    },
    "content": [
     {
      "type": "text",
      "text": "List 5 medical conditions that can closely \"mimic\" a Stroke?"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 0,
     "spaceAfter": 0,
