     "align": "left",
     "shade": null,
     "borders": null,
     "marker": null
    },
    "content": [
     {
      "type": "text",
      "text": "Upon arrival to the ED, a Non-Contrast CT of the brain should be completed "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "w/in 20 minutes & interpreted by radiology within 45 min of arrival to ED."
     }
    ]
   },
