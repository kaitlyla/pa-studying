    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "size",
        "attrs": {
         "pt": 8
        }
       }
      ],
      "text": "Neuro gait patterns and localizations: Cerebellar → ataxic, wide-based, staggering (worse tandem walking); Sensory/dorsal column → stomping, high-stepping, +Romberg, worse eyes closed; UMN/CVA → hemiplegic, circumduction; Basal ganglia (Parkinson’s) → shuffling, festinating, ↓arm swing, stooped; periph n./radiculopathy → foot drop, dist weakness"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 36,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": {
      "rule": "auto",
      "value": 1
     },
     "align": "left",
