     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "size",
        "attrs": {
         "pt": 8
        }
       }
      ],
      "text": "Depression (“Pseudodementia”): primary mood disturb; ↓mood, poor effort, “don’t know” answers; cognition intact when engaged. May mimic dementia"
     }
    ]
   },
