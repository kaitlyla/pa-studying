     {
      "type": "text",
      "marks": [
       {
        "type": "size",
        "attrs": {
         "pt": 8
        }
       }
      ],
      "text": "Cluster: severe unilat periorbital pain (15 min–3 hr), w ipsilat autonomic features (tearing, rhinorrhea, ptosis, miosis, conjunctival inj). Occurs in clusters; predominantly males. Mech: hypothalamic activate + trigeminal"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 36,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": {
      "rule": "auto",
      "value": 1
     },
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
