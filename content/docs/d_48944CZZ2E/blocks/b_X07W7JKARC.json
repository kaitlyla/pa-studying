    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "size",
        "attrs": {
         "pt": 8
        }
       }
      ],
      "text": "Delirium: acute, fluctuating, often reversible; inattention + altered consciousness; → = infect, meds, met, hypoxia. R/O organic cause first b4 psych Dx (AMS Dx)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 36,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": {
      "rule": "auto",
      "value": 1
     },
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "-",
      "font": null,
      "marks": [
       {
        "type": "size",
        "attrs": {
         "pt": 8
        }
       }
      ],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "size",
        "attrs": {
         "pt": 8
        }
       }
      ],
      "text": "Dementia: chronic, progress, irreversible neuronal loss; gradual memory/cog decline w preserved alertness; → = Alzheimer’s (MCC), vasc dementia. Parkinson’s: FHx in 1st-degree relatives = major RF"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 36,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": {
      "rule": "auto",
      "value": 1
     },
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "-",
      "font": null,
      "marks": [
       {
        "type": "size",
        "attrs": {
