        }
       }
      ],
      "text": "Cognitive Impairment: Delirium vs Dementia vs Depression (3 D’s)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 36,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": {
      "rule": "auto",
      "value": 1
     },
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
