    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "size",
        "attrs": {
         "pt": 8
        }
       }
      ],
      "text": "2/2 HA: arise from underlying cause (bleed, tumor, infect, raised ICP) — carry red flags (worst HA ever, positional, wakes from sleep, fever/meningismus, focal deficits, papilledema). Norm neuro exam = primary; abnorm = 2/2 → imaging"
     }
    ]
   },
