        }
       }
      ],
      "text": "Headache Types: Primary vs Secondary"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 36,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": {
      "rule": "auto",
      "value": 1
