     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "size",
        "attrs": {
         "pt": 8
        }
       }
      ],
      "text": "Tension-type: bilat, band-like, dull/pressing, mild-mod; ⍉N/V or photo/phonophobia (or mild). Mech: musc tension / central sensitization"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 36,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
