      ],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "size",
        "attrs": {
         "pt": 8
        }
       }
      ],
      "text": "Delirium: acute, fluctuating, often reversible; inattention + altered consciousness; causes = infection, medications, metabolic, hypoxia. R/O organic cause first before psych workup (AMS workup)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 36,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": {
      "rule": "auto",
      "value": 1
     },
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "-",
      "font": null,
      "marks": [
       {
        "type": "size",
        "attrs": {
         "pt": 8
        }
       }
      ],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "size",
        "attrs": {
         "pt": 8
        }
       }
      ],
      "text": "Dementia: chronic, progressive, irreversible neuronal loss; gradual memory/cognitive decline with preserved alertness; causes = Alzheimer’s (MCC), vascular dementia. Parkinson’s: FHx in 1st-degree relatives is major RF"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 36,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": {
      "rule": "auto",
      "value": 1
     },
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "-",
      "font": null,
      "marks": [
       {
        "type": "size",
        "attrs": {
         "pt": 8
        }
       }
      ],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "size",
        "attrs": {
         "pt": 8
        }
       }
      ],
      "text": "Depression (“Pseudodementia”): primary mood disturbance; low mood, poor effort, “don’t know” answers; cognition intact when engaged. May mimic dementia"
     }
    ]
   },
   {
