    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "size",
        "attrs": {
         "pt": 8
        }
       }
      ],
      "text": "Migraine: unilat, pulsatile/throbbing, hours-to-days, photo/phonophobia, N/V, ± aura (visual scotoma, scintillations, sensory sx). Mech: trigeminovascular activate + vasodilate"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 36,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": {
