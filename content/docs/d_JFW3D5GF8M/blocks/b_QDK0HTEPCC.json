      ],
      "text": "Safety (S2/S7):"
     },
     {
      "type": "text",
      "text": " rear‑facing car seat; never front‑seat with air bag; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "back to sleep"
     },
     {
      "type": "text",
