     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "lower the crib mattress"
     },
     {
      "type": "text",
      "text": ", "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "no drop‑side crib"
     },
     {
      "type": "text",
      "text": "; home safety check (stair gates, space‑heater barriers, covered outlets); don't leave baby alone in tub/near water/high places; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "lock poisons/medicines/cleaning supplies"
     },
     {
      "type": "text",
      "text": "; Poison Help 800‑222‑1222; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "do not use a baby walker"
     },
     {
