      ],
      "text": "Oral health (S2/S7):"
     },
     {
      "type": "text",
      "text": " assess fluoride source; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "clean teeth/gums twice a day"
     },
     {
      "type": "text",
      "text": " with a soft brush and a "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "grain‑of‑rice smear of fluoride toothpaste"
     },
     {
      "type": "text",
      "text": "; don't prop the bottle or put baby to bed with one; don't share spoons; don't clean the pacifier in your mouth."
     }
    ]
   },
