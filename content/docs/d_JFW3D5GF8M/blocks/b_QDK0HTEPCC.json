      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Nutrition/feeding (S2/S7):"
     },
     {
      "type": "text",
      "text": " exclusive breastfeeding ~6 months, then breast milk + solids ~6–12 months (ideal)/iron‑fortified formula substitute; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "determine readiness for solids; introduce single‑ingredient foods one at a time; provide iron‑rich foods"
     },
     {
      "type": "text",
      "text": " (iron‑/zinc‑fortified cereal; pureed red meat); respond to hunger/fullness; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "limit juice to 2–4 oz/day"
     },
     {
      "type": "text",
      "text": "; don't switch formula‑fed infants to cow's milk; contact WIC."
     }
    ]
   },
