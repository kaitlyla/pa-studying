      ],
      "text": "CDC milestone framing [CDC‑MIL‑KP]."
     },
     {
      "type": "text",
      "text": " CDC milestones are "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "what ≥75% of children do"
     },
     {
      "type": "text",
      "text": " and are "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "communication tools, not screens or diagnostic standards"
     },
     {
      "type": "text",
      "text": " — \"if developmental concerns are noted, the next steps are screening and evaluation with formal tools or referral.\""
     }
    ]
