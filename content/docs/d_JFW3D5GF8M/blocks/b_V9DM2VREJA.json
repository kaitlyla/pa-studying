    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "TV/digital media (S2):"
     },
     {
      "type": "text",
      "text": " make time for technology‑free play every day; limit screen time (screen time is not recommended for children younger than 2); use distraction/removal/going outside/addressing hunger‑tiredness for calming; no TV during meals."
     }
    ]
   },
