       {
        "type": "bold"
       }
      ],
      "text": "Temperament/development/toilet training/behavior/discipline (S2):"
     },
     {
      "type": "text",
      "text": " anticipate "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "anxiety/clinging in new situations"
     },
     {
      "type": "text",
      "text": " · daily time w the child · plan ahead for difficult situations · consistent discipline/limits · "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "wait until the child = ready for toilet training"
     },
     {
      "type": "text",
      "text": " (dry ~2 hrs · knows wet/dry · can pull pants up/down · can indicate a BM) · read potty books · praise attempts · "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "prepare the toddler for a new sibling"
     }
    ]
   },
