       }
      ],
      "text": "Communication/social (S2):"
     },
     {
      "type": "text",
      "text": " encourage language by reading/singing/talking about what you see; words that describe feelings; simple instructions."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 36,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 1.8,
