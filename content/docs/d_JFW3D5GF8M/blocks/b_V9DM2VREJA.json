      "text": "10.4 Parent education / anticipatory guidance (S2, 18 Month)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 36,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 1.8,
