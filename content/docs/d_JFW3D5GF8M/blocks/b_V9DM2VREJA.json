    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "(Also, S3 parent tips, 18 months):"
     },
     {
      "type": "text",
      "text": " positive attention for wanted behaviors; encourage pretend play; help the child learn about others' feelings; simple choices; steady sleep/eating routines; expect tantrums; face the child at eye level; teach body‑part names; expand the child's words."
     }
    ]
