     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Cervical dysplasia — Pap smear for all young women at the 21‑Year Visit"
     },
     {
      "type": "text",
      "text": "; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Depression screen"
     },
     {
      "type": "text",
      "text": "; "
