     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Dyslipidemia"
     },
     {
      "type": "text",
      "text": " — lipid profile once between 17 and 21 y; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Hearing — audiometry incl. 6,000/8,000 Hz once between 18 and 21 y"
     },
     {
      "type": "text",
      "text": "; "
