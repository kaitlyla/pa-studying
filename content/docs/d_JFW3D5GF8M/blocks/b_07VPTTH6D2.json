     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "HIV"
     },
     {
      "type": "text",
      "text": " — HIV test (once between 15 and 18 y — so due if not done); "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Tobacco/alcohol/drug screen."
     }
