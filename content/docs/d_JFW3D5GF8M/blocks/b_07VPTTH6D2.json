        "type": "bold"
       }
      ],
      "text": "STIs (Chlamydia/Gonorrhea/Syphilis)"
     },
     {
      "type": "text",
      "text": " — all sexually active young women → chlamydia + gonorrhea; sexually active young men + risk → gonorrhea; sexually active + risk → syphilis; "
     },
     {
      "type": "text",
      "marks": [
       {
