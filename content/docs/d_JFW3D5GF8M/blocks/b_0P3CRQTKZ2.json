      ],
      "text": "Newborn behavior/care:"
     },
     {
      "type": "text",
      "text": " sing/talk/read to baby; avoid TV and other digital media; help baby wake for feeding; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "calm by stroking head or gentle rocking"
     },
     {
      "type": "text",
      "text": "; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "never hit or shake baby"
     },
     {
      "type": "text",
      "text": "; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "take temperature rectally"
     },
     {
      "type": "text",
      "text": " (not ear/skin); create an emergency‑preparedness plan; wash hands often; avoid crowds; avoid sun."
     }
    ]
