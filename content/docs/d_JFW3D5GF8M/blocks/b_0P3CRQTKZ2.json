    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Physical exam focus (S2, First Week Visit):"
     },
     {
      "type": "text",
      "text": " "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "italic"
       }
      ],
      "text": "Measure and plot:"
     },
     {
      "type": "text",
      "text": " recumbent length, weight, head circumference, weight‑for‑length. "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "italic"
       }
      ],
      "text": "Assess/observe for:"
     },
     {
      "type": "text",
      "text": " alertness; congenital anomalies; dysmorphic features; rashes; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "jaundice"
     },
     {
      "type": "text",
      "text": "; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "hydration"
     },
     {
      "type": "text",
      "text": "; head shape/size/fontanels and signs of birth trauma; eyes/eyelids, pupil opacification/red reflexes, visual acuity; heart murmurs; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "femoral pulses (compared against upper‑extremity pulses)"
     },
     {
      "type": "text",
      "text": "; umbilical cord/umbilicus; abdominal masses; testes; external female genitalia; spine/back, posture, neurologic tone, activity level, movement symmetry, neonatal reflexes, state regulation. "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "italic"
       }
      ],
      "text": "Perform:"
     },
     {
      "type": "text",
      "text": " "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Ortolani and Barlow maneuvers"
     },
     {
      "type": "text",
      "text": " (hip dysplasia)."
     }
    ]
   },
