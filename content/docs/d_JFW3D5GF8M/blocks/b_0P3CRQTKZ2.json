     "borders": null,
     "marker": null
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "FACT (S1, footnote 4):"
     },
     {
      "type": "text",
      "text": " This is a required visit — newborns should be evaluated "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "within 3 to 5 days of birth and within 48–72 hours after hospital discharge"
     },
     {
      "type": "text",
      "text": "; it must include "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "evaluation for feeding and jaundice"
     },
     {
      "type": "text",
      "text": ". Breastfeeding newborns should receive a "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "formal breastfeeding evaluation"
     },
     {
      "type": "text",
      "text": ", and mothers \"encouragement and instruction.\" Newborns discharged "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "<48 hours after delivery must be examined within 48 hours of discharge"
     },
     {
      "type": "text",
      "text": "."
     }
    ]
   },
