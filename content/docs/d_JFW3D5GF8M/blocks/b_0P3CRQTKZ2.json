      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "head circumference"
     },
     {
      "type": "text",
      "text": "; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "weight‑for‑length"
     },
     {
      "type": "text",
      "text": " (all scheduled at this age)."
     }
