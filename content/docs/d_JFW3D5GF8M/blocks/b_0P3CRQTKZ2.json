     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "eval for feeding and jaundice"
     },
     {
      "type": "text",
      "text": ". breastfeed newborns should receive a "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "formal breastfeed eval"
     },
     {
      "type": "text",
      "text": ", and mothers \"encouragement and instruction.\" Newborns discharged "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "<48 hrs after delivery must be examined w.in 48 hrs of d/c"
     },
     {
      "type": "text",
      "text": "."
     }
    ]
