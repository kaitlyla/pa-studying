     },
     {
      "type": "text",
      "text": " birth weight is typically "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "not regained until 7–14 days"
     },
     {
      "type": "text",
      "text": " (especially breastfed). "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Weight loss of >10% of birth weight requires further evaluation"
     },
     {
      "type": "text",
      "text": " (S6)."
