     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Hearing"
     },
     {
      "type": "text",
      "text": " — confirm the newborn hearing screen was completed and verify results (S1 fn 8/19); "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Newborn Blood"
     },
     {
      "type": "text",
      "text": " — confirm the initial newborn blood‑spot screen was accomplished and verify results (S1 fn 19–20). The "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Recommended Uniform Screening Panel"
     },
     {
      "type": "text",
      "text": " and state law define the panel (S1 fn 19)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 72,
     "indRight": 0,
     "indFirst": -18,
