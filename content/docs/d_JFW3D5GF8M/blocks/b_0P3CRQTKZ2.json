       }
      ],
      "text": "Hydration & output:"
     },
     {
      "type": "text",
      "text": " by "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "day 4–5 a newborn should pass ≥6 clear dilute urines/day"
     },
     {
      "type": "text",
      "text": "; the transition from "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "meconium to human‑milk stool"
     },
     {
      "type": "text",
      "text": " is a key intake indicator; well‑fed breastfed newborns usually pass "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "≥3–4 medium yellow stools/day"
     },
     {
      "type": "text",
      "text": " (or with every feeding) by day 4–5 (S6)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 36,
     "indRight": 0,
