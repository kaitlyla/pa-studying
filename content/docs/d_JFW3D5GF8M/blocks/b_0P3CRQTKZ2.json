     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Critical congenital heart disease (CCHD) pulse‑oximetry screening"
     },
     {
      "type": "text",
      "text": " is performed in the "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "newborn period after 24 hours of age and before hospital discharge"
     },
     {
      "type": "text",
      "text": " (S1 fn 22); at the 3–5 day visit it is verified/followed up, not routinely repeated."
     }
    ]
   },
