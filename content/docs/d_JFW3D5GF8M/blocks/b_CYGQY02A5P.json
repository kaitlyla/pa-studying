       {
        "type": "bold"
       }
      ],
      "text": "mvt/Physical:"
     },
     {
      "type": "text",
      "text": " holds head steady w.o support when you are holding him; holds a toy when you put it in his hand; uses his arm to swing @ toys; brings hands to mouth; pushes up onto elbows/forearms when on tummy. [S3]"
     }
