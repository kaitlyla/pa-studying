    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Infant behavior/development:"
     },
     {
      "type": "text",
      "text": " continue calming strategies; talk/play; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "create a daily routine for feeding/naps/bedtime"
     },
     {
      "type": "text",
      "text": "; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "avoid TV and other digital media"
     },
     {
      "type": "text",
      "text": "; use quiet (reading/singing) and active (\"tummy time\") play; provide safe opportunities to explore."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 36,
     "indRight": 0,
