     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "begin infant iron supplementation"
     },
     {
      "type": "text",
      "text": ", safe pumping/storage; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "formula:"
     },
     {
      "type": "text",
      "text": " safe prep/storage, "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "8–12 feedings/24 h, 30–32 oz total"
     },
     {
      "type": "text",
      "text": ", semi‑upright; consider WIC."
     }
