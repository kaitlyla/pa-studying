    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Oral health:"
     },
     {
      "type": "text",
      "text": " don't share spoons; don't clean the pacifier in your mouth; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "cold teething ring"
     },
     {
      "type": "text",
      "text": " for teething pain; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "don't put baby in the crib with a bottle"
     },
     {
      "type": "text",
      "text": "; never prop the bottle; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "clean teeth/gums twice a day"
     },
     {
      "type": "text",
      "text": " with a soft cloth/brush, tap water, and a "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "small smear of fluoridated toothpaste (no more than a grain of rice)"
     },
     {
      "type": "text",
      "text": "."
     }
    ]
   },
