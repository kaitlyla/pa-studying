     {
      "type": "text",
      "text": " risks incl. "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "environmental lead exposure"
     },
     {
      "type": "text",
      "text": ", work‑related exposures; strengths (family support, child care). Counsel: "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "reduce lead exposure at home"
     },
     {
      "type": "text",
      "text": "; make time for self/partner/other children; quality child care."
     }
    ]
   },
