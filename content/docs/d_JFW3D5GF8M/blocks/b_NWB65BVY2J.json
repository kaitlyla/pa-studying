      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Media:"
     },
     {
      "type": "text",
      "text": " for children "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "older than 2 years, limit TV/digital media to ≤1 hour/day of high‑quality programming"
     },
     {
      "type": "text",
      "text": "; no TV during meals."
     }
    ]
   },
