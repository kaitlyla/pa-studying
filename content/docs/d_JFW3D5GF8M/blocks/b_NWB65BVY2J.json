    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Social determinants/safety‑net [BF4‑EC]:"
     },
     {
      "type": "text",
      "text": " screen for intimate‑partner violence using descriptive terms (hit, kick, shove, choke, threaten); provide the "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "National Domestic Violence Hotline 800‑799‑SAFE"
     },
     {
      "type": "text",
      "text": "; address housing/food security ("
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "WIC, SNAP"
     },
     {
      "type": "text",
      "text": "); advise a smoke‑free home/car (800‑QUIT‑NOW)."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 36,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 1.8,
