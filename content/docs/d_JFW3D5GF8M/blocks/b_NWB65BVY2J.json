     {
      "type": "text",
      "text": "; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "combines 2 words"
     },
     {
      "type": "text",
      "text": "; follows a "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "2‑step command"
     },
     {
      "type": "text",
      "text": "; names ≥5 body parts; speech ~50% intelligible; kicks a ball; jumps with both feet; runs with coordination; climbs a playground ladder; stacks objects; turns book pages; turns knobs/lids; draws lines."
     }
    ]
