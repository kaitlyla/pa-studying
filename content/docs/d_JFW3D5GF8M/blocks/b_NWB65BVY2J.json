      ],
      "text": "Language/reading:"
     },
     {
      "type": "text",
      "text": " no baby talk; expect 2‑word phrases and following 1–2‑step commands; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "read every day"
     },
     {
      "type": "text",
      "text": "; report squinting/holding books very close or needing to look at you to hear you (possible hearing/vision problem)."
     }
