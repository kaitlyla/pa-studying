    "content": [
     {
      "type": "text",
      "text": "Bright Futures "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "priorities for the 2‑Year Visit [BF4‑EC]:"
     },
     {
      "type": "text",
      "text": " social determinants of health; temperament and behavior; assessment of language development; toilet training; safety. Key points:"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 36,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 1.8,
