       }
      ],
      "text": "Measurements:"
     },
     {
      "type": "text",
      "text": " standing height (preferred) or recumbent length; weight; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "BMI if standing height, weight‑for‑length if recumbent"
     },
     {
      "type": "text",
      "text": "; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "head circumference"
     },
     {
      "type": "text",
      "text": " (last routine visit for HC per [PS]). Plot on "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "CDC growth charts"
     },
     {
