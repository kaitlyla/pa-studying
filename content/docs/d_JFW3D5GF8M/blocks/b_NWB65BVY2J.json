      "text": " → Hgb/Hct; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Blood pressure"
     },
     {
      "type": "text",
      "text": " if a specific risk condition or change in risk; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Dyslipidemia"
     },
     {
      "type": "text",
