     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Lead"
     },
     {
      "type": "text",
      "text": " (low‑prevalence, non‑Medicaid) → lead level; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Oral health"
     },
     {
      "type": "text",
      "text": " (no dental home → referral/risk assessment, or deficient water fluoride → oral fluoride supplement); "
