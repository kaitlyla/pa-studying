      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Behavior/temperament:"
     },
     {
      "type": "text",
      "text": " praise good behavior; give choices limited to 2 acceptable options; use brief time‑outs, not hitting/biting; positive reinforcement over punishment."
     }
    ]
   },
