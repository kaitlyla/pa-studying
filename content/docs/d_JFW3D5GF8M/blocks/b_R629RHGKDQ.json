      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Infant behavior/development:"
     },
     {
      "type": "text",
      "text": " consistent daily routines; safe exploration; recognize "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "new social skills and separation anxiety"
     },
     {
      "type": "text",
      "text": "; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "cause‑and‑effect toys"
     },
     {
      "type": "text",
      "text": ", talk/sing/read, respond to cues; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "avoid TV/videos/computers"
     },
     {
      "type": "text",
      "text": " (consider a family media‑use plan); "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "consistent positive discipline"
     },
     {
      "type": "text",
      "text": " (limit the word \"no,\" use distraction, be a role model)."
     }
    ]
   },
