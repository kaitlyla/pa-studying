     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "table foods"
     },
     {
      "type": "text",
      "text": ", varied textures; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "3 meals and 2–3 snacks/day"
     },
     {
      "type": "text",
      "text": "; encourage cup use; discuss weaning; continue breastfeeding if mutually desired."
     }
