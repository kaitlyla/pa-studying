      "text": " rear‑facing car seat "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "until at least 2 years old"
     },
     {
      "type": "text",
      "text": "; never front‑seat with air bag; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "heatstroke prevention — never leave baby in the car alone"
     },
     {
      "type": "text",
      "text": "; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "firearm safety — remove firearms from the home"
     },
     {
      "type": "text",
      "text": " (if kept: unloaded, locked, ammunition locked separately); home safety check (stair gates, space‑heater barriers, cords); Poison Help 800‑222‑1222; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "\"touch supervision\" near water/pools/bathtubs"
