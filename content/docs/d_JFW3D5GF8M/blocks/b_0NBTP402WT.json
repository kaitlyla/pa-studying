      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Developmental surveillance [BF4‑AD]:"
     },
     {
      "type": "text",
      "text": " by the end of this period the clinician should have discussed "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "tobacco, alcohol and illicit‑drug experimentation, healthy sexual development, abstinence, and safe driving"
     },
     {
      "type": "text",
      "text": "; support "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "LGBTQ youth"
     },
     {
      "type": "text",
      "text": "; consider "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "developing decisional capacity and a transition plan to adult care."
     }
    ]
   },
