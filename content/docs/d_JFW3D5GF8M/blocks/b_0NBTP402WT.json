    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "History/exam/measurements:"
     },
     {
      "type": "text",
      "text": " same framework as early adolescence — interval history + ROS (HEEADSSS/SSHADESS); height, weight, BMI, BP; skin (acne, acanthosis nigricans, atypical nevi, piercings, abuse/self‑injury), "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "spine (scoliosis and kyphosis from 15 y)"
     },
     {
      "type": "text",
      "text": ", breast (female SMR; male gynecomastia), genitalia (SMR; testicular exam for hydrocele/hernia/varicocele/mass); "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "chaperone advised."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 36,
     "indRight": 0,
     "indFirst": -18,
