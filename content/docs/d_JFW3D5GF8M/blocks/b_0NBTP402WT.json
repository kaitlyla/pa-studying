    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Universal:"
     },
     {
      "type": "text",
      "text": " "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Depression screen"
     },
     {
      "type": "text",
      "text": " (every visit); "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Dyslipidemia"
     },
     {
      "type": "text",
      "text": " — lipid profile "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "once between the 17‑Year and 21‑Year Visits"
     },
     {
      "type": "text",
      "text": " (so due at 17 y); "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Hearing — audiometry incl. 6,000/8,000 Hz (once between 15 and 17 y)"
     },
     {
      "type": "text",
      "text": "; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "HIV — HIV test (once between 15 and 18 y), preserving confidentiality"
     },
     {
      "type": "text",
      "text": "; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Tobacco/alcohol/drug use screen"
     },
     {
      "type": "text",
      "text": "; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Vision — objective acuity at the 15‑Year Visit."
     }
    ]
   },
   {
