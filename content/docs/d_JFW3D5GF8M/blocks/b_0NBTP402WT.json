       }
      ],
      "text": "Screenings due [BF4‑AD, 15–17 table]:"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 72,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 1.8,
