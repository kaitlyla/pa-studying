      ],
      "text": "Selective (◇):"
     },
     {
      "type": "text",
      "text": " anemia → Hgb/Hct; dyslipidemia (if not universally screened this visit); HIV (if not universally screened this visit); oral health (through the 16‑Year Visit) → fluoride supplement if water deficient; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "STIs (Chlamydia/Gonorrhea/Syphilis)"
     },
     {
      "type": "text",
      "text": " — sexually active girls → chlamydia + gonorrhea; sexually active boys + risk → gonorrhea; sexually active + risk → syphilis; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "tuberculosis"
     },
     {
      "type": "text",
      "text": " → TST; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "vision (16 and 17 y)"
     },
     {
      "type": "text",
      "text": " → acuity if positive risk."
     }
