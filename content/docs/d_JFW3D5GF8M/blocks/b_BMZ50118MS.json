      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "Safety:"
     },
     {
      "type": "text",
      "text": " seat belt and helmet use; sun protection; substance use and riding in a vehicle; firearm safety."
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
