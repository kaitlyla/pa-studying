     {
      "type": "text",
      "text": " "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "positive discipline, time‑outs, distraction; praise good behaviors"
     },
     {
      "type": "text",
      "text": "; daily family time; consistent routines; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "1 nap/day"
     },
     {
      "type": "text",
      "text": "; nightly bedtime routine; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "avoid TV and other digital media"
     },
     {
      "type": "text",
      "text": ", make a family media plan."
     }
