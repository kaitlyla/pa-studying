       }
      ],
      "text": "Safety (S2/S7):"
     },
     {
      "type": "text",
      "text": " "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "keep the car seat rear‑facing to the highest weight/height allowed (in most cases well past the 2nd birthday)"
     },
     {
      "type": "text",
      "text": "; never front‑seat with air bag; gates at stairs; operable window guards on 2nd‑story+ windows; keep furniture away from windows; secure TVs/furniture; "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "bold"
       }
      ],
      "text": "within arm's reach near water"
     },
