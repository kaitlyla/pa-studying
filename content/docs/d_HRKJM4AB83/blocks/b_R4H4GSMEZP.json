    "content": [
     {
      "type": "text",
      "marks": [
       {
        "type": "underline",
        "attrs": {
         "style": "single"
        }
       }
      ],
      "text": "6-8 weeks "
     },
     {
      "type": "text",
      "text": "at a therapeutic dose is considered "
     },
     {
      "type": "text",
      "marks": [
       {
        "type": "underline",
        "attrs": {
         "style": "single"
        }
       }
      ],
      "text": "a reasonable trial"
     },
     {
      "type": "text",
      "text": "; if at least moderate symptom improvement is not obtained at this point, consider the following:"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 72,
