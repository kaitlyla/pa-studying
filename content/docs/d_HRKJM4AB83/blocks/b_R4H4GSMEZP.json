      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "augmentation with buspirone or atypical antipsychotics "
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 72,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
