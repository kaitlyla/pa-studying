      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "change to AD in the same class, or combination therapy with AD in a different class"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 72,
     "indRight": 0,
     "indFirst": -18,
