      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "Goal = remission of depressive episodes, return to baseline level functioning"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 36,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
     "spaceAfter": 0,
     "line": null,
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": {
      "text": "•",
      "font": null,
      "marks": [],
      "tabPt": 18
     }
    },
    "content": [
     {
      "type": "text",
      "text": "General symptom improvement should begin around 1-2 weeks (e.g., energy, appetite, functioning)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 36,
     "indRight": 0,
     "indFirst": -18,
     "spaceBefore": 0,
