     "align": "left",
     "shade": null,
     "borders": null,
     "marker": null
    },
    "content": [
     {
      "type": "text",
      "text": "-    Acute/viral rhinosinusitis supportive care (with NSAIDs, nasal saline sprays, mucolytics, decongestants)"
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 36,
     "indRight": 0,
     "indFirst": -18,
