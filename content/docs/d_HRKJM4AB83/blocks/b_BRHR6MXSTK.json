      "value": 1
     },
     "align": "left",
     "shade": null,
     "borders": null,
     "marker": null
    },
    "content": [
     {
      "type": "text",
      "text": "-    Monitoring (isotretinoin): LFTs + lipids only (⍉ ⇡neuropsych or IBD risk found)"
     }
    ]
   }
  ]
