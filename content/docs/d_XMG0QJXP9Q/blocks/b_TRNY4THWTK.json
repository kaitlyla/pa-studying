              }
             }
            ],
            "text": "2025 Update: Resuscitative Hysterotomy (Perimortem Cesarean Delivery)"
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": {
            "rule": "auto",
            "value": 1
           },
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "marks": [
             {
              "type": "color",
              "attrs": {
               "hex": "2C3E50"
              }
             }
            ],
            "text": "New 2025 recommendation: Initiate resuscitative hysterotomy IMMEDIATELY upon recognition of cardiac arrest in a pregnant pt w the uterus at or above the umbilicus."
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": {
            "rule": "auto",
            "value": 1
           },
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "marks": [
             {
              "type": "color",
              "attrs": {
               "hex": "2C3E50"
              }
             }
            ],
            "text": "Goal: delivery w/in 5 min of cardiac arrest onset - do not wait 4 min before beginning preparation."
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": {
            "rule": "auto",
            "value": 1
           },
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "marks": [
             {
              "type": "color",
              "attrs": {
               "hex": "2C3E50"
              }
             }
            ],
            "text": "Rationale: relieves aortocaval compression & improves maternal cardiac output; poss also rescue the fetus."
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": {
            "rule": "auto",
            "value": 1
           },
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "marks": [
             {
              "type": "color",
              "attrs": {
               "hex": "2C3E50"
              }
             }
            ],
            "text": "Procedure does NOT need to be performed in an OR - bedside at the site of arrest."
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": {
            "rule": "auto",
            "value": 1
           },
           "align": "left",
           "shade": null,
           "borders": null,
           "marker": null
          },
          "content": [
           {
            "type": "text",
            "marks": [
             {
              "type": "color",
              "attrs": {
               "hex": "2C3E50"
              }
             }
            ],
            "text": "Continue CPR throughout & after hysterotomy."
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
           "spaceAfter": 0,
           "line": {
