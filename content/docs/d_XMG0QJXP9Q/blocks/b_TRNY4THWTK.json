              "attrs": {
               "hex": "2C3E50"
              }
             }
            ],
            "text": "Consider ECPR (extracorporeal CPR) if strd resuscitation fails."
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
