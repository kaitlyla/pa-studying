              "attrs": {
               "hex": "2C3E50"
              }
             }
            ],
            "text": "AVOID nitroglycerin & diuretics - RV is preload dependent; these agents -> severe hypotension."
           }
          ]
         },
         {
          "type": "paragraph",
          "attrs": {
           "indLeft": 0,
           "indRight": 0,
           "indFirst": 0,
           "spaceBefore": 0,
