    "content": [
     {
      "type": "text",
      "text": "For drowning victims, airway & ventilation are prioritized b/c hypoxia = the primary mech of arrest. "
     }
    ]
   },
   {
    "type": "paragraph",
    "attrs": {
     "indLeft": 0,
     "indRight": 0,
     "indFirst": 0,
     "spaceBefore": 0,
