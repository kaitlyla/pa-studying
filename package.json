{
  "name": "pa-studying",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build:data && vite build && node tools/build/finish.ts",
    "build:data": "node tools/build/index.ts",
    "import": "node tools/import/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test -c app/e2e/playwright.config.ts",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit -p tsconfig.json",
    "lint": "eslint --no-error-on-unmatched-pattern app lib tools worker/src vite.config.ts eslint.config.js"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "minisearch": "7.2.0",
    "pdfjs-dist": "6.5.438",
    "pdfmake": "0.3.14",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.13",
    "prosemirror-state": "1.4.4",
    "prosemirror-tables": "1.8.5",
    "prosemirror-transform": "1.12.5",
    "prosemirror-view": "1.42.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "@xmldom/xmldom": "0.9.12",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fontkit": "3.0.0",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "parse5": "8.1.1",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.2",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.4"
  }
}
